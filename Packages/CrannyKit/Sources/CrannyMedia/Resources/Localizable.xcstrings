    "Static shows that something is playing without any movement." : {
      "comment" : "Settings ▸ Media ▸ Visualizer: footnote for Static",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُظهر الوضع الثابت أن شيئًا ما قيد التشغيل دون أي حركة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Estàtic” mostra que s’està reproduint alguna cosa, sense cap moviment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statický vizualizér ukazuje, že něco hraje, ale nepohybuje se."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statisk viser, at der afspilles noget, uden bevægelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Statisch“ zeigt ohne Bewegung, dass etwas läuft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η «Στατική» δείχνει ότι κάτι παίζει, χωρίς καμία κίνηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Estático” indica que algo se está reproduciendo, sin ningún movimiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staattinen näyttää ilman liikettä, että jotain toistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Statique » indique qu’une lecture est en cours, sans aucun mouvement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״סטטי״ מראה שמשהו מתנגן, ללא תנועה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थिर बिना किसी हलचल के दिखाता है कि कुछ चल रहा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statično pokazuje da se nešto reproducira, bez ikakvog pokreta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Statikus” mód mozgás nélkül jelzi, hogy szól valami."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statis menunjukkan ada yang sedang diputar tanpa gerakan apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Statico” indica che c’è qualcosa in riproduzione, senza alcun movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静止は、動きのない表示で再生中であることを示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘정적’은 움직임 없이 무언가 재생 중임을 보여줍니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statik menunjukkan bahawa sesuatu sedang dimainkan tanpa sebarang pergerakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statisk viser at noe spilles, uten bevegelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statisch toont dat er iets speelt, zonder beweging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb „Statyczny” pokazuje, że coś jest odtwarzane, bez żadnego ruchu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estático mostra que algo está tocando, sem nenhum movimento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Estático” mostra que algo está a ser reproduzido, sem qualquer movimento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Static” arată că se redă ceva, fără nicio mișcare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Статичный показывает, что что-то играет, без движения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statické zobrazenie ukazuje, že sa niečo prehráva, bez akéhokoľvek pohybu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Način Statični pokaže, da se nekaj predvaja, brez kakršnega koli gibanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statisk visar att något spelas, helt utan rörelse."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“นิ่ง” แสดงว่ามีบางอย่างกำลังเล่นอยู่โดยไม่มีการเคลื่อนไหว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabit, bir şeyin çaldığını hiç hareket etmeden gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Статичний показує, що щось грає, без жодного руху."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ Tĩnh cho biết đang có nội dung phát mà không có chuyển động nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“静态”仅表示正在播放，不显示任何动画。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「靜態」只會標示有內容正在播放，不帶任何動畫。"
          }
        }
      }
