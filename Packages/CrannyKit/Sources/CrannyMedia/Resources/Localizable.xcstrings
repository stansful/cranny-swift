    "Let the Live visualizer move with the sound. Cranny never records or saves audio." : {
      "comment" : "Permissions pane: why Media may ask for System Audio Recording",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحريك المؤثر المرئي المباشر مع الصوت. لا يسجّل Cranny الصوت ولا يحفظه أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet que el visualitzador “En directe” es mogui amb el so. El Cranny no grava ni desa mai l’àudio."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožnit živému vizualizéru pohybovat se v rytmu zvuku. Cranny zvuk nikdy nenahrává ani neukládá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad visualiseringen i realtid bevæge sig med lyden. Cranny optager eller gemmer aldrig lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Live-Visualizer passend zum Ton bewegen lassen. Cranny nimmt Audio nie auf und speichert es nie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να κινείται η ζωντανή οπτικοποίηση με τον ήχο. Το Cranny δεν εγγράφει ούτε αποθηκεύει ποτέ ήχο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que el visualizador “En vivo” se mueva con el sonido. Cranny nunca graba ni guarda audio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reaaliaikainen visualisoija liikkuu äänen tahdissa. Cranny ei koskaan äänitä eikä tallenna ääntä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permettre au visualiseur « En direct » de suivre le son. Cranny n’enregistre ni ne conserve jamais l’audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי שהוויזואלייזר ״חי״ ינוע בקצב השמע. Cranny לעולם אינו מקליט או שומר שמע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइव विज़ुअलाइज़र को ध्वनि के साथ थिरकने दें। Cranny कभी ऑडियो रिकॉर्ड या सेव नहीं करता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vizualizator Uživo pomiče se u ritmu zvuka. Cranny nikad ne snima niti sprema zvuk."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Élő vizualizáló mozgatása a hang ütemére. A Cranny soha nem rögzít és nem ment hangot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agar visualisasi Langsung bergerak mengikuti bunyi. Cranny tidak pernah merekam atau menyimpan audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa muovere il visualizzatore “Dal vivo” con il suono. Cranny non registra né salva mai l’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブビジュアライザをサウンドに合わせて動かします。Crannyがオーディオを録音または保存することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘라이브’ 비주얼라이저가 소리에 맞춰 움직이게 합니다. Cranny는 오디오를 녹음하거나 저장하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membolehkan pentampak Langsung bergerak mengikut bunyi. Cranny tidak sekali-kali merakam atau menyimpan audio."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lar Direkte-visualiseringen bevege seg i takt med lyden. Cranny tar aldri opp eller lagrer lyd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat de Live-visualisatie meebewegen met het geluid. Cranny neemt nooit audio op en bewaart die ook niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animowanie wizualizatora „Na żywo” w rytm dźwięku. Cranny nigdy nie nagrywa ani nie zachowuje dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que o visualizador Ao vivo acompanhe o som. O Cranny nunca grava nem salva áudio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que o visualizador “Ao vivo” se mova com o som. O Cranny nunca grava nem guarda áudio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru ca vizualizatorul „În direct” să se miște în ritmul sunetului. Cranny nu înregistrează și nu salvează niciodată sunetul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы живой визуализатор двигался в такт звуку. Cranny никогда не записывает и не сохраняет звук."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živý vizualizér sa bude hýbať podľa zvuku. Cranny nikdy nenahráva ani neukladá zvuk."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da se vizualizator V živo premika v ritmu zvoka. Cranny zvoka nikoli ne snema ali shranjuje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt visualiseraren Realtid röra sig i takt med ljudet. Cranny varken spelar in eller sparar ljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้ตัวแสดงภาพเสียงแบบสดเคลื่อนไหวตามเสียง Cranny จะไม่บันทึกหรือจัดเก็บเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı görselleştiricinin sesle birlikte hareket etmesi için. Cranny hiçbir zaman ses kaydı almaz veya sesi saklamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб живий візуалізатор рухався в такт звуку. Cranny ніколи не записує й не зберігає звук."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để hiệu ứng sóng nhạc Trực tiếp chuyển động theo âm thanh. Cranny không bao giờ ghi hoặc lưu âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让“实时”可视化效果随声音律动。Cranny绝不会录制或存储音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓「即時」視覺效果隨聲音律動。Cranny絕不會錄製或儲存音訊。"
          }
        }
      }
    },
