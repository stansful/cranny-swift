    "Live listens to the sound your Mac plays and never records or saves it." : {
      "comment" : "Settings ▸ Media ▸ Visualizer: footnote for Live",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستمع الوضع المباشر إلى الصوت الذي يشغّله الـ Mac، ولا يسجّله ولا يحفظه أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“En directe” escolta el so que reprodueix el Mac i no el grava ni el desa mai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živý vizualizér poslouchá zvuk, který Mac přehrává, a nikdy ho nenahrává ani neukládá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtid lytter til den lyd, din Mac afspiller, og optager eller gemmer den aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Live“ hört den Ton, den dein Mac abspielt, nimmt ihn aber nie auf und speichert ihn nie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η «Ζωντανή» ακούει τον ήχο που αναπαράγει το Mac σας και δεν τον εγγράφει ούτε τον αποθηκεύει ποτέ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“En vivo” escucha el sonido que reproduce el Mac y nunca lo graba ni lo guarda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reaaliaika kuuntelee Macin toistamaa ääntä eikä koskaan äänitä tai tallenna sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« En direct » écoute le son émis par votre Mac, sans jamais l’enregistrer ni le conserver."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״חי״ מאזין לשמע שה-Mac מנגן, ולעולם אינו מקליט או שומר אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइव आपके Mac पर बज रही ध्वनि सुनता है और उसे कभी रिकॉर्ड या सेव नहीं करता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uživo sluša zvuk koji Mac reproducira i nikad ga ne snima niti sprema."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az „Élő” mód a Mac által lejátszott hangot figyeli, és soha nem rögzíti vagy menti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsung mendengarkan bunyi yang diputar Mac Anda dan tidak pernah merekam atau menyimpannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Dal vivo” ascolta il suono riprodotto dal Mac e non lo registra né lo salva mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブは、Macで再生されるサウンドを聞き取ります。サウンドを録音または保存することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘라이브’는 Mac에서 재생되는 소리를 듣기만 하며, 녹음하거나 저장하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsung mendengar bunyi yang dimainkan oleh Mac anda dan tidak sekali-kali merakam atau menyimpannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkte lytter til lyden Macen spiller av, og tar den aldri opp eller lagrer den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live luistert naar het geluid dat je Mac afspeelt, zonder het ooit op te nemen of te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb „Na żywo” słucha dźwięku odtwarzanego przez Maca i nigdy go nie nagrywa ani nie zachowuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao vivo escuta o som que o seu Mac reproduz e nunca o grava nem o salva."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ao vivo” ouve o som que o Mac reproduz e nunca o grava nem guarda."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„În direct” ascultă sunetul redat de Mac și nu îl înregistrează și nu îl salvează niciodată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Живой слушает звук, который играет Mac, и никогда его не записывает и не сохраняет."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živé zobrazenie počúva zvuk prehrávaný na Macu a nikdy ho nenahráva ani neukladá."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Način V živo posluša zvok, ki ga predvaja vaš Mac, in ga nikoli ne snema ali shranjuje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realtid lyssnar på ljudet som din Mac spelar upp och varken spelar in eller sparar det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“สด” จะฟังเสียงที่ Mac ของคุณเล่น และจะไม่บันทึกหรือจัดเก็บเสียงนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı, Mac’inizin çaldığı sesi dinler; hiçbir zaman kaydını almaz veya saklamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Живий слухає звук, який відтворює ваш Mac, і ніколи його не записує й не зберігає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ Trực tiếp nghe âm thanh mà máy Mac đang phát và không bao giờ ghi hoặc lưu lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“实时”会监听Mac播放的声音，绝不会录制或存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「即時」會聆聽Mac播放的聲音，但絕不會錄製或儲存。"
          }
        }
      }
    },
