    "Cranny can’t read what’s playing right now." : {
      "comment" : "Media: error line when no media source works (widget and Settings ▸ Media)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Cranny قراءة ما يتم تشغيله في الوقت الحالي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ara mateix el Cranny no pot llegir què s’està reproduint."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny teď nedokáže zjistit, co hraje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny kan ikke se, hvad der afspilles lige nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny kann gerade nicht erkennen, was läuft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Cranny δεν μπορεί να διαβάσει τι παίζει αυτήν τη στιγμή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny no puede saber qué se está reproduciendo ahora."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny ei pysty juuri nyt lukemaan, mitä toistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny ne parvient pas à savoir ce qui est en cours de lecture."
