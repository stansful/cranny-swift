    "Ambient is a calm pattern made from the track, not from the sound. No permission needed." : {
      "comment" : "Settings ▸ Media ▸ Visualizer: footnote for Ambient",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوضع المحيطي نمط هادئ مأخوذ من المسار، لا من الصوت. لا يحتاج إلى أي إذن."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ambiental” és un patró tranquil creat a partir de la pista, no del so. No cal cap permís."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambientní vizualizér je klidný vzor odvozený ze skladby, ne ze zvuku. Nepotřebuje žádné oprávnění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemning er et roligt mønster ud fra sporet, ikke ud fra lyden. Kræver ingen tilladelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Sanft“ ist ein ruhiges Muster, das aus dem Titel entsteht, nicht aus dem Ton. Keine Berechtigung nötig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η «Ατμοσφαιρική» είναι ένα ήρεμο μοτίβο που προκύπτει από το κομμάτι, όχι από τον ήχο. Δεν χρειάζεται άδεια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ambiente” es un patrón tranquilo creado a partir de la pista, no del sonido. No necesita permisos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnelma on rauhallinen kuvio, joka muodostetaan kappaleesta eikä äänestä. Lupaa ei tarvita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Ambiance » est un motif calme tiré du morceau, pas du son. Aucune autorisation n’est nécessaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״רגוע״ מציג תנועה שקטה שנגזרת מהשיר עצמו ולא מהשמע. לא נדרשת הרשאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐम्बिएंट ट्रैक से बना एक शांत पैटर्न है, ध्वनि से नहीं। किसी अनुमति की ज़रूरत नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambijentalno je miran uzorak stvoren prema pjesmi, a ne prema zvuku. Dozvola nije potrebna."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Háttér” mód nyugodt mintát mutat, amely a számból készül, nem a hangból. Nem kell hozzá engedély."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambien adalah pola tenang yang dibuat dari lagu, bukan dari bunyinya. Tidak perlu izin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ambientale” è un motivo tranquillo creato dal brano, non dal suono. Non serve alcuna autorizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アンビエントは、サウンドではなくトラックの情報から作られる穏やかなパターンです。許可は必要ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘앰비언트’는 소리가 아니라 트랙 정보로 만든 잔잔한 패턴입니다. 권한이 필요하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambien ialah corak tenang yang dihasilkan daripada trek, bukan daripada bunyi. Tiada keizinan diperlukan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemning er et rolig mønster laget ut fra sporet, ikke fra lyden. Krever ingen tillatelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfeer is een rustig patroon op basis van het nummer, niet van het geluid. Geen toestemming nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb „Łagodny” to spokojny wzór oparty na utworze, a nie na dźwięku. Nie wymaga uprawnień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambiente é um padrão calmo criado a partir da faixa, não do som. Não precisa de permissão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ambiente” é um padrão calmo criado a partir da faixa, não do som. Não precisa de permissão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ambiental” este un model liniștit creat din piesă, nu din sunet. Nu necesită nicio permisiune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фоновый — спокойный узор по треку, а не по звуку. Разрешение не нужно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambientné zobrazenie je pokojný vzor odvodený zo skladby, nie zo zvuku. Nevyžaduje žiadne povolenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Način Ambientni je umirjen vzorec, ustvarjen iz posnetka, ne iz zvoka. Dovoljenje ni potrebno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stämning är ett lugnt mönster som skapas utifrån spåret, inte ljudet. Ingen behörighet behövs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“บรรยากาศ” คือลวดลายนุ่มนวลที่สร้างจากข้อมูลเพลง ไม่ใช่จากเสียงจริง จึงไม่ต้องขอสิทธิ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortam, sesten değil parçadan üretilen sakin bir desendir. İzin gerekmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фоновий — спокійний візерунок за треком, а не за звуком. Дозвіл не потрібен."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ Dịu nhẹ tạo họa tiết êm dựa trên bài hát, không dựa trên âm thanh. Không cần cấp quyền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“氛围”是根据曲目而非声音生成的平缓图案，无需任何权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「氛圍」是根據曲目（而非聲音）產生的平靜圖樣，不需要任何權限。"
          }
        }
      }
    },
