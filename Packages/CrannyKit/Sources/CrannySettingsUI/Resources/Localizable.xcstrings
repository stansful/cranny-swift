          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El color del álbum mientras suena música; si no, el color de contraste del sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albumin väri musiikin soidessa, muuten järjestelmän korostusväri."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
