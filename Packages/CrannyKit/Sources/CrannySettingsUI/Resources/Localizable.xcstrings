    "When hidden, open Cranny again from Finder or Spotlight to reach Settings." : {
      "comment" : "Settings ▸ General: footnote of Show menu bar icon",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند إخفائها، افتح Cranny مرة أخرى من فايندر أو الباحث للوصول إلى الإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si està oculta, torna a obrir el Cranny des del Finder o l’Spotlight per accedir a la configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je ikona skrytá, otevřete Cranny znovu z Finderu nebo Spotlightu a dostanete se do nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når symbolet er skjult, kan du åbne Cranny igen fra Finder eller Spotlight for at komme til Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist das Symbol ausgeblendet, öffne Cranny erneut über den Finder oder Spotlight, um zu den Einstellungen zu gelangen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι κρυφό, ανοίξτε ξανά το Cranny από το Finder ή το Spotlight για να φτάσετε στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está oculto, vuelve a abrir Cranny desde el Finder o Spotlight para acceder a Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kuvake on kätketty, pääset asetuksiin avaamalla Crannyn uudelleen Finderista tai Spotlightista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’icône est masquée, rouvrez Cranny depuis le Finder ou Spotlight pour accéder aux réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהסמל מוסתר, כדי להגיע להגדרות יש לפתוח שוב את Cranny מ-Finder או מ-Spotlight."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आइकन छिपा होने पर सेटिंग तक पहुँचने के लिए Finder या Spotlight से Cranny को दोबारा खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je ikona skrivena, ponovno otvorite Cranny iz Findera ili Spotlighta da biste došli do postavki."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha az ikon rejtett, a beállítások eléréséhez nyissa meg újra a Crannyt a Finderből vagy a Spotlightból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika disembunyikan, buka lagi Cranny dari Finder atau Spotlight untuk mengakses Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l’icona è nascosta, apri di nuovo Cranny dal Finder o da Spotlight per accedere alle impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示にした場合、設定を開くにはFinderまたはSpotlightからCrannyをもう一度開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이콘을 가린 경우 설정에 접근하려면 Finder나 Spotlight에서 Cranny를 다시 여십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila ikon disembunyikan, buka Cranny semula dari Finder atau Spotlight untuk mencapai Seting."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når symbolet er skjult, åpner du Cranny igjen fra Finder eller Spotlight for å komme til Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het symbool verborgen is, open je Cranny opnieuw via de Finder of Spotlight om bij de instellingen te komen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ikona jest ukryta, otwórz Cranny ponownie z Findera lub Spotlight, aby przejść do ustawień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o ícone oculto, abra o Cranny de novo pelo Finder ou pelo Spotlight para acessar os Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o ícone estiver oculto, abra novamente o Cranny a partir do Finder ou do Spotlight para aceder às definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este ascunsă, deschideți din nou Cranny din Finder sau Spotlight pentru a accesa configurările."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если значок скрыт, откройте Cranny снова из Finder или Spotlight, чтобы попасть в настройки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je ikona skrytá, k nastaveniam sa dostanete opätovným otvorením Cranny z Findera alebo zo Spotlightu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je ikona skrita, do nastavitev pridete tako, da Cranny znova odprete v aplikaciji Finder ali z iskanjem Spotlight."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När symbolen är dold kan du nå inställningarna genom att öppna Cranny igen från Finder eller Spotlight."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อซ่อนไอคอนแล้ว ให้เปิด Cranny อีกครั้งจาก Finder หรือ Spotlight เพื่อไปที่การตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simge gizliyken Ayarlar’a ulaşmak için Cranny’yi Finder’dan veya Spotlight’tan yeniden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо значок сховано, відкрийте Cranny знову з Finder або Spotlight, щоб перейти до параметрів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi ẩn biểu tượng, hãy mở lại Cranny từ Finder hoặc Spotlight để vào Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏图标后，可从“访达”或“聚焦”再次打开Cranny以进入设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏後，請從Finder或Spotlight再次打開Cranny來進入設定。"
          }
        }
      }
    },
    "When you open Cranny with the keyboard, just start typing to write a note or a to-do." : {
      "comment" : "Settings ▸ Keyboard: footnote of Type to capture",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند فتح Cranny بلوحة المفاتيح، ابدأ الكتابة مباشرة لتدوين ملاحظة أو مهمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan obres el Cranny amb el teclat, només cal que comencis a escriure per crear una nota o una tasca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když Cranny otevřete z klávesnice, stačí začít psát a vznikne poznámka nebo úkol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du åbner Cranny med tastaturet, kan du bare begynde at skrive for at lave en note eller en opgave."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Cranny mit der Tastatur öffnest, tippe einfach los, um eine Notiz oder Aufgabe zu schreiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν ανοίγετε το Cranny με το πληκτρολόγιο, απλώς αρχίστε να πληκτρολογείτε για να γράψετε μια σημείωση ή μια εργασία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando abras Cranny con el teclado, empieza a escribir para crear una nota o una tarea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun avaat Crannyn näppäimistöllä, ala vain kirjoittaa, niin syntyy muistiinpano tai tehtävä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous ouvrez Cranny au clavier, commencez simplement à écrire pour créer une note ou une tâche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשפותחים את Cranny מהמקלדת, אפשר פשוט להתחיל להקליד כדי לכתוב פתק או משימה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीबोर्ड से Cranny खोलने पर बस टाइप करना शुरू करें, नोट या कार्य बन जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad otvorite Cranny tipkovnicom, samo počnite tipkati da biste napisali bilješku ili zadatak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha billentyűzettel nyitja meg a Crannyt, egyszerűen kezdjen el gépelni, és jegyzet vagy teendő lesz belőle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Anda membuka Cranny dengan papan ketik, langsung mulai mengetik untuk menulis catatan atau tugas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando apri Cranny con la tastiera, basta iniziare a digitare per scrivere una nota o una cosa da fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードでCrannyを開いたら、そのまま入力するだけでメモやToDoを書けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드로 Cranny를 열었을 때 바로 입력을 시작하면 메모나 할 일을 작성할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila anda membuka Cranny dengan papan kekunci, mula sahaja menaip untuk menulis nota atau tugasan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du åpner Cranny med tastaturet, kan du bare begynne å skrive for å lage et notat eller et gjøremål."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je Cranny met het toetsenbord opent, begin je gewoon te typen voor een notitie of taak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy otworzysz Cranny klawiaturą, po prostu zacznij pisać, aby utworzyć notatkę lub zadanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
