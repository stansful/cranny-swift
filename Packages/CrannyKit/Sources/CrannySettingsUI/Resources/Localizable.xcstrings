    "Light in the color of what is playing or happening, only while Cranny is open." : {
      "comment" : "Settings ▸ Appearance: footnote of Ambient light",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضوء بلون ما يتم تشغيله أو ما يحدث، فقط أثناء فتح Cranny."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llum del color del que sona o passa, només mentre el Cranny està obert."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Světlo v barvě toho, co hraje nebo se děje – jen když je Cranny otevřený."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lys i farven fra det, der afspilles eller sker – kun mens Cranny er åben."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licht in der Farbe dessen, was gerade läuft oder passiert – nur solange Cranny geöffnet ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φως στο χρώμα αυτού που παίζει ή συμβαίνει, μόνο όσο το Cranny είναι ανοιχτό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luz del color de lo que suena o sucede, solo mientras Cranny está abierto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toistettavan sisällön tai tapahtuman värinen valo, vain kun Cranny on auki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une lumière de la couleur de ce qui est en lecture ou en cours, uniquement quand Cranny est ouvert."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אור בצבע של מה שמתנגן או קורה, רק כש-Cranny פתוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो चल रहा है या हो रहा है, उसके रंग की रोशनी, केवल तब जब Cranny खुला हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svjetlo u boji onoga što se reproducira ili događa, samo dok je Cranny otvoren."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fény annak színében, ami éppen szól vagy történik – csak amíg a Cranny nyitva van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cahaya dengan warna dari apa yang sedang diputar atau terjadi, hanya saat Cranny terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luce nel colore di ciò che è in riproduzione o in corso, solo mentre Cranny è aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crannyが開いている間だけ、再生中の曲や進行中の出来事の色で光ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생 중이거나 진행 중인 항목의 색상으로 빛납니다. Cranny가 열려 있을 때만 작동합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cahaya dalam warna perkara yang sedang dimainkan atau berlaku, hanya semasa Cranny terbuka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lys i fargen til det som spilles eller skjer, bare mens Cranny er åpen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licht in de kleur van wat er speelt of gebeurt, alleen terwijl Cranny open is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Światło w kolorze tego, co jest odtwarzane lub co się dzieje – tylko gdy Cranny jest otwarty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luz na cor do que está tocando ou acontecendo, só enquanto o Cranny está aberto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luz na cor do que está a tocar ou a acontecer, só enquanto o Cranny está aberto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumină în culoarea a ceea ce se redă sau se întâmplă, doar cât timp Cranny este deschis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свет в цвет того, что играет или происходит, — только пока Cranny открыт."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svetlo vo farbe toho, čo sa prehráva alebo deje – len pri otvorenom Cranny."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svetloba v barvi tega, kar se predvaja ali dogaja, samo ko je Cranny odprt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljus i samma färg som det som spelas eller händer, bara medan Cranny är öppen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสงตามสีของสิ่งที่กำลังเล่นหรือกำลังเกิดขึ้น เฉพาะขณะที่ Cranny เปิดอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalan ya da olup biten şeyin renginde ışık; yalnızca Cranny açıkken."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Світло кольору того, що грає чи відбувається, — лише поки Cranny відкритий."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ánh sáng mang màu của nội dung đang phát hoặc đang diễn ra, chỉ khi Cranny đang mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在Cranny打开时，以当前播放或进行中内容的颜色发光。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以正在播放或進行中內容的顏色發光，僅在Cranny打開時顯示。"
          }
        }
      }
    },
