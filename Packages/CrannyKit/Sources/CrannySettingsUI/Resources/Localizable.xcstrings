    "Connect a display with a notch to fit Cranny to its camera housing." : {
      "comment" : "Settings ▸ Appearance ▸ Notch fit: footer when no notched display is connected",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِل شاشة تحتوي على نتوء لملاءمة Cranny مع منطقة الكاميرا فيها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecta una pantalla amb osca per ajustar el Cranny a la carcassa de la càmera."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete‑li Cranny přizpůsobit oblasti kamery, připojte monitor s výřezem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilslut en skærm med notch for at tilpasse Cranny til kamerahuset."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe ein Display mit Notch an, um Cranny an dessen Kameragehäuse anzupassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέστε μια οθόνη με εγκοπή για να προσαρμόσετε το Cranny στο περίβλημα της κάμερας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta una pantalla con muesca para ajustar Cranny a la zona de la cámara."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liitä näyttö, jossa on lovi, niin voit sovittaa Crannyn sen kameran koteloon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez un écran à encoche pour ajuster Cranny au logement de sa caméra."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לחבר צג עם מגרעת כדי להתאים את Cranny לגוף המצלמה שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny को कैमरा हाउसिंग के अनुसार फ़िट करने के लिए नॉच वाला डिस्प्ले कनेक्ट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojite zaslon s izrezom da biste prilagodili Cranny kućištu njegove kamere."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakoztasson egy kivágással rendelkező kijelzőt, hogy a Crannyt a kameraházhoz igazíthassa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan layar dengan notch untuk menyesuaikan Cranny dengan bagian kamera layar tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega uno schermo con la tacca per adattare Cranny all’area della fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crannyをカメラハウジングに合わせるには、ノッチのあるディスプレイを接続してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 하우징에 Cranny를 맞추려면 노치가 있는 디스플레이를 연결하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungkan paparan bertakuk untuk memadankan Cranny dengan kotak kameranya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble til en skjerm med hakk for å tilpasse Cranny til kamerahuset."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit een beeldscherm met een notch aan om Cranny op de camerabehuizing af te stemmen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podłącz wyświetlacz z wycięciem, aby dopasować Cranny do obudowy kamery."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte uma tela com notch para ajustar o Cranny à área da câmera."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligue um monitor com entalhe para ajustar o Cranny à zona da câmara."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectați un afișaj cu decupaj pentru a ajusta Cranny la zona camerei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите дисплей с вырезом, чтобы подогнать Cranny под корпус камеры."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripojte displej s výrezom, aby ste mohli Cranny prispôsobiť oblasti kamery."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priključite zaslon z zarezo, da Cranny prilagodite ohišju kamere."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut en skärm med notch för att anpassa Cranny efter dess kamerahus."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อจอภาพที่มีรอยบากเพื่อปรับ Cranny ให้พอดีกับตัวเรือนกล้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny’yi kamera yuvasına uydurmak için çentikli bir ekran bağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підключіть дисплей із вирізом, щоб підігнати Cranny під корпус камери."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối màn hình có tai thỏ để căn Cranny theo phần camera."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接带刘海的显示器，即可让Cranny贴合其摄像头区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接有瀏海的顯示器，即可讓Cranny貼合其相機外殼。"
          }
        }
      }
    },
    "Connect a trackpad to use gestures. Every gesture also has a click or key." : {
      "comment" : "Settings ▸ Gestures: footer when no trackpad is present",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِل لوحة تعقب لاستخدام الإيماءات. لكل إيماءة بديل بالنقر أو بمفتاح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecta un trackpad per fer servir gestos. Cada gest també té un clic o una tecla equivalent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete‑li používat gesta, připojte trackpad. Každé gesto lze nahradit kliknutím nebo klávesou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilslut et pegefelt for at bruge bevægelser. Alle bevægelser har også et klik eller en tast."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe ein Trackpad an, um Gesten zu verwenden. Für jede Geste gibt es auch einen Klick oder eine Taste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέστε μια επιφάνεια αφής για να χρησιμοποιείτε χειρονομίες. Κάθε χειρονομία έχει επίσης αντίστοιχο κλικ ή πλήκτρο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta un trackpad para usar gestos. Cada gesto tiene también un clic o una tecla equivalente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liitä ohjauslevy, niin voit käyttää eleitä. Jokaisen eleen voi tehdä myös klikkauksella tai näppäimellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez un trackpad pour utiliser les gestes. Chaque geste a aussi son équivalent au clic ou au clavier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לחבר משטח מגע כדי להשתמש במחוות. לכל מחווה יש גם חלופה של לחיצה או מקש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जेस्चर इस्तेमाल करने के लिए ट्रैकपैड कनेक्ट करें। हर जेस्चर के लिए क्लिक या कीज़ वाला विकल्प भी है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojite dodirnu površinu da biste koristili geste. Svaka gesta ima i zamjenu klikom ili tipkom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakoztasson egy trackpadet a kézmozdulatok használatához. Minden kézmozdulat kattintással vagy billentyűvel is helyettesíthető."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan trackpad untuk menggunakan gerakan. Setiap gerakan juga dapat diganti dengan klik atau tombol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega un trackpad per usare i gesti. Ogni gesto ha anche un clic o un tasto equivalente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジェスチャを使うにはトラックパッドを接続してください。どのジェスチャも、クリックまたはキーで代わりに操作できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제스처를 사용하려면 트랙패드를 연결하십시오. 모든 제스처는 클릭이나 키로도 할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungkan trackpad untuk menggunakan gerak isyarat. Setiap gerak isyarat juga mempunyai klik atau kekunci gantian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble til en styreflate for å bruke bevegelser. Hver bevegelse har også et klikk eller en tast som alternativ."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit een trackpad aan om gebaren te gebruiken. Elk gebaar kan ook met een klik of toets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podłącz gładzik, aby używać gestów. Każdy gest ma też odpowiednik w postaci kliknięcia lub klawisza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte um trackpad para usar gestos. Todo gesto também tem um clique ou uma tecla equivalente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligue um trackpad para usar gestos. Todos os gestos também têm um clique ou uma tecla."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectați un trackpad pentru a folosi gesturile. Fiecare gest are și un echivalent prin clic sau tastă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите трекпад, чтобы пользоваться жестами. У каждого жеста есть замена нажатием или клавишей."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete používať gestá, pripojte trackpad. Každé gesto má aj náhradu kliknutím alebo klávesom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za uporabo kretenj priključite sledilno ploščico. Vsako kretnjo lahko nadomestite s klikom ali tipko."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut en styrplatta för att använda gester. Varje gest kan också ersättas med ett klick eller en tangent."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อแทร็คแพดเพื่อใช้คำสั่งนิ้ว คำสั่งนิ้วทุกแบบมีการคลิกหรือปุ่มที่ใช้แทนได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareketleri kullanmak için bir izleme dörtgeni bağlayın. Her hareketin bir tıklama veya tuş karşılığı da vardır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підключіть трекпед, щоб користуватися жестами. Кожен жест має заміну: клацання або клавішу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối bàn di chuột để dùng cử chỉ. Mỗi cử chỉ đều có thao tác bấm hoặc phím thay thế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接触控板即可使用手势。每个手势都有对应的点按或按键操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接觸控式軌跡板即可使用手勢。每個手勢也都能以按一下或按鍵代替。"
          }
        }
      }
    },
