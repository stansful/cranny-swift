    "Larger text also makes the widgets larger, so nothing is cut off." : {
      "comment" : "Settings ▸ Appearance: footnote of Text size",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تكبير النص تكبر الأدوات أيضًا، حتى لا يُقتطع أي شيء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb un text més gran, els ginys també es fan més grans perquè no es retalli res."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S větším textem se zvětší i widgety, aby se nic neořízlo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Større tekst gør også widgets større, så intet bliver skåret af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größerer Text macht auch die Widgets größer, damit nichts abgeschnitten wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με μεγαλύτερο κείμενο μεγαλώνουν και τα widget, ώστε να μην κόβεται τίποτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un texto más grande, los widgets también crecen para que no se corte nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurempi teksti suurentaa myös widgetit, jotta mitään ei leikkaudu pois."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un texte plus grand agrandit aussi les widgets, pour que rien ne soit tronqué."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מלל גדול יותר מגדיל גם את הווידג׳טים, כך ששום דבר לא נחתך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बड़े टेक्स्ट से विजेट भी बड़े हो जाते हैं, ताकि कुछ भी कटे नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veći tekst povećava i widgete pa ništa nije odrezano."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagyobb szöveggel a widgetek is nagyobbak lesznek, így semmi sem vágódik le."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks yang lebih besar juga memperbesar widget, sehingga tidak ada yang terpotong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un testo più grande anche i widget si ingrandiscono, così nulla viene tagliato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストを大きくするとウィジェットも大きくなるため、表示が切れることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트가 커지면 위젯도 함께 커지므로 잘리는 부분이 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks yang lebih besar turut membesarkan widget supaya tiada yang terpotong."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Større tekst gjør også widgetene større, så ingenting kuttes av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grotere tekst maakt ook de widgets groter, zodat er niets wordt afgekapt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Większy tekst powiększa też widżety, aby nic nie zostało ucięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um texto maior também deixa os widgets maiores, para que nada seja cortado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com texto maior, os widgets também ficam maiores, para que nada seja cortado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un text mai mare mărește și widgeturile, ca să nu se taie nimic."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С крупным текстом виджеты тоже становятся больше, чтобы ничего не обрезалось."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S väčším textom sa zväčšia aj widgety, aby sa nič neorezalo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z večjim besedilom se povečajo tudi gradniki, da se nič ne odreže."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Större text gör också widgetarna större, så att inget klipps av."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความที่ใหญ่ขึ้นจะทำให้วิดเจ็ตใหญ่ขึ้นด้วย เพื่อไม่ให้มีสิ่งใดถูกตัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyük metin araç takımlarını da büyütür, böylece hiçbir şey kesilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Із більшим текстом віджети теж стають більшими, щоб нічого не обрізалося."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chữ lớn hơn cũng làm tiện ích lớn hơn để không có gì bị cắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字变大时小组件也会变大，因此不会有内容被截断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字較大時，小工具也會跟著變大，內容就不會被裁切。"
          }
        }
      }
    },
