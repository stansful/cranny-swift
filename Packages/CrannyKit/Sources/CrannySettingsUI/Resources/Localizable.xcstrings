    "On displays without a notch, the handle fades out after this long without activity." : {
      "comment" : "Settings ▸ General: footnote of Hide the handle when idle",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على شاشات العرض بلا نتوء، يختفي المقبض تدريجيًا بعد هذه المدة من عدم النشاط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A les pantalles sense osca, la nansa s’esvaeix després d’aquest temps sense activitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na monitorech bez výřezu úchyt po této době nečinnosti zmizí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På skærme uden notch forsvinder håndtaget efter så lang tid uden aktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Displays ohne Notch wird der Griff nach dieser Zeit ohne Aktivität ausgeblendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε οθόνες χωρίς εγκοπή, η λαβή σβήνει μετά από τόσο χρόνο χωρίς δραστηριότητα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pantallas sin muesca, el tirador se desvanece tras este tiempo sin actividad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytöillä, joissa ei ole lovea, kahva häipyy näkyvistä, kun toimintaa ei ole ollut näin pitkään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur les écrans sans encoche, la poignée s’estompe après ce délai d’inactivité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בצגים ללא מגרעת, הידית נעלמת אחרי פרק זמן זה ללא פעילות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना नॉच वाले डिस्प्ले पर, इतनी देर तक कोई गतिविधि न होने पर हैंडल ओझल हो जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na zaslonima bez izreza ručka nestaje nakon ovoliko vremena bez aktivnosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kivágás nélküli kijelzőkön a fogantyú ennyi tétlen idő után elhalványul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di layar tanpa notch, pegangan memudar setelah tidak ada aktivitas selama waktu ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugli schermi senza tacca, la maniglia scompare dopo questo tempo di inattività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチのないディスプレイでは、操作がない状態がこの時間続くとハンドルが消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치가 없는 디스플레이에서는 이 시간 동안 사용하지 않으면 핸들이 사라집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada paparan tanpa takuk, pemegang pudar selepas tempoh ini tanpa aktiviti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På skjermer uten hakk tones håndtaket ut etter så lang tid uten aktivitet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op beeldschermen zonder notch vervaagt de greep na deze tijd zonder activiteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na wyświetlaczach bez wycięcia uchwyt znika po takim czasie bezczynności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em telas sem notch, a alça desaparece após este tempo sem atividade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em monitores sem entalhe, o puxador desaparece após este tempo sem atividade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pe afișajele fără decupaj, mânerul dispare după acest interval fără activitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На дисплеях без выреза ручка исчезает после такого времени без активности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na displejoch bez výrezu úchyt po takomto čase nečinnosti zmizne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na zaslonih brez zareze ročica po tolikšnem času nedejavnosti izgine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På skärmar utan notch tonas handtaget ut efter så här lång tid utan aktivitet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บนจอภาพที่ไม่มีรอยบาก ที่จับจะค่อยๆ หายไปเมื่อไม่มีการใช้งานนานเท่านี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çentiksiz ekranlarda tutamak, bu kadar süre işlem yapılmazsa kaybolur."
          }
        },
