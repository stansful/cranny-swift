    "How long a peek stays before it folds back." : {
      "comment" : "Settings ▸ Live Activities: footnote of Peek duration",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدة بقاء اللمحة قبل أن تُطوى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanta estona es manté una ullada abans de tornar a plegar‑se."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak dlouho zůstane nahlédnutí zobrazené, než se znovu sbalí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor længe et smugkig bliver vist, før det folder sig sammen igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange eine Kurzansicht sichtbar bleibt, bevor sie sich wieder einklappt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόση ώρα μένει μια μίνι προβολή πριν συμπτυχθεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto tiempo permanece un vistazo antes de recogerse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka kauan kurkistus näkyy, ennen kuin se palaa loveen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée d’affichage d’un mini-aperçu avant qu’il ne se replie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה זמן הצצה נשארת לפני שהיא מתקפלת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिनी व्यू वापस सिमटने से पहले कितनी देर दिखे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko dugo miniprikaz ostaje prije nego što se ponovno skupi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddig marad látható a betekintés, mielőtt visszahúzódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berapa lama intipan tetap tampil sebelum diciutkan kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per quanto tempo resta un’occhiata prima di richiudersi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミニ表示が格納されるまでの表示時間です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "살짝 보기가 다시 접히기 전까지 표시되는 시간입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berapa lama intaian kekal sebelum dikuncupkan semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor lenge et glimt vises før det trekkes inn igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe lang een miniweergave blijft staan voordat die weer inklapt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak długo minipodgląd pozostaje widoczny, zanim się zwinie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por quanto tempo uma espiada fica visível antes de se recolher."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo uma espreitadela fica visível antes de se recolher."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât timp rămâne o extindere înainte de a se retrage."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько мини-просмотр остаётся на экране, прежде чем свернуться."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako dlho zostane nahliadnutie zobrazené, kým sa zbalí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako dolgo ostane vpogled, preden se zloži nazaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur länge en smygtitt visas innan den fälls ihop."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระยะเวลาที่มุมมองย่อจะแสดงอยู่ก่อนย่อกลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısa bakışın kapanmadan önce ekranda ne kadar kalacağı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скільки мініперегляд залишається на екрані, перш ніж згорнутися."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian xem lướt hiển thị trước khi thu lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "速览在收起前停留的时长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "速覽在收合前停留的時間。"
          }
        }
      }
    },
    "How long the pointer rests on the notch before Cranny opens." : {
      "comment" : "Settings ▸ General: footnote of Hover delay",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المدة التي يبقى فيها المؤشر على النتوء قبل فتح Cranny."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanta estona s’ha de deixar el punter a l’osca perquè s’obri el Cranny."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak dlouho musí ukazatel zůstat na výřezu, než se Cranny otevře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor længe markøren skal hvile på notchen, før Cranny åbnes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange der Zeiger auf der Notch ruhen muss, bis sich Cranny öffnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόση ώρα πρέπει να μείνει ο δείκτης πάνω στην εγκοπή για να ανοίξει το Cranny."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto tiempo debe permanecer el puntero sobre la muesca antes de que Cranny se abra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka kauan osoittimen täytyy olla loven päällä, ennen kuin Cranny avautuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée pendant laquelle le pointeur doit rester sur l’encoche avant l’ouverture de Cranny."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה זמן המצביע צריך להישאר על המגרעת לפני ש-Cranny נפתח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny खुलने से पहले पॉइंटर को नॉच पर कितनी देर रुकना है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko dugo pokazivač mora mirovati na izrezu prije nego što se Cranny otvori."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mennyi ideig kell a mutatónak a kivágáson maradnia, mielőtt a Cranny megnyílik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berapa lama penunjuk harus berada di notch sebelum Cranny terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per quanto tempo il puntatore resta sulla tacca prima che Cranny si apra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crannyが開くまでに、ポインタをノッチに置いておく時間です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny가 열리기 전에 포인터가 노치 위에 머물러야 하는 시간입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berapa lama penuding berada pada takuk sebelum Cranny dibuka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor lenge pekeren må hvile på hakket før Cranny åpnes."
          }
        },
