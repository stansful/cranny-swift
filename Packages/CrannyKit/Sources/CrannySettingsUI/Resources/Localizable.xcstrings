    "Opening there needs a longer rest of the pointer." : {
      "comment" : "Settings ▸ General: footnote of In full-screen apps",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب الفتح هناك إبقاء المؤشر لمدة أطول."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per obrir‑lo sobre aquestes apps, el punter s’hi ha d’aturar més estona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevření tam vyžaduje delší podržení ukazatele."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I apps på fuld skærm skal markøren hvile længere, før Cranny åbnes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Öffnen muss der Zeiger dort länger ruhen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκεί, για να ανοίξει, ο δείκτης πρέπει να μείνει περισσότερη ώρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allí hay que dejar el puntero más tiempo para abrir Cranny."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niissä avaaminen vaatii, että osoitinta pidetään paikallaan pidempään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans ce cas, le pointeur doit rester plus longtemps pour ouvrir Cranny."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לפתוח שם, יש להשאיר את המצביע זמן רב יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वहाँ खोलने के लिए पॉइंटर को ज़्यादा देर रखना पड़ता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ondje je za otvaranje potrebno dulje zadržati pokazivač."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ott a megnyitáshoz tovább kell a kivágáson tartani a mutatót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk membuka di sana, penunjuk harus diam lebih lama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lì, per aprire Cranny, il puntatore deve restare fermo più a lungo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルスクリーンのアプリで開くには、ポインタを長めに置く必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 화면 앱에서는 포인터를 더 오래 올려 두어야 열립니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk membuka Cranny di sana, penuding perlu berada lebih lama pada takuk."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der må pekeren hvile lenger før Cranny åpnes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daar moet de aanwijzer langer rusten om te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam otwarcie wymaga dłuższego zatrzymania wskaźnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesses apps, o ponteiro precisa ficar parado por mais tempo para abrir o Cranny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para abrir aí, o cursor tem de ficar pousado mais tempo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acolo, cursorul trebuie ținut mai mult timp pe decupaj pentru deschidere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Там для открытия указатель должен задержаться дольше."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam sa Cranny otvorí, až keď kurzor zostane nad výrezom dlhšie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam mora kazalnik za odpiranje mirovati dlje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Där måste pekaren vila längre för att Cranny ska öppnas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเปิดในแอปเหล่านั้นต้องวางตัวชี้ไว้นานขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
