    "Rest the pointer on an activity to see its details." : {
      "comment" : "Settings ▸ Live Activities: footnote of Quick peek on hover",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع المؤشر على نشاط لرؤية تفاصيله."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa el punter sobre una activitat per veure’n els detalls."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržením ukazatele na aktivitě zobrazíte podrobnosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad markøren hvile på en aktivitet for at se detaljer."
          }
        },
