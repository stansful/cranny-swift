          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurempi arvo vaatii lyhyemmän sormen liikkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
