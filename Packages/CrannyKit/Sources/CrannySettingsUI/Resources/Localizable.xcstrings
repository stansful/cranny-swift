        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσο υψηλότερη, τόσο μικρότερη κίνηση των δαχτύλων χρειάζεται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
