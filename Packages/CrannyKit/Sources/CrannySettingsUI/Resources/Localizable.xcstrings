    "Swipe down to open, up to close" : {
      "comment" : "Settings ▸ Gestures: toggle",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السحب لأسفل للفتح ولأعلى للإغلاق"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llisca cap avall per obrir i cap amunt per tancar"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevírat přejetím dolů, zavírat nahoru"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skub ned for at åbne, op for at lukke"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Öffnen nach unten, zum Schließen nach oben streichen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σάρωση προς τα κάτω για άνοιγμα, προς τα πάνω για κλείσιμο"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslizar hacia abajo para abrir y hacia arriba para cerrar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa pyyhkäisemällä alas, sulje ylös"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayer vers le bas pour ouvrir, vers le haut pour fermer"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלקה למטה לפתיחה ולמעלה לסגירה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोलने के लिए नीचे, बंद करने के लिए ऊपर स्वाइप करें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povuci dolje za otvaranje, gore za zatvaranje"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lefelé legyintés: megnyitás, felfelé: bezárás"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesek ke bawah untuk membuka, ke atas untuk menutup"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri in basso per aprire, in alto per chiudere"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下にスワイプで開き、上にスワイプで閉じる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래로 쓸어내려 열고 위로 쓸어올려 닫기"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leret ke bawah untuk membuka, ke atas untuk menutup"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip ned for å åpne, opp for å lukke"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg omlaag om te openen, omhoog om te sluiten"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń w dół, aby otworzyć, w górę, aby zamknąć"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir deslizando para baixo, fechar para cima"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslizar para baixo para abrir e para cima para fechar"
          }
        },
        "ro" : {
