    },
    "Showed that Now Playing can still be read from a helper hosted in the system’s Perl." : {
      "comment" : "Settings ▸ About ▸ Acknowledgements: what Cranny learned from mediaremote-adapter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوضح أنه لا يزال من الممكن قراءة \"قيد التشغيل\" عبر مساعد يعمل داخل Perl الخاص بالنظام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va mostrar que “Ara sona” encara es pot llegir des d’un assistent allotjat al Perl del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukázal, že informace Právě hraje lze stále číst pomocí pomocníka spuštěného v systémovém Perlu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viste, at “Afspiller nu” stadig kan læses fra en hjælper, der kører i systemets Perl."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat gezeigt, dass „Jetzt läuft“ weiterhin über ein Hilfsprogramm im System-Perl gelesen werden kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έδειξε ότι το «Παίζει τώρα» μπορεί ακόμη να διαβαστεί από έναν βοηθό που εκτελείται στην Perl του συστήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostró que “Ahora suena” aún se puede leer desde un asistente alojado en el Perl del sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytti, että Toistossa nyt -tietoja voi yhä lukea järjestelmän Perlissä toimivan apuohjelman kautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A montré que « À l’écoute » peut encore être lu depuis un assistant exécuté par le Perl du système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הראה שעדיין אפשר לקרוא את ״מופעל כעת״ מרכיב עזר שרץ ב-Perl של המערכת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिखाया कि सिस्टम के Perl में चलने वाले हेल्पर से “अभी चल रहा है” अब भी पढ़ा जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazao je da se podaci “Izvodi se” još uvijek mogu očitati pomoću pomoćnika pokrenutog u Perlu sustava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megmutatta, hogy a „Lejátszás alatt” adatai még mindig kiolvashatók egy, a rendszer Perl-értelmezőjében futó segédből."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunjukkan bahwa “Sedang Diputar” masih dapat dibaca dari alat bantu yang berjalan di Perl milik sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha mostrato che “In riproduzione” si può ancora leggere da un helper eseguito nel Perl di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムのPerlで動くヘルパーから、今でも“再生中”の情報を読み取れることを示してくれました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템의 Perl에서 실행되는 도우미로 여전히 ‘지금 재생 중’ 정보를 읽을 수 있음을 알려주었습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunjukkan bahawa Kini Dimainkan masih boleh dibaca daripada pembantu yang dihoskan dalam Perl sistem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viste at «Spilles nå» fortsatt kan leses fra en hjelper som kjører i systemets Perl."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liet zien dat de gegevens van ‘Huidig onderdeel’ nog steeds kunnen worden uitgelezen via een hulpprogramma dat in de Perl van het systeem draait."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazał, że informacje o odtwarzanych multimediach nadal można odczytać przez pomocnika uruchamianego w systemowym Perlu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrou que as informações de Reproduzindo ainda podem ser lidas por um auxiliar executado no Perl do sistema."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrou que “A reproduzir” ainda pode ser lido a partir de um auxiliar executado no Perl do sistema."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A arătat că informațiile „În redare” pot fi citite în continuare printr‑un asistent rulat de Perl din sistem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показал, что «Исполняется» всё ещё можно читать из помощника, запущенного в системном Perl."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
