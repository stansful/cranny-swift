    "You feel it while a finger rests on a Force Touch trackpad." : {
      "comment" : "Settings ▸ Gestures: footnote of Haptic feedback",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشعر بها عندما يكون إصبعك على لوحة تعقب Force Touch."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho notes mentre tens un dit sobre un trackpad Force Touch."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odezvu ucítíte, když prst spočívá na trackpadu Force Touch."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du mærker det, mens en finger hviler på et Force Touch-pegefelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du spürst es, während ein Finger auf einem Force Touch-Trackpad liegt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γίνεται αισθητή όσο ένα δάχτυλο ακουμπά σε επιφάνεια αφής Force Touch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo notas mientras un dedo descansa sobre un trackpad Force Touch."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnet sen, kun sormi lepää Force Touch -ohjauslevyllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous le ressentez quand un doigt repose sur un trackpad Force Touch."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרטט מורגש כשאצבע מונחת על משטח מגע עם Force Touch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch ट्रैकपैड पर उंगली रखे रहने पर यह महसूस होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osjeti se dok prst miruje na dodirnoj površini Force Touch."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkor érzi, amikor az ujja egy Force Touch trackpaden nyugszik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda merasakannya saat jari berada di trackpad Force Touch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si avverte quando un dito è appoggiato su un trackpad Force Touch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感圧タッチトラックパッドに指を置いているときに感じられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch 트랙패드에 손가락을 올려 두고 있을 때 느낄 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda merasakannya semasa jari berada pada trackpad Force Touch."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kjenner det mens en finger hviler på en Force Touch-styreflate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je voelt het terwijl een vinger op een Force Touch-trackpad rust."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czujesz je, gdy palec spoczywa na gładziku Force Touch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você o sente enquanto um dedo está apoiado em um trackpad Force Touch."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sente‑o enquanto um dedo está pousado num trackpad Force Touch."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îl simțiți cât timp țineți un deget pe un trackpad Force Touch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отклик ощущается, пока палец лежит на трекпаде Force Touch."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odozvu cítite, keď máte prst položený na trackpade Force Touch."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Občutite ga, ko prst počiva na sledilni ploščici Force Touch."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du känner det när ett finger vilar på en Force Touch-styrplatta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะรู้สึกได้ขณะที่นิ้ววางอยู่บนแทร็คแพด Force Touch"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmağınız Force Touch izleme dörtgeninin üzerindeyken hissedersiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вібровідгук відчувається, коли палець лежить на трекпеді Force Touch."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn cảm nhận được khi ngón tay đặt trên bàn di chuột Force Touch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
