          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã cho thấy “Đang phát” vẫn có thể được đọc từ một trình trợ giúp chạy trong Perl của hệ thống."
          }
        },
        "zh-Hans" : {
