    "Two fingers left or right over the playing song." : {
      "comment" : "Settings ▸ Gestures: footnote of Swipe sideways to change track",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب بإصبعين لليسار أو لليمين فوق الأغنية قيد التشغيل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos dits a l’esquerra o a la dreta sobre la cançó que sona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvěma prsty doleva nebo doprava nad hrající skladbou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To fingre til venstre eller højre over den sang, der afspilles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit zwei Fingern nach links oder rechts über dem laufenden Titel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δύο δάχτυλα αριστερά ή δεξιά πάνω από το τραγούδι που παίζει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza dos dedos hacia la izquierda o la derecha sobre la canción que suena."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahdella sormella vasemmalle tai oikealle soivan kappaleen päällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux doigts vers la gauche ou la droite sur le morceau en cours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שתי אצבעות שמאלה או ימינה מעל השיר שמתנגן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बज रहे गीत के ऊपर दो उंगलियों से दाएँ या बाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dva prsta ulijevo ili udesno preko pjesme koja se reproducira."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Két ujjal balra vagy jobbra a lejátszott dal fölött."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dua jari ke kiri atau ke kanan di atas lagu yang sedang diputar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri con due dita a sinistra o a destra sul brano in riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生中の曲の上で、2本指で左右にスワイプします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생 중인 노래 위에서 두 손가락으로 왼쪽 또는 오른쪽으로 쓸어넘깁니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leret dua jari ke kiri atau ke kanan pada lagu yang sedang dimainkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To fingre til venstre eller høyre over sangen som spilles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twee vingers naar links of rechts over het nummer dat speelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwoma palcami w lewo lub w prawo nad odtwarzanym utworem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dois dedos para a esquerda ou para a direita sobre a música que está tocando."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dois dedos para a esquerda ou para a direita sobre a música em reprodução."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisați cu două degete la stânga sau la dreapta peste piesa în redare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двумя пальцами влево или вправо над играющей песней."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvomi prstami doľava alebo doprava nad prehrávanou skladbou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
