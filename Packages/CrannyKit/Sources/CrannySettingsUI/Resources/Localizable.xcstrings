    "Every Cranny setting returns to its default. You can undo this for 10 seconds." : {
      "comment" : "Settings ▸ General: Reset All confirmation message",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود كل إعدادات Cranny إلى قيمها الافتراضية. يمكنك التراجع عن ذلك خلال عشر ثوانٍ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tota la configuració del Cranny tornarà als valors per omissió. Ho pots desfer durant 10 segons."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechna nastavení Cranny se vrátí na výchozí hodnoty. Odvolat to můžete do 10 sekund."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle indstillinger i Cranny nulstilles til standard. Du kan fortryde i 10 sekunder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Einstellungen von Cranny werden auf den Standard zurückgesetzt. Du kannst dies 10 Sekunden lang widerrufen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι ρυθμίσεις του Cranny επανέρχονται στις προεπιλογές τους. Μπορείτε να το αναιρέσετε μέσα σε 10 δευτερόλεπτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los ajustes de Cranny volverán a su valor predeterminado. Puedes deshacerlo durante 10 segundos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki Crannyn asetukset palautetaan oletusarvoihin. Voit perua tämän 10 sekunnin ajan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les réglages de Cranny reprennent leur valeur par défaut. Vous pourrez annuler pendant 10 secondes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל ההגדרות של Cranny יחזרו לברירת המחדל. ניתן לבטל זאת במשך 10 שניות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny की हर सेटिंग डिफ़ॉल्ट पर लौट आएगी। आप 10 सेकंड तक इसे पहले जैसा कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve postavke aplikacije Cranny vraćaju se na standardne vrijednosti. To možete poništiti u roku od 10 sekundi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Cranny minden beállítása visszaáll az alapértelmezettre. Ezt 10 másodpercig visszavonhatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap pengaturan Cranny kembali ke default. Anda dapat mengurungkannya dalam 10 detik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
