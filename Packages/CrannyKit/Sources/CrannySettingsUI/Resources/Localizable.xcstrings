    "Notes, to-dos and tray files are kept." : {
      "comment" : "Settings ▸ General: footnote of Reset All Settings",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم الاحتفاظ بالملاحظات والمهام وملفات الرف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es conserven les notes, les tasques i els arxius de la safata."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámky, úkoly a soubory v přihrádce zůstanou zachované."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noter, opgaver og filer på hylden bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen, Aufgaben und Dateien in der Ablage bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι σημειώσεις, οι εργασίες και τα αρχεία του ραφιού διατηρούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conservan las notas, las tareas y los archivos de la bandeja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muistiinpanot, tehtävät ja hyllyn tiedostot säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes, les tâches et les fichiers de l’étagère sont conservés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתקים, משימות וקבצים על המדף נשמרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट्स, कार्य और ट्रे की फ़ाइलें बनी रहती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilješke, zadaci i datoteke na polici ostaju sačuvani."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jegyzetek, a teendők és a polcon lévő fájlok megmaradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan, tugas, dan file di Rak tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note, cose da fare e file sul ripiano vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモ、ToDo、トレイのファイルは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모, 할 일 및 선반의 파일은 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota, tugasan dan fail di Rak dikekalkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notater, gjøremål og filer på hyllen beholdes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notities, taken en bestanden in de lade blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notatki, zadania i pliki na półce zostaną zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas, tarefas e arquivos da Bandeja serão mantidos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notas, as tarefas e os ficheiros da bandeja são mantidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notițele, sarcinile și fișierele de pe raft se păstrează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заметки, задачи и файлы на полке сохранятся."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámky, úlohy a súbory na polici zostanú zachované."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapiski, opravila in datoteke na polici ostanejo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteckningar, uppgifter och filer på hyllan behålls."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โน้ต สิ่งที่ต้องทำ และไฟล์ในถาดจะยังคงอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notlar, görevler ve Raf’taki dosyalar korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нотатки, справи й файли на полиці збережуться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi chú, việc cần làm và tệp trong Khay được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
