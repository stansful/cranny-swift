    "Used for progress, rings and toggles. Alerts keep their own colors." : {
      "comment" : "Settings ▸ Appearance ▸ Accent: footnote for a swatch",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم للتقدّم والحلقات ومفاتيح التبديل. تحتفظ التنبيهات بألوانها الخاصة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’utilitza per al progrés, els anells i els interruptors. Els avisos mantenen els seus colors."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá se pro průběh, kroužky a přepínače. Upozornění si ponechávají své barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til forløb, ringe og kontakter. Advarsler beholder deres egne farver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Fortschritt, Ringe und Schalter. Hinweise behalten ihre eigenen Farben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται για την πρόοδο, τους δακτυλίους και τους διακόπτες. Οι ειδοποιήσεις διατηρούν τα δικά τους χρώματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para el progreso, los anillos y los interruptores. Los avisos mantienen sus propios colores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään edistymispalkeissa, renkaissa ja kytkimissä. Hälytykset säilyttävät omat värinsä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisée pour la progression, les anneaux et les commutateurs. Les alertes gardent leurs propres couleurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משמש לפסי התקדמות, טבעות ומתגים. להתראות יש צבעים משלהן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रगति, रिंग और टॉगल के लिए। अलर्ट अपने रंग बनाए रखते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi se za napredak, prstenove i prekidače. Upozorenja zadržavaju svoje boje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folyamatjelzőkhöz, gyűrűkhöz és kapcsolókhoz. A figyelmeztetések megtartják a saját színüket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk kemajuan, cincin, dan tombol alih. Peringatan tetap memakai warnanya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato per avanzamento, anelli e interruttori. Gli avvisi mantengono i propri colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行状況、リング、スイッチに使用します。アラートは専用の色で表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 상황, 링 및 토글에 사용됩니다. 알림은 고유 색상을 유지합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk kemajuan, gelang dan suis. Isyarat mengekalkan warnanya sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes til fremdrift, ringer og brytere. Varsler beholder sine egne farger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor voortgang, ringen en schakelaars. Meldingen houden hun eigen kleuren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używany do pasków postępu, pierścieni i przełączników. Alerty zachowują własne kolory."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usada em barras de progresso, anéis e chaves. Os alertas mantêm as próprias cores."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usada no progresso, nos anéis e nos interruptores. Os alertas mantêm as suas cores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosită pentru progres, inele și comutatoare. Alertele își păstrează culorile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для прогресса, колец и переключателей. Оповещения сохраняют свои цвета."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používa sa na ukazovatele priebehu, kruhy a prepínače. Upozornenia si zachovávajú vlastné farby."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za napredek, obroče in stikala. Opozorila ohranijo svoje barve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används för förlopp, ringar och reglage. Aviseringar behåller sina egna färger."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้กับแถบความคืบหน้า วงแหวน และสวิตช์ การเตือนจะยังคงใช้สีของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlerleme, halkalar ve anahtarlar için kullanılır. Uyarılar kendi renklerini korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для прогресу, кілець і перемикачів. Оповіщення зберігають свої кольори."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng cho tiến trình, vòng và nút bật/tắt. Cảnh báo vẫn giữ màu riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于进度、圆环和开关。提醒保留各自的颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於進度、圓環和開關。提醒會保留自己的顏色。"
          }
        }
      }
    },
