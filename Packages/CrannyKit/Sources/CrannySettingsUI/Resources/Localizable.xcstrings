    "Peeks and alerts appear only on the display with the pointer." : {
      "comment" : "Settings ▸ General: footnote of Show on",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تظهر اللمحات والتنبيهات إلا على الشاشة التي عليها المؤشر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les ullades i els avisos només apareixen a la pantalla amb el punter."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahlédnutí a upozornění se zobrazují jen na monitoru s ukazatelem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smugkig og advarsler vises kun på skærmen med markøren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzansichten und Hinweise erscheinen nur auf dem Display mit dem Zeiger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι μίνι προβολές και οι ειδοποιήσεις εμφανίζονται μόνο στην οθόνη με τον δείκτη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los vistazos y los avisos solo aparecen en la pantalla con el puntero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurkistukset ja hälytykset näkyvät vain osoittimen näytöllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mini-aperçus et les alertes n’apparaissent que sur l’écran où se trouve le pointeur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצצות והתראות מופיעות רק בצג עם המצביע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिनी व्यू और अलर्ट केवल पॉइंटर वाले डिस्प्ले पर दिखते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miniprikazi i upozorenja prikazuju se samo na zaslonu s pokazivačem."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A betekintések és a figyelmeztetések csak azon a kijelzőn jelennek meg, ahol a mutató van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intipan dan peringatan hanya muncul di layar dengan penunjuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Occhiate e avvisi appaiono solo sullo schermo con il puntatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミニ表示とアラートは、ポインタがあるディスプレイにのみ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "살짝 보기와 알림은 포인터가 있는 디스플레이에만 나타납니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intaian dan isyarat hanya muncul pada paparan dengan penuding."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glimt og varsler vises bare på skjermen med pekeren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miniweergaven en meldingen verschijnen alleen op het beeldscherm met de aanwijzer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minipodglądy i alerty pojawiają się tylko na wyświetlaczu ze wskaźnikiem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espiadas e alertas aparecem só na tela com o ponteiro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As espreitadelas e os alertas só aparecem no monitor com o cursor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extinderile și alertele apar doar pe afișajul cu cursorul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мини-просмотры и оповещения появляются только на дисплее с указателем."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahliadnutia a upozornenia sa zobrazujú len na displeji s kurzorom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vpogledi in opozorila se prikažejo samo na zaslonu s kazalnikom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smygtittar och aviseringar visas bara på skärmen med pekaren."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มุมมองย่อและการเตือนจะแสดงเฉพาะบนจอภาพที่มีตัวชี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısa bakışlar ve uyarılar yalnızca imlecin olduğu ekranda görünür."
