    "Playback progress as a thin line along the lower edge of the notch." : {
      "comment" : "Settings ▸ Appearance: footnote of Progress rim",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدّم التشغيل كخط رفيع على امتداد الحافة السفلية للنتوء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El progrés de la reproducció com una línia fina a la vora inferior de l’osca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Průběh přehrávání jako tenká linka podél spodního okraje výřezu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspilningsforløb som en tynd linje langs notchens nederste kant."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabefortschritt als dünne Linie am unteren Rand der Notch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόοδος της αναπαραγωγής ως λεπτή γραμμή κατά μήκος του κάτω άκρου της εγκοπής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El progreso de la reproducción, como una línea fina en el borde inferior de la muesca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toiston edistyminen ohuena viivana loven alareunassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La progression de la lecture, en fine ligne le long du bord inférieur de l’encoche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התקדמות ההשמעה כקו דק לאורך הקצה התחתון של המגרעת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नॉच के निचले किनारे पर पतली रेखा के रूप में प्लेबैक की प्रगति।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napredak reprodukcije kao tanka crta uz donji rub izreza."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lejátszás állása vékony vonalként a kivágás alsó szélén."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemajuan pemutaran sebagai garis tipis di sepanjang tepi bawah notch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’avanzamento della riproduzione come una linea sottile lungo il bordo inferiore della tacca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生の進行状況を、ノッチの下端に沿った細い線で表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치 아래쪽 가장자리를 따라 얇은 선으로 재생 진행 상황을 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemajuan main balik sebagai garisan nipis di sepanjang pinggir bawah takuk."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avspillingsfremdrift som en tynn linje langs nederkanten av hakket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspeelvoortgang als dunne lijn langs de onderrand van de notch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postęp odtwarzania jako cienka linia wzdłuż dolnej krawędzi wycięcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O progresso da reprodução como uma linha fina na borda inferior do notch."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O progresso da reprodução como uma linha fina ao longo da margem inferior do entalhe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progresul redării ca o linie subțire de‑a lungul marginii de jos a decupajului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ход воспроизведения тонкой линией по нижнему краю выреза."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priebeh prehrávania ako tenká čiara pozdĺž dolného okraja výrezu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napredek predvajanja kot tanka črta ob spodnjem robu zareze."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppspelningsförlopp som en tunn linje längs notchens nederkant."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความคืบหน้าการเล่นเป็นเส้นบางๆ ตามขอบล่างของรอยบาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çentiğin alt kenarı boyunca ince bir çizgi hâlinde çalma ilerlemesi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перебіг відтворення тонкою лінією вздовж нижнього краю вирізу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiến trình phát hiển thị dưới dạng một đường mảnh dọc mép dưới tai thỏ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿刘海下边缘以细线显示播放进度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿瀏海下緣以細線顯示播放進度。"
          }
        }
      }
    },
    "Plays this preview on your notch for 5 seconds." : {
      "comment" : "Settings preview stage: tooltip of Show on Notch",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
