    "You can add up to three pages." : {
      "comment" : "Settings ▸ Layout & Widgets: the page limit is reached",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك إضافة ثلاث صفحات كحد أقصى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pots afegir fins a tres pàgines."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Můžete přidat nejvýše tři stránky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan tilføje op til tre sider."
          }
        },
