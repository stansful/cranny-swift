    "On displays without a notch" : {
      "comment" : "Settings ▸ Appearance: picker Floating island / Attached / Off",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على شاشات العرض بلا نتوء"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A les pantalles sense osca"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na monitorech bez výřezu"
          }
        },
        "da" : {
          "stringUnit" : {
