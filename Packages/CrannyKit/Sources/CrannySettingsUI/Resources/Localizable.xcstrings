    "A soft pop when a file is caught and a tink when a to-do is done." : {
      "comment" : "Settings ▸ General: footnote of UI sounds",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صوت فرقعة خفيف عند التقاط ملف، ورنين عند إنجاز مهمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un so suau quan s’atrapa un arxiu i un dring quan es completa una tasca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemné cvaknutí, když se zachytí soubor, a cinknutí, když je úkol hotový."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et blødt plop, når en fil bliver grebet, og et kling, når en opgave er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein sanftes Ploppen, wenn eine Datei abgelegt wird, und ein heller Klang, wenn eine Aufgabe erledigt ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα απαλό «ποπ» όταν πιάνεται ένα αρχείο και ένα «τιν» όταν ολοκληρώνεται μια εργασία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un “pop” suave al atrapar un archivo y un “tin” al completar una tarea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pehmeä poksahdus, kun tiedosto napataan, ja kilahdus, kun tehtävä on tehty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un léger « pop » quand un fichier est déposé et un « ting » quand une tâche est terminée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צליל ״פופ״ רך כשקובץ נתפס, וצלצול קצר כשמשימה מסומנת כבוצעה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइल पकड़े जाने पर हल्की “पॉप” ध्वनि और कार्य पूरा होने पर “टिंक” ध्वनि।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tihi klik kad se datoteka uhvati i kratko zvonce kad je zadatak obavljen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halk pukkanás, amikor a Cranny elkap egy fájlt, és csilingelés, amikor kész egy teendő."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunyi pop lembut saat file ditangkap dan denting saat tugas selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un leggero “pop” quando rilasci un file e un tintinnio quando completi una cosa da fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルを受け取ったときにポンという音、ToDoが完了したときにチンという音が鳴ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치에 파일을 놓으면 부드러운 퐁 소리가, 할 일을 완료하면 팅 소리가 납니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunyi pop lembut apabila fail ditangkap dan bunyi ting apabila tugasan selesai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et mykt plopp når en fil fanges opp, og et pling når et gjøremål er utført."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een zachte plop als een bestand wordt opgevangen, en een ting als een taak af is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciche pyknięcie, gdy plik zostanie złapany, i brzdęk, gdy zadanie zostanie wykonane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um estalo suave quando um arquivo é capturado e um tilintar quando uma tarefa é concluída."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um som suave quando um ficheiro é apanhado e um tilintar quando uma tarefa fica concluída."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pocnet discret când un fișier este prins și un clinchet când o sarcină este bifată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мягкий щелчок, когда файл пойман, и звон, когда задача выполнена."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemné cvaknutie pri zachytení súboru a cinknutie pri dokončení úlohy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehak pok, ko je datoteka ujeta, in zvonček, ko končate opravilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett mjukt ”plopp” när en fil fångas och ett ”pling” när en uppgift är klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียง “ป๊อป” เบาๆ เมื่อรับไฟล์ และเสียง “ติ๊ง” เมื่อทำสิ่งที่ต้องทำเสร็จ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir dosya yakalandığında yumuşak bir “pop”, bir görev bitince bir “çın” sesi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мʼякий звук, коли файл спіймано, і дзенькіт, коли справу виконано."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một tiếng bụp nhẹ khi nhận tệp và tiếng ting khi hoàn thành một việc cần làm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接住文件时发出轻柔的“啵”声，完成待办事项时发出“叮”声。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接住檔案時發出輕柔的「啵」聲，完成待辦事項時發出「叮」聲。"
          }
        }
      }
    },
