    "To finish, allow Cranny under Login Items in System Settings." : {
      "comment" : "Settings ▸ General: footnote while the login item waits for approval",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لإكمال الإعداد، اسمح لـ Cranny في \"عناصر تسجيل الدخول\" في إعدادات النظام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per acabar, permet el Cranny a “Ítems d’inici de sessió” a la configuració del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro dokončení povolte Cranny v Nastavení systému mezi položkami přihlášení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til sidst skal du tillade Cranny under Loginemner i Systemindstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube zum Abschluss Cranny in den Systemeinstellungen unter „Anmeldeobjekte“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να ολοκληρωθεί η ρύθμιση, επιτρέψτε το Cranny στα «Στοιχεία εισόδου» στις Ρυθμίσεις συστήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para terminar, autoriza a Cranny en “Ítems de inicio”, en Ajustes del Sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimeistele sallimalla Cranny Järjestelmäasetusten Kirjautumiskohteet-osiossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour terminer, autorisez Cranny sous « Ouverture et extensions » dans Réglages Système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לסיים, יש לאשר את Cranny ב״פריטי התחברות״ ב״הגדרות המערכת״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरा करने के लिए सिस्टम सेटिंग में लॉगइन आइटम के अंतर्गत Cranny को अनुमति दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za dovršetak dozvolite Cranny u odjeljku Stavke za prijavu u Postavkama sustava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A befejezéshez engedélyezze a Crannyt a Rendszerbeállítások Indítóelemek részében."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menyelesaikan, izinkan Cranny di Item Masuk pada Pengaturan Sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per completare, autorizza Cranny nella sezione “Elementi login” di Impostazioni di Sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了するには、“システム設定”の“ログイン項目”でCrannyを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완료하려면 시스템 설정의 ‘로그인 항목’에서 Cranny를 허용하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menyelesaikannya, benarkan Cranny di bawah Item Log Masuk dalam Seting Sistem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å fullføre må du tillate Cranny under Påloggingsobjekter i Systeminnstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Cranny toe bij ‘Inlogonderdelen en extensies’ in Systeeminstellingen om dit af te ronden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby dokończyć, włącz Cranny w sekcji „Rzeczy otwierane podczas logowania” w Ustawieniach systemowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para concluir, permita o Cranny em Itens de Início, nos Ajustes do Sistema."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para concluir, permita o Cranny em Definições do Sistema ▸ Geral ▸ Início de sessão e extensões."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a finaliza, permiteți Cranny în „Lansare la login” din Configurări sistem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы закончить, разрешите Cranny в разделе «Объекты входа» в Системных настройках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete nastavenie dokončiť, povoľte Cranny v Systémových nastaveniach v časti Položky a rozšírenia spúšťané pri prihlásení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za dokončanje vklopite Cranny v razdelku »Elementi prijave« v Nastavitvah sistema."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slutför genom att tillåta Cranny under Startobjekt i Systeminställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการตั้งค่าให้เสร็จ ให้อนุญาต Cranny ใน “รายการเข้าสู่ระบบ” ในการตั้งค่าระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitirmek için Sistem Ayarları’ndaki Oturum Açma Öğeleri bölümünde Cranny’ye izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб завершити, дозвольте Cranny в розділі «Автозапуск» у Системних параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để hoàn tất, hãy cho phép Cranny trong “Mục đăng nhập” ở Cài đặt hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要完成设置，请在“系统设置”的“登录项”中允许Cranny。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要完成，請在「系統設定」的「登入項目」中允許Cranny。"
