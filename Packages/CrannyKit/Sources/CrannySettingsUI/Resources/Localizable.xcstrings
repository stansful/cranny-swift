    "Asks GitHub for new releases once a day. Nothing is downloaded or installed." : {
      "comment" : "Settings ▸ General: footnote of Check for updates daily",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحقق Cranny مرة يوميًا من وجود إصدارات جديدة على GitHub. لا يتم تنزيل أي شيء أو تثبيته."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta al GitHub un cop al dia si hi ha versions noves. No es descarrega ni s’instal·la res."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednou denně se zeptá GitHubu na nové verze. Nic se nestahuje ani neinstaluje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørger GitHub om nye udgivelser én gang om dagen. Intet bliver hentet eller installeret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt GitHub einmal täglich nach neuen Versionen. Es wird nichts heruntergeladen oder installiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρωτά το GitHub για νέες εκδόσεις μία φορά την ημέρα. Τίποτα δεν λαμβάνεται ούτε εγκαθίσταται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta GitHub una vez al día para ver si hay versiones nuevas. No se descarga ni se instala nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkistaa GitHubista kerran päivässä, onko uusia julkaisuja. Mitään ei ladata eikä asenneta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande à GitHub une fois par jour s’il existe une nouvelle version. Rien n’est téléchargé ni installé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בודק ב-GitHub פעם ביום אם יש גירסאות חדשות. שום דבר לא מורד ולא מותקן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिन में एक बार GitHub से नई रिलीज़ के बारे में पूछता है। कुछ भी डाउनलोड या इंस्टॉल नहीं होता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednom dnevno pita GitHub ima li novih izdanja. Ništa se ne preuzima niti instalira."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naponta egyszer megnézi a GitHubon, van-e új kiadás. Semmit sem tölt le és nem telepít."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memeriksa rilis baru di GitHub sekali sehari. Tidak ada yang diunduh atau diinstal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede a GitHub una volta al giorno se ci sono nuove versioni. Non viene scaricato né installato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日に1回、GitHubで新しいリリースを確認します。ダウンロードやインストールは行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루에 한 번 GitHub에서 새로운 릴리즈를 확인합니다. 아무것도 다운로드하거나 설치하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bertanya kepada GitHub tentang keluaran baharu sekali sehari. Tiada apa-apa yang dimuat turun atau dipasang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør GitHub om nye utgivelser én gang om dagen. Ingenting lastes ned eller installeres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraagt GitHub één keer per dag naar nieuwe releases. Er wordt niets gedownload of geïnstalleerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raz dziennie sprawdza w serwisie GitHub, czy są nowe wydania. Nic nie jest pobierane ani instalowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta o GitHub uma vez por dia em busca de novas versões. Nada é baixado nem instalado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta o GitHub uma vez por dia para ver se há novas versões. Nada é descarregado nem instalado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifică o dată pe zi pe GitHub dacă există versiuni noi. Nu se descarcă și nu se instalează nimic."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раз в день спрашивает GitHub о новых версиях. Ничего не загружается и не устанавливается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raz denne sa opýta GitHubu na nové vydania. Nič sa nesťahuje ani neinštaluje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkrat na dan pri GitHubu preveri, ali so na voljo nove izdaje. Nič se ne prenese ali namesti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frågar GitHub efter nya versioner en gång om dagen. Inget hämtas eller installeras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจหารุ่นใหม่จาก GitHub วันละครั้ง โดยไม่ดาวน์โหลดหรือติดตั้งสิ่งใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde bir kez GitHub’a yeni sürüm olup olmadığını sorar. Hiçbir şey indirilmez veya yüklenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раз на день перевіряє на GitHub, чи є нові версії. Нічого не завантажується й не встановлюється."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỏi GitHub về bản phát hành mới mỗi ngày một lần. Không tải về hay cài đặt gì cả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天向GitHub查询一次新版本，不会下载或安装任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天向GitHub查詢一次新版本。不會下載或安裝任何內容。"
          }
        }
      }
    },
