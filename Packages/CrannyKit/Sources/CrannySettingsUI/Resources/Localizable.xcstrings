    "Showed how to replace the system volume overlay so only one is ever shown." : {
      "comment" : "Settings ▸ About ▸ Acknowledgements: what Cranny learned from volumeHUD",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوضح كيفية استبدال مؤشر مستوى الصوت في النظام بحيث لا يظهر سوى مؤشر واحد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va mostrar com substituir l’indicador de volum del sistema perquè només se’n vegi un."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukázal, jak nahradit systémový indikátor hlasitosti tak, aby byl vždy zobrazený jen jeden."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viste, hvordan systemets lydstyrkeindikator kan erstattes, så der altid kun vises én."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat gezeigt, wie man das Lautstärke-Overlay des Systems ersetzt, sodass immer nur eines erscheint."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έδειξε πώς να αντικατασταθεί η ένδειξη έντασης του συστήματος ώστε να εμφανίζεται πάντα μόνο μία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostró cómo sustituir el indicador de volumen del sistema para que solo se vea uno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytti, miten järjestelmän äänenvoimakkuuden ilmaisin korvataan niin, ettei niitä koskaan näy kahta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A montré comment remplacer l’indicateur de volume du système pour qu’il n’y en ait jamais qu’un seul à l’écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הראה איך להחליף את מחוון עוצמת הקול של המערכת כך שתמיד יוצג רק אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिखाया कि सिस्टम के वॉल्यूम ओवरले को कैसे बदला जाए, ताकि हमेशा केवल एक ही दिखे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazao je kako zamijeniti indikator glasnoće sustava tako da se uvijek prikazuje samo jedan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megmutatta, hogyan cserélhető le a rendszer hangerőjelzője úgy, hogy mindig csak egy látszódjon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunjukkan cara mengganti indikator volume sistem sehingga hanya satu indikator yang tampil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha mostrato come sostituire l’indicatore del volume di sistema in modo che ne appaia sempre uno solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムの音量表示を置き換えて、常に1つだけ表示されるようにする方法を示してくれました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 음량 오버레이를 대체하여 항상 하나만 표시되게 하는 방법을 알려주었습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunjukkan cara menggantikan tindihan kelantangan sistem supaya hanya satu yang ditunjukkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viste hvordan systemets volumindikator kan erstattes, slik at bare én vises om gangen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liet zien hoe je de volume-indicator van het systeem vervangt, zodat er altijd maar één verschijnt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazał, jak zastąpić systemową nakładkę głośności, aby zawsze była widoczna tylko jedna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrou como substituir o indicador de volume do sistema para que apenas um apareça."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrou como substituir o indicador de volume do sistema para que só apareça um."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A arătat cum poate fi înlocuit indicatorul de volum al sistemului, astfel încât să fie afișat mereu unul singur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показал, как заменить системный индикатор громкости, чтобы на экране всегда был только один."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukázal, ako nahradiť systémový indikátor hlasitosti, aby sa vždy zobrazoval len jeden."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazal je, kako zamenjati sistemski prikaz glasnosti, da je na zaslonu vedno samo eden."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visade hur systemets volymindikator kan ersättas så att bara en visas åt gången."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงวิธีแทนที่ตัวแสดงระดับเสียงของระบบ เพื่อให้มีตัวแสดงเพียงตัวเดียวเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistemin ses yüksekliği göstergesinin, ekranda hep tek gösterge kalacak biçimde nasıl değiştirileceğini gösterdi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показав, як замінити системний індикатор гучності, щоб на екрані завжди був лише один."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã cho thấy cách thay thế chỉ báo âm lượng của hệ thống để luôn chỉ có một chỉ báo hiển thị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展示了如何替换系统音量浮层，确保屏幕上始终只显示一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "示範如何取代系統的音量指示器，讓畫面上始終只顯示一個。"
          }
        }
