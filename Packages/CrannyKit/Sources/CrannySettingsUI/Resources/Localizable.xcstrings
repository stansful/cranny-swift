          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näet liveseurannan tiedot pitämällä osoitinta sen päällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez le pointeur sur une activité pour en voir les détails."
