    "The open panel lets the desktop show through below the menu bar. Off with Reduce Transparency." : {
      "comment" : "Settings ▸ Appearance: footnote of Translucent background",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر سطح المكتب من خلال اللوحة المفتوحة أسفل شريط القوائم. يتوقف عند تشغيل \"تقليل الشفافية\"."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El panell obert deixa veure l’escriptori per sota de la barra de menús. Es desactiva amb “Redueix la transparència”."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřeným panelem pod řádkem nabídek prosvítá plocha. Při zapnuté volbě Snížit průhlednost se vypne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det åbne panel lader skrivebordet skinne igennem under menulinjen. Slås fra med “Formindsk gennemsigtighed”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das geöffnete Panel lässt den Schreibtisch unter der Menüleiste durchscheinen. Aus bei „Transparenz reduzieren“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ανοιχτό πάνελ αφήνει να φαίνεται το γραφείο εργασίας κάτω από τη γραμμή μενού. Απενεργοποιείται με τη «Μείωση διαφάνειας»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El panel abierto deja ver el escritorio por debajo de la barra de menús. Se desactiva con “Reducir transparencia”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoimen paneelin läpi näkyy työpöytä valikkorivin alapuolella. Pois päältä, kun ”Vähennä läpinäkyvyyttä” on käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le panneau ouvert laisse transparaître le bureau sous la barre des menus. Désactivé avec « Réduire la transparence »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המכתבה נראית דרך החלונית הפתוחה מתחת לשורת התפריטים. האפקט כבוי כש״הפחתת השקיפות״ פעילה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खुले पैनल से मेन्यू बार के नीचे डेस्कटॉप झलकता है। “पारदर्शिता घटाएँ” चालू होने पर बंद रहता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroz otvorenu ploču ispod trake s izbornicima vidi se radna površina. Isključuje se kad je uključeno “Smanji prozirnost”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megnyitott panelen a menüsor alatt átlátszik az íróasztal. Az „Átlátszóság csökkentése” bekapcsolásakor kikapcsol."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel yang terbuka memperlihatkan desktop di bawah bar menu. Mati jika “Kurangi transparansi” menyala."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pannello aperto lascia intravedere la scrivania sotto la barra dei menu. Disattivato con “Riduci la trasparenza”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開いたパネルを通して、メニューバーの下のデスクトップが透けて見えます。“透明度を下げる”がオンのときはオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열린 패널을 통해 메뉴 막대 아래의 데스크탑이 비쳐 보입니다. ‘투명도 줄이기’가 켜져 있으면 꺼집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel yang terbuka membolehkan desktop kelihatan di bawah bar menu. Dimatikan apabila “Kurangkan kelutsinaran” diaktifkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det åpne panelet lar skrivebordet skinne gjennom under menylinjen. Slås av med «Reduser gjennomsiktighet»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onder de menubalk schemert het bureaublad door het open paneel heen. Uit als ‘Verminder doorzichtigheid’ is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przez otwarty panel pod paskiem menu prześwituje biurko. Wyłączone, gdy włączona jest opcja „Zmniejsz przezroczystość”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O painel aberto deixa a mesa aparecer abaixo da barra de menus. Desativado com Reduzir transparência."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O painel aberto deixa ver a secretária por baixo da barra de menus. Desativado com “Reduzir transparência”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panoul deschis lasă desktopul să se vadă sub bara de meniu. Dezactivat când este activată opțiunea „Reducere transparență”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сквозь открытую панель ниже строки меню виден рабочий стол. Отключается, если включено «Понизить прозрачность»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cez otvorený panel pod lištou presvitá plocha. Vypnuté pri zapnutej funkcii Obmedziť priehľadnosť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod menijsko vrstico se skozi odprto ploščo vidi namizje. Izklopljeno, ko je vklopljena možnost »Zmanjšaj prosojnost«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den öppna panelen låter skrivbordet lysa igenom under menyraden. Stängs av när ”Minska genomskinlighet” är på."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แผงที่เปิดอยู่จะให้มองเห็นเดสก์ท็อปผ่านได้ใต้แถบเมนู ปิดอยู่เมื่อเปิด “ลดความโปร่งใส”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık panel, menü çubuğunun altında masaüstünün görünmesine izin verir. “Saydamlığı azalt” açıkken kapalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крізь відкриту панель під смугою меню видно робочий стіл. Вимикається, якщо ввімкнено «Зменшення прозорості»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảng đang mở cho phép màn hình nền hiện qua bên dưới thanh menu. Tắt khi bật “Giảm độ trong suốt”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开的面板会透出菜单栏下方的桌面。打开“降低透明度”时此项不起作用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開的面板會在選單列下方透出桌面。開啟「減少透明度」時會關閉此效果。"
          }
        }
      }
    },
    "The tutorial runs on the real notch and takes about a minute." : {
      "comment" : "Settings ▸ About: footnote of Getting started",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل البرنامج التعليمي على النتوء الحقيقي ويستغرق نحو دقيقة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tutorial es fa a l’osca real i dura aproximadament un minut."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurz probíhá na skutečném výřezu a trvá asi minutu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduktionen kører på den rigtige notch og tager omkring et minut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einführung läuft auf der echten Notch und dauert etwa eine Minute."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εκμάθηση γίνεται στην πραγματική εγκοπή και διαρκεί περίπου ένα λεπτό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tutorial se hace en la muesca real y dura un minuto aproximadamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opastus toimii oikeassa lovessa ja kestää noin minuutin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tutoriel se déroule sur la vraie encoche et dure environ une minute."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההדרכה מתבצעת על המגרעת האמיתית ונמשכת כדקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
