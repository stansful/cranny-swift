    "Click, then press the new keys. Esc cancels, Delete turns the shortcut off." : {
      "comment" : "Settings ▸ Keyboard: tooltip of a shortcut recorder",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر، ثم اضغط على المفاتيح الجديدة. Esc للإلغاء، و Delete لإيقاف الاختصار."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes clic i prem les tecles noves. Esc cancel·la; la tecla de supressió desactiva la drecera."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikněte a stiskněte nové klávesy. Esc akci zruší, Delete zkratku vypne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik, og tryk derefter på de nye taster. Esc annullerer, Slettetasten slår tastaturgenvejen fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke und drücke dann die neuen Tasten. Esc bricht ab, die Rückschritttaste deaktiviert die Tastenkombination."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε κλικ και πατήστε τα νέα πλήκτρα. Το Esc ακυρώνει, το Delete απενεργοποιεί τη συντόμευση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic y pulsa las nuevas teclas. Esc cancela y Suprimir desactiva el atajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikkaa ja paina uusia näppäimiä. Esc kumoaa, Delete poistaa oikotien käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez, puis appuyez sur les nouvelles touches. Échap annule, Supprimer désactive le raccourci."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש ללחוץ ואז להקיש על המקשים החדשים. Esc מבטל, ו-Delete מכבה את קיצור המקלדת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्लिक करें, फिर नई कीज़ दबाएँ। Esc से रद्द होता है, Delete से शॉर्टकट बंद होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknite pa pritisnite nove tipke. Esc poništava, a Delete isključuje prečac."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kattintson, majd nyomja le az új billentyűket. Az Esc megszakítja, a Delete kikapcsolja a billentyűparancsot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik, lalu tekan tombol baru. Esc membatalkan, Delete mematikan pintasan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic, poi premi i nuovi tasti. Esc annulla, Elimina disattiva la scorciatoia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックしてから新しいキーを押します。Escでキャンセル、Deleteでショートカットをオフにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭한 다음 새 키를 누르십시오. Esc 키를 누르면 취소되고, Delete 키를 누르면 단축키가 꺼집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik, kemudian tekan kekunci baharu. Esc membatalkan, Delete mematikan pintasan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikk og trykk så de nye tastene. Esc avbryter, slettetasten slår av tastatursnarveien."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik en druk dan op de nieuwe toetsen. Esc annuleert, Delete schakelt de toetscombinatie uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij, a następnie naciśnij nowe klawisze. Esc anuluje, Delete wyłącza skrót."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique e pressione as novas teclas. Esc cancela, Delete desativa o atalho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique e prima as novas teclas. Esc cancela, Delete desativa o atalho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faceți clic, apoi apăsați noile taste. Esc anulează, Delete dezactivează scurtătura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и введите новое сочетание клавиш. Esc — отмена, Delete — выключить сочетание."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknite a stlačte nové klávesy. Esc zruší zmenu, Delete skratku vypne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknite in pritisnite nove tipke. Esc prekliče, Delete izklopi bližnjico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
