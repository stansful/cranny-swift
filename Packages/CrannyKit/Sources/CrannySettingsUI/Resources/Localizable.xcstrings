        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להשאיר את המצביע על פעילות כדי לראות את הפרטים שלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विवरण देखने के लिए किसी ऐक्टिविटी पर पॉइंटर रखें।"
