{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is also set for %@." : {
      "comment" : "Settings ▸ Keyboard: two Cranny shortcuts share keys; arguments are the keys and the other shortcut's name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is also set for %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ уже назначено для «%2$@»."
          }
        }
      }
    },
    "%@ left" : {
      "comment" : "Settings preview stage: time left on the sample timer (peek row)",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "осталось %@"
          }
        }
      }
    },
    "%@ pt" : {
      "comment" : "Settings: a length in typographic points with its sign, e.g. \"+2 pt\" (Notch fit, panel padding)",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ пт"
          }
        }
      }
    },
    "%@ · %@" : {
      "comment" : "Settings ▸ Layout & Widgets: a widget's description and the widths it allows, on one line",
