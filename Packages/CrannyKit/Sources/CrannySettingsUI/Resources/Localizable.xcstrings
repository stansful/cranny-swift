    "Studied for techniques only. Cranny includes no third-party code." : {
      "comment" : "Settings ▸ About ▸ Acknowledgements: footer",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دُرست لمعرفة التقنيات فقط. لا يتضمن Cranny أي تعليمات برمجية من جهات خارجية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només s’han estudiat per aprendre’n les tècniques. El Cranny no inclou codi de tercers."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekty posloužily jen ke studiu postupů. Cranny neobsahuje žádný kód třetích stran."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun studeret for at lære teknikker. Cranny indeholder ingen kode fra tredjeparter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ihre Techniken wurden studiert. Cranny enthält keinen Code von Drittanbietern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μελετήθηκαν μόνο για τις τεχνικές τους. Το Cranny δεν περιλαμβάνει κώδικα τρίτων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estudiados solo por sus técnicas. Cranny no incluye código de terceros."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niistä on tutkittu vain tekniikoita. Cranny ei sisällä kolmannen osapuolen koodia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étudiés uniquement pour leurs techniques. Cranny ne contient aucun code tiers."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נבחנו רק לשם הבנת הטכניקות. Cranny אינו כולל קוד של צד שלישי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल तकनीकों के लिए अध्ययन किया गया। Cranny में किसी तीसरे पक्ष का कोड नहीं है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proučeni su samo zbog tehničkih rješenja. Cranny ne sadrži kôd trećih strana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a módszereiket tanulmányoztuk. A Cranny nem tartalmaz harmadik féltől származó kódot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya dipelajari tekniknya. Cranny tidak menyertakan kode pihak ketiga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studiati solo per le tecniche. Cranny non include codice di terze parti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参考にしたのは手法のみです。Crannyにサードパーティのコードは含まれていません。"
          }
