    "Activities beside the notch step aside when the pointer heads for menu bar items next to them." : {
      "comment" : "Settings ▸ Live Activities: footnote of Make way for the menu bar",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتنحّى الأنشطة الموجودة بجانب النتوء عندما يتجه المؤشر نحو عناصر شريط القوائم المجاورة لها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les activitats que hi ha al costat de l’osca s’aparten quan el punter s’acosta als ítems de la barra de menús que tenen a prop."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivity vedle výřezu uhnou, když se ukazatel blíží k sousedním položkám řádku nabídek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviteter ved siden af notchen viger til side, når markøren bevæger sig mod menulinjeemner ved siden af dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivitäten neben der Notch weichen aus, wenn sich der Zeiger benachbarten Objekten der Menüleiste nähert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι δραστηριότητες δίπλα στην εγκοπή παραμερίζουν όταν ο δείκτης κατευθύνεται προς γειτονικά στοιχεία της γραμμής μενού."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actividades junto a la muesca se apartan cuando el puntero se dirige a los ítems de la barra de menús que tienen al lado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loven vieressä olevat liveseurannat väistyvät, kun osoitin on matkalla niiden vieressä oleviin valikkorivin kohteisiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les activités à côté de l’encoche s’effacent quand le pointeur se dirige vers les éléments voisins de la barre des menus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעילויות לצד המגרעת זזות הצידה כשהמצביע מתקרב לפריטים שלידן בשורת התפריטים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब पॉइंटर पास के मेन्यू बार आइटम की ओर बढ़ता है, तो नॉच के पास की ऐक्टिविटी रास्ता दे देती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivnosti pokraj izreza sklanjaju se kad se pokazivač kreće prema susjednim stavkama trake s izbornicima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kivágás melletti tevékenységek félrehúzódnak, amikor a mutató a mellettük lévő menüsorelemek felé tart."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivitas di samping notch menyingkir saat penunjuk menuju item bar menu di dekatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le attività accanto alla tacca si scostano quando il puntatore si dirige verso le voci vicine della barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポインタがノッチの隣のメニューバー項目に向かうと、ノッチの横のアクティビティが場所を空けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포인터가 옆에 있는 메뉴 막대 항목으로 향하면 노치 옆의 실시간 현황이 자리를 비켜 줍니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviti di sebelah takuk memberi laluan apabila penuding menuju ke item bar menu di sebelahnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviteter ved hakket viker unna når pekeren går mot menylinjeobjektene ved siden av dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activiteiten naast de notch maken plaats als de aanwijzer naar menubalkonderdelen ernaast beweegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywności obok wycięcia ustępują miejsca, gdy wskaźnik zmierza w stronę sąsiednich elementów paska menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As atividades ao lado do notch abrem espaço quando o ponteiro se aproxima dos itens vizinhos da barra de menus."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As atividades ao lado do entalhe afastam‑se quando o cursor se dirige aos elementos da barra de menus junto a elas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activitățile de lângă decupaj se dau la o parte când cursorul se îndreaptă spre elementele din bara de meniu de lângă ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активности у выреза уступают место, когда указатель направляется к соседним пунктам строки меню."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivity vedľa výrezu ustúpia, keď kurzor smeruje k susedným položkám v lište."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivnosti ob zarezi se umaknejo, ko se kazalnik približa sosednjim elementom menijske vrstice."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviteter bredvid notchen viker undan när pekaren rör sig mot menyradsobjekt intill dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กิจกรรมสดข้างรอยบากจะหลบให้เมื่อตัวชี้เคลื่อนไปยังรายการในแถบเมนูที่อยู่ติดกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmleç yanlarındaki menü çubuğu öğelerine yöneldiğinde çentiğin yanındaki canlı etkinlikler kenara çekilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дії наживо біля вирізу відступають, коли вказівник прямує до сусідніх пунктів смуги меню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các hoạt động cạnh tai thỏ sẽ tránh sang bên khi con trỏ hướng tới các mục thanh menu bên cạnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当指针移向旁边的菜单栏项目时，刘海旁的活动会让开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當指標移向旁邊的選單列項目時，瀏海旁的即時動態會讓開。"
          }
        }
      }
    },
