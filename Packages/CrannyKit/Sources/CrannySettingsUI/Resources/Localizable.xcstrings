          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงให้เห็นว่ายังคงอ่าน “กำลังเล่นอยู่” ได้จากตัวช่วยที่ทำงานใน Perl ของระบบ"
