          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η δραστηριότητα επιστρέφει στην εγκοπή, ενώ ο δορυφόρος παραμένει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
