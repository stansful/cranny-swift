          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palauttaa liveseurannan loveen; satelliitti jää näkyviin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replie l’activité dans l’encoche ; le satellite reste affiché."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעילות מתקפלת חזרה אל המגרעת; הלוויין נשאר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐक्टिविटी को वापस नॉच में समेट देता है; सैटेलाइट बना रहता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraća aktivnost u izrez; satelit ostaje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tevékenység visszahúzódik a kivágásba; a kísérő marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivitas diciutkan kembali ke notch; satelit tetap tampil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riporta l’attività nella tacca; il satellite resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティビティをノッチに格納します。サテライトはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 현황이 노치 안으로 다시 접히며, 위성은 그대로 남습니다."
          }
        },
        "ms" : {
