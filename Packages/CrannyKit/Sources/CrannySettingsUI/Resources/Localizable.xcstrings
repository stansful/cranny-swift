    "Liquid Glass for the floating island on displays without a notch." : {
      "comment" : "Settings ▸ Appearance: footnote of Glass island",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام Liquid Glass للجزيرة العائمة على شاشات العرض بلا نتوء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass per a l’illa flotant a les pantalles sense osca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass pro plovoucí ostrov na monitorech bez výřezu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass til den svævende ø på skærme uden notch."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass für die schwebende Insel auf Displays ohne Notch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass για το αιωρούμενο νησί σε οθόνες χωρίς εγκοπή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass para la isla flotante en pantallas sin muesca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass kelluvalle saarelle näytöillä, joissa ei ole lovea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass pour l’îlot flottant sur les écrans sans encoche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עיצוב Liquid Glass לאי הצף בצגים ללא מגרעת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना नॉच वाले डिस्प्ले पर फ़्लोटिंग आइलैंड के लिए Liquid Glass।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass za plutajući otok na zaslonima bez izreza."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass a lebegő szigethez a kivágás nélküli kijelzőkön."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass untuk pulau mengambang di layar tanpa notch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass per l’isola fluttuante sugli schermi senza tacca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチのないディスプレイのフローティングアイランドにLiquid Glassを使用します。"
