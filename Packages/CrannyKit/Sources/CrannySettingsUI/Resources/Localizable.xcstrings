          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφήστε τον δείκτη πάνω σε μια δραστηριότητα για να δείτε λεπτομέρειες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
