    "Fine-tunes the space around the widgets. Corners stay concentric." : {
      "comment" : "Settings ▸ Appearance: footnote of Panel padding",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضبط المساحة حول الأدوات بدقة. تبقى الزوايا متحدة المركز."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta l’espai al voltant dels ginys. Les cantonades es mantenen concèntriques."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemně doladí prostor kolem widgetů. Rohy zůstávají soustředné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finjusterer afstanden omkring widgets. Hjørnerne forbliver koncentriske."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt den Abstand um die Widgets fein an. Die Ecken bleiben konzentrisch."
