        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El color de l’àlbum mentre sona música; si no, el color de contrast del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva alba, když hraje hudba, jinak systémový akcent."
