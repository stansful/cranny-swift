    "Cranny is off on this display." : {
      "comment" : "Settings preview stage: Cranny is turned off on the previewed display",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إيقاف Cranny على هذه الشاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Cranny està desactivat en aquesta pantalla."
          }
        },
