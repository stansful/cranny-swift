        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boja albuma dok svira glazba, inače boja naglašavanja sustava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zenelejátszás közben az album színe, egyébként a rendszer kiemelőszíne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna album saat musik diputar; jika tidak, warna aksen sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
