    "No feature has asked for a permission." : {
      "comment" : "Settings ▸ Permissions: no module declared a permission",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تطلب أي ميزة إذنًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap funció ha demanat permisos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádná funkce zatím nežádala o oprávnění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen funktion har bedt om en tilladelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Funktion hat eine Berechtigung angefragt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καμία λειτουργία δεν έχει ζητήσει άδεια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna función ha pedido permisos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikään ominaisuus ei ole pyytänyt lupaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune fonction n’a demandé d’autorisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אף תכונה לא ביקשה הרשאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी फ़ीचर ने अनुमति नहीं माँगी है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nijedna značajka nije zatražila dozvolu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még egyik funkció sem kért engedélyt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada fitur yang meminta izin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna funzione ha richiesto autorizzazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセス許可を求めている機能はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
