    "Cranny waits a moment before closing, and never closes while you type or drag." : {
      "comment" : "Settings ▸ General: footnote of Close when the pointer leaves",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينتظر Cranny لحظة قبل الإغلاق، ولا يُغلق أبدًا أثناء الكتابة أو السحب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Cranny espera un moment abans de tancar‑se i no es tanca mai mentre escrius o arrossegues."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny se zavře až po chvilce a nikdy ne, když píšete nebo něco přetahujete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny venter et øjeblik, før den lukker, og lukker aldrig, mens du skriver eller trækker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny wartet kurz vor dem Schließen und schließt nie, während du tippst oder etwas ziehst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Cranny περιμένει λίγο πριν κλείσει και δεν κλείνει ποτέ όσο πληκτρολογείτε ή σύρετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny espera un momento antes de cerrarse y nunca se cierra mientras escribes o arrastras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny odottaa hetken ennen sulkeutumista eikä koskaan sulkeudu, kun kirjoitat tai vedät jotakin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny attend un instant avant de se fermer, et ne se ferme jamais pendant que vous écrivez ou faites glisser un élément."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לפני הסגירה Cranny ממתין רגע, ולעולם אינו נסגר בזמן הקלדה או גרירה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny बंद होने से पहले थोड़ा रुकता है, और जब आप टाइप या ड्रैग कर रहे हों, तब कभी बंद नहीं होता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny pričeka trenutak prije zatvaranja i nikad se ne zatvara dok tipkate ili povlačite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Cranny bezárás előtt vár egy kicsit, és sosem zárul be, amíg gépel vagy húz valamit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny menunggu sebentar sebelum tertutup, dan tidak pernah tertutup saat Anda mengetik atau menyeret."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny attende un momento prima di chiudersi e non si chiude mai mentre digiti o trascini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crannyは少し待ってから閉じます。入力中やドラッグ中に閉じることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny는 잠시 기다린 후 닫히며, 입력하거나 드래그하는 동안에는 닫히지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny menunggu seketika sebelum ditutup, dan tidak sekali-kali ditutup semasa anda menaip atau menyeret."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny venter litt før den lukkes, og lukkes aldri mens du skriver eller drar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny wacht even voordat het sluit, en sluit nooit terwijl je typt of sleept."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny zamyka się z lekkim opóźnieniem i nigdy nie robi tego podczas pisania ani przeciągania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cranny espera um momento antes de fechar e nunca fecha enquanto você digita ou arrasta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cranny espera um momento antes de fechar e nunca fecha enquanto escreve ou arrasta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny așteaptă puțin înainte să se închidă și nu se închide niciodată cât timp tastați sau trageți ceva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny закрывается не сразу и не закроется, пока вы печатаете или перетаскиваете."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny sa zatvára s malým oneskorením a nikdy nie počas písania alebo ťahania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny se zapre z rahlim zamikom in se nikoli ne zapre med tipkanjem ali vlečenjem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny väntar en stund innan den stängs och stängs aldrig medan du skriver eller drar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny จะรอสักครู่ก่อนปิด และจะไม่ปิดขณะที่คุณพิมพ์หรือลาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny kapanmadan önce kısa bir süre bekler ve siz yazarken veya sürüklerken hiçbir zaman kapanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny закривається не одразу й не закриється, поки ви набираєте текст або щось перетягуєте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny đợi một lát rồi mới đóng và không bao giờ đóng khi bạn đang nhập hoặc kéo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny会稍候片刻再关闭，在你输入或拖移时绝不会关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny會稍待片刻再關閉，且在你輸入或拖移時絕不會關閉。"
          }
        }
      }
    },
