    "New characters in notes appear in the accent color, then settle." : {
      "comment" : "Settings ▸ Appearance: footnote of Typing effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الأحرف الجديدة في الملاحظات باللون الثانوي، ثم تعود إلى لونها العادي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els caràcters nous de les notes apareixen amb el color de contrast i després recuperen el color normal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové znaky v poznámkách se objeví v barvě akcentu a pak přejdou do běžné barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye tegn i noter vises i accentfarven og får derefter den normale farve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Zeichen in Notizen erscheinen in der Akzentfarbe und nehmen dann die normale Farbe an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι νέοι χαρακτήρες στις σημειώσεις εμφανίζονται με το χρώμα έμφασης και μετά επανέρχονται στο κανονικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los caracteres nuevos de las notas aparecen en el color de contraste y luego recuperan su color."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudet merkit näkyvät muistiinpanoissa hetken korostusvärillä ja muuttuvat sitten tavallisiksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les notes, les nouveaux caractères apparaissent dans la couleur d’accentuation, puis reprennent leur couleur normale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תווים חדשים בפתקים מופיעים בצבע ההדגשה ואז חוזרים לצבע הרגיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट्स में नए अक्षर ऐक्सेंट कलर में दिखते हैं, फिर सामान्य हो जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi znakovi u bilješkama pojavljuju se u boji naglašavanja, a zatim poprime uobičajenu boju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jegyzetekben az új karakterek kiemelőszínnel jelennek meg, majd visszaváltanak a szokásos színre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karakter baru di catatan muncul dalam warna aksen, lalu kembali normal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi caratteri nelle note appaiono nel colore dettagli, poi tornano al colore normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモに新しく入力した文字がアクセントカラーで表示され、そのあと通常の色に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모에 새로 입력한 문자가 강조 색상으로 나타났다가 원래 색으로 돌아옵니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksara baharu dalam nota muncul dalam warna aksen, kemudian kembali seperti biasa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye tegn i notater vises først i aksentfargen og deretter i vanlig farge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe tekens in notities verschijnen eerst in de accentkleur en krijgen daarna hun gewone kleur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe znaki w notatkach pojawiają się w kolorze akcentu, a potem wracają do zwykłego koloru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os novos caracteres das notas aparecem na cor de realce e depois voltam ao normal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os novos caracteres nas notas aparecem na cor de realce e depois voltam à cor normal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracterele noi din notițe apar în culoarea accent, apoi revin la normal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые символы в заметках появляются акцентным цветом, а затем принимают обычный."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové znaky v poznámkach sa najprv zobrazia vo farbe akcentu a potom sa ustália."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi znaki v zapiskih se pokažejo v barvi poudarka, nato dobijo običajno barvo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nya tecken i anteckningar visas i accentfärgen och får sedan vanlig färg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวอักษรใหม่ในโน้ตจะปรากฏเป็นสีเน้นก่อน แล้วค่อยกลับเป็นสีปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notlardaki yeni karakterler önce vurgu renginde görünür, sonra normale döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові символи в нотатках зʼявляються акцентним кольором, а потім набувають звичайного."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ký tự mới trong ghi chú xuất hiện bằng màu nhấn rồi trở về màu thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笔记中新输入的字符先以强调色显示，随后恢复正常。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "筆記中新輸入的字元會先以強調顏色顯示，然後恢復正常。"
          }
        }
      }
    },
