    "With Reduce Motion turned on in System Settings, shapes fade instead of moving." : {
      "comment" : "Settings ▸ Appearance: footnote of Motion",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تشغيل \"تقليل الحركة\" في إعدادات النظام، تتلاشى الأشكال بدلًا من التحرك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si “Redueix el moviment” està activat a la configuració del sistema, les formes s’esvaeixen en lloc de moure’s."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je v Nastavení systému zapnutá volba Omezit pohyb, tvary se místo pohybu prolínají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når “Formindsk bevægelse” er slået til i Systemindstillinger, toner former ind og ud i stedet for at bevæge sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist „Bewegung reduzieren“ in den Systemeinstellungen aktiviert, werden Formen ein- und ausgeblendet statt bewegt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν η «Μείωση κίνησης» είναι ενεργή στις Ρυθμίσεις συστήματος, τα σχήματα εμφανίζονται σταδιακά αντί να κινούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si activas “Reducir movimiento” en Ajustes del Sistema, las formas aparecen y desaparecen en lugar de moverse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun ”Vähennä liikettä” on päällä Järjestelmäasetuksissa, muodot häivytetään liikkumisen sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si « Réduire les animations » est activé dans Réglages Système, les formes apparaissent en fondu au lieu de se déplacer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כש״הפחתת תזוזות״ פעילה ב״הגדרות המערכת״, הצורות מתחלפות בהדרגה במקום לזוז."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग में “गति घटाएँ” चालू होने पर आकृतियाँ हिलने के बजाय धीरे-से उभरती और ओझल होती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je u Postavkama sustava uključeno “Smanji pomicanje”, oblici postupno nestaju i pojavljuju se umjesto da se pomiču."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a Rendszerbeállításokban be van kapcsolva a „Mozgás csökkentése”, az alakzatok mozgás helyett elhalványulnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika “Kurangi gerakan” menyala di Pengaturan Sistem, bentuk memudar alih-alih bergerak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con “Riduci movimento” attivo in Impostazioni di Sistema, le forme sfumano invece di muoversi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“システム設定”で“視差効果を減らす”がオンのときは、図形が移動せずにフェードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 ‘동작 줄이기’가 켜져 있으면 모양이 움직이는 대신 서서히 나타나고 사라집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila “Kurangkan pergerakan” diaktifkan dalam Seting Sistem, bentuk memudar dan bukannya bergerak."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når «Reduser bevegelse» er slått på i Systeminnstillinger, tones former inn og ut i stedet for å bevege seg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als ‘Verminder beweging’ in Systeeminstellingen is ingeschakeld, vervagen vormen in plaats van te bewegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy w Ustawieniach systemowych jest włączona opcja „Redukuj ruch”, kształty płynnie pojawiają się i znikają, zamiast się przesuwać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com Reduzir movimento ativado nos Ajustes do Sistema, as formas aparecem gradualmente em vez de se mover."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com “Reduzir movimento” ativado nas Definições do Sistema, as formas desvanecem‑se em vez de se moverem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cu „Reducere mișcare” activată în Configurări sistem, formele se estompează în loc să se miște."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если в Системных настройках включено «Уменьшить движение», формы проявляются на месте, а не перемещаются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je v Systémových nastaveniach zapnutá funkcia Obmedziť pohyb, tvary sa namiesto pohybu prelínajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je v Nastavitvah sistema vklopljena možnost »Zmanjšaj dinamičnost animacij«, se oblike postopno pokažejo, namesto da bi se premikale."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När ”Minska rörelse” är på i Systeminställningar tonas former in och ut i stället för att röra sig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิด “ลดการเคลื่อนไหว” ในการตั้งค่าระบบ รูปทรงต่างๆ จะค่อยๆ จางเข้าและจางออกแทนการเคลื่อนที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları’nda “Hareketi azalt” açıksa şekiller hareket etmek yerine belirip kaybolur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо в Системних параметрах увімкнено «Зменшити рух», фігури проявляються на місці, а не рухаються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật “Giảm chuyển động” trong Cài đặt hệ thống, các hình dạng mờ dần thay vì di chuyển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“系统设置”中打开“减弱动态效果”后，形状会以淡入淡出代替移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「系統設定」中開啟「減少動態效果」時，形狀會以淡入淡出取代移動。"
          }
        }
      }
    },
    "With Vivid light, a glow spills onto the desktop under Cranny." : {
      "comment" : "Settings ▸ Appearance: footnote of Underglow",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مع الضوء الساطع، ينسكب التوهج على سطح المكتب أسفل Cranny."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb la llum intensa, una resplendor s’escampa per l’escriptori sota el Cranny."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při výrazném světle se záře rozlije i na plochu pod Cranny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med kraftigt lys breder et skær sig ud over skrivebordet under Cranny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei kräftigem Umgebungslicht fällt ein Schein auf den Schreibtisch unter Cranny."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με έντονο φως, μια λάμψη απλώνεται στο γραφείο εργασίας κάτω από το Cranny."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la luz “Intensa”, un resplandor se extiende por el escritorio bajo Cranny."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirkkaalla valolla hehku leviää työpöydälle Crannyn alle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec la lumière « Vive », une lueur déborde sur le bureau sous Cranny."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עם אור עז, זוהר נשפך על המכתבה מתחת ל-Cranny."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चटक रोशनी में Cranny के नीचे डेस्कटॉप पर चमक फैलती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uz jarko svjetlo sjaj se razlijeva po radnoj površini ispod Crannyja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Élénk fénynél a ragyogás a Cranny alatt az íróasztalra is kiárad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan cahaya Cerah, pendar meluber ke desktop di bawah Cranny."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la luce “Intensa”, un bagliore si diffonde sulla scrivania sotto Cranny."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "環境光が“鮮やか”のときは、Crannyの下のデスクトップに光があふれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조명을 ‘선명하게’로 설정하면 Cranny 아래의 데스크탑으로 빛이 번집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan cahaya Terang, sinaran melimpah ke desktop di bawah Cranny."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med kraftig lys sprer en glød seg ut over skrivebordet under Cranny."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij fel sfeerlicht valt er een gloed op het bureaublad onder Cranny."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy intensywnym świetle poświata rozlewa się na biurko pod Cranny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a luz Intensa, um brilho se espalha pela mesa abaixo do Cranny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a luz intensa, um brilho espalha‑se pela secretária por baixo do Cranny."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cu lumina „Intensă”, o strălucire se revarsă pe desktop sub Cranny."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При ярком свете сияние разливается по рабочему столу под Cranny."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri výraznom svetle sa žiara rozlieva po ploche pod Cranny."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z ambientno svetlobo »Živa« se sij razlije po namizju pod Crannyjem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med starkt ljus sprider sig ett sken över skrivbordet under Cranny."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อใช้แสงแบบสดใส แสงเรืองจะส่องลงบนเดสก์ท็อปใต้ Cranny"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parlak ışıkta Cranny’nin altındaki masaüstüne bir parıltı yayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли фонове світло «Яскраве», світіння розливається по робочому столу під Cranny."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với ánh sáng Rực rỡ, quầng sáng lan xuống màn hình nền bên dưới Cranny."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“鲜明”光效时，光晕会洒落到Cranny下方的桌面上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用「鮮明」光線時，光暈會灑落在Cranny下方的桌面上。"
          }
        }
      }
    },
    "Yellow" : {
