        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando abre o Cranny com o teclado, basta começar a escrever para criar uma nota ou uma tarefa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când deschideți Cranny de la tastatură, începeți pur și simplu să tastați pentru a scrie o notiță sau o sarcină."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если открыть Cranny с клавиатуры, можно сразу печатать — получится заметка или задача."
