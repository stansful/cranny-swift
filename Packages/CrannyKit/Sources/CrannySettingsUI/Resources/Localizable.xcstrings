    "Higher needs less finger travel." : {
      "comment" : "Settings ▸ Gestures: footnote of Sensitivity",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلما زادت، قلّت حركة الإصبع المطلوبة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com més alta, menys cal moure els dits."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čím vyšší, tím kratší pohyb prstů stačí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
