    "See your day and join meetings from here." : {
      "comment" : "Calendar widget: why to allow calendar access (one line)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد يومك وانضم إلى الاجتماعات من هنا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta el teu dia i uneix‑te a reunions des d’aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehled dne a připojení ke schůzkám přímo odsud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se din dag, og deltag i møder herfra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier siehst du deinen Tag und trittst Meetings direkt bei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε τη μέρα σας και συμμετάσχετε σε συσκέψεις από εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta tu día y únete a reuniones desde aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näe päiväsi ja liity kokouksiin suoraan täältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez votre journée et rejoignez vos réunions d’ici."
