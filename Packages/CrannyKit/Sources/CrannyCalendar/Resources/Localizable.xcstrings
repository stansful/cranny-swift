            "value" : "يظهر \"اجتماع قريب\" قبل الحدث بهذه المدة، ثم مرة أخرى قبله بدقيقة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Reunió imminent” apareix amb aquesta antelació abans d’un esdeveniment, i un altre cop un minut abans."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivita „Nadcházející schůzka“ se zobrazí s tímto předstihem a ještě jednou minutu před začátkem události."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Møde snart” vises så lang tid før en begivenhed og igen et minut før."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Meeting in Kürze“ erscheint so lange vor einem Ereignis und noch einmal eine Minute vorher."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η «Επικείμενη σύσκεψη» εμφανίζεται τόσο χρόνο πριν από ένα γεγονός και ξανά ένα λεπτό πριν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Próxima reunión” aparece con esta antelación y otra vez un minuto antes del evento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Kokous pian” näkyy näin kauan ennen tapahtumaa ja uudelleen minuuttia ennen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Réunion imminente » s’affiche avec cette avance sur l’événement, puis de nouveau une minute avant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״פגישה בקרוב״ מופיעה פרק זמן זה לפני אירוע, ושוב דקה לפניו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“जल्द ही मीटिंग” इवेंट से इतनी देर पहले दिखती है, और फिर एक मिनट पहले।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Uskoro sastanak” prikazuje se ovoliko prije događaja i ponovno minutu prije početka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Közelgő megbeszélés” ennyivel az esemény előtt jelenik meg, majd egy perccel előtte újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Rapat segera dimulai” muncul sekian lama sebelum acara, lalu sekali lagi satu menit sebelumnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Riunione a breve” appare con questo anticipo rispetto all’evento e di nuovo un minuto prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“まもなくミーティング”は、イベント開始のこの時間前に表示され、1分前にもう一度表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘곧 회의 시작’은 이벤트 시작 전 여기에서 설정한 시간에 나타나고, 시작 1분 전에 한 번 더 나타납니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Mesyuarat akan bermula” muncul sekian lama sebelum peristiwa, dan sekali lagi seminit sebelumnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Møte snart» vises så lenge før en hendelse, og igjen ett minutt før."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Vergadering begint zo’ verschijnt zoveel tijd vóór een afspraak, en nog eens één minuut ervoor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wkrótce spotkanie” pojawia się z takim wyprzedzeniem przed wydarzeniem i jeszcze raz na minutę przed nim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Reunião em breve” aparece com esta antecedência e de novo um minuto antes do evento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Reunião em breve” aparece com esta antecedência em relação a um evento e outra vez um minuto antes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Întâlnire în curând” apare cu atât timp înainte de un eveniment și din nou cu un minut înainte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Скоро встреча» появляется за это время до события и ещё раз за минуту."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornenie na blížiace sa stretnutie sa zobrazí takto dlho pred udalosťou a potom ešte raz minútu pred ňou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivnost »Sestanek kmalu« se prikaže toliko časa pred dogodkom in znova minuto pred začetkom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Möte snart” visas så här lång tid före en händelse och igen en minut före."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ใกล้ถึงเวลาประชุม” จะปรากฏล่วงหน้าตามเวลานี้ก่อนกิจกรรม และอีกครั้งก่อนเริ่ม 1 นาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Yaklaşan toplantı”, etkinlikten bu kadar süre önce ve bir dakika kala yeniden görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Скоро зустріч» зʼявляється за заданий час до події і ще раз — за хвилину до неї."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sắp họp” xuất hiện trước sự kiện đúng khoảng thời gian này, rồi xuất hiện lại khi còn một phút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“会议即将开始”会在日程开始前的这段时间出现，并在开始前一分钟再次出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「會議即將開始」會在行程開始前這段時間出現，並在開始前一分鐘再次出現。"
          }
        }
      }
    },
