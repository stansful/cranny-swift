    "Hidden calendars never appear in the widget or as live activities." : {
      "comment" : "Settings ▸ Calendar: footnote under the calendar list",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تظهر التقويمات المخفية أبدًا في الأداة ولا كأنشطة مباشرة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els calendaris ocults no apareixen mai al giny ni com a activitats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryté kalendáře se nikdy nezobrazují ve widgetu ani jako živé aktivity."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjulte kalendere vises aldrig i widgetten eller som liveaktiviteter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeblendete Kalender erscheinen nie im Widget oder als Live-Aktivitäten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κρυφά ημερολόγια δεν εμφανίζονται ποτέ, ούτε στο widget ούτε ως δραστηριότητες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los calendarios ocultos nunca aparecen en el widget ni como actividades en directo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kätketyt kalenterit eivät koskaan näy widgetissä eivätkä liveseurannassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les calendriers masqués n’apparaissent jamais dans le widget ni dans les activités en direct."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לוחות שנה מוסתרים לא מופיעים בווידג׳ט ולא כפעילויות בזמן אמת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छिपे हुए कैलेंडर न विजेट में दिखते हैं, न लाइव ऐक्टिविटी में।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriveni kalendari nikad se ne prikazuju u widgetu ni kao aktivnosti uživo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rejtett naptárak nem jelennek meg sem a widgetben, sem élő tevékenységként."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender yang disembunyikan tidak pernah muncul di widget atau sebagai aktivitas langsung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I calendari nascosti non appaiono mai nel widget né come attività in tempo reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示のカレンダーは、ウィジェットにもライブアクティビティにも表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표시하지 않는 캘린더는 위젯이나 실시간 현황에 나타나지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalendar yang disembunyikan tidak akan muncul dalam widget atau sebagai aktiviti langsung."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjulte kalendere vises aldri i widgeten eller som aktiviteter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verborgen agenda’s verschijnen nooit in de widget of als live activiteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryte kalendarze nie pojawiają się w widżecie ani jako aktywności na żywo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendários ocultos nunca aparecem no widget nem como atividades ao vivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os calendários ocultos nunca aparecem no widget nem como atividades em tempo real."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendarele ascunse nu apar niciodată nici în widget, nici ca activități live."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрытые календари не появляются ни в виджете, ни в активностях."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryté kalendáre sa nikdy nezobrazujú vo widgete ani ako aktivity naživo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriti koledarji se nikoli ne prikažejo v gradniku ali kot aktivnosti v živo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dolda kalendrar visas aldrig i widgeten eller som liveaktiviteter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปฏิทินที่ซ่อนไว้จะไม่แสดงในวิดเจ็ตหรือเป็นกิจกรรมสด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizli takvimler ne araç takımında ne de canlı etkinlik olarak görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховані календарі не показуються ні у віджеті, ні серед дій наживо."
