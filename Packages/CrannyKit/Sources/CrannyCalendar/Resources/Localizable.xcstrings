        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כאן אפשר לראות את סדר היום ולהצטרף לפגישות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
