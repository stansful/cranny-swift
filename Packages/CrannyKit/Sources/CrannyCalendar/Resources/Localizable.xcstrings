          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser hendelsene dine i Cranny. Cranny endrer dem aldri og laster dem aldri opp."
          }
        },
        "nl" : {
          "stringUnit" : {
