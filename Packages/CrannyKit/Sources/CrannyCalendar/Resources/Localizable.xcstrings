    "Show your events in Cranny. Cranny never edits or uploads them." : {
      "comment" : "Permission reason: Calendar (Settings ▸ Calendar, Permissions pane, onboarding)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار أحداثك في Cranny. لا يعدّل Cranny أحداثك ولا يرفعها أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra els teus esdeveniments al Cranny. El Cranny no els modifica ni els puja mai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazovat vaše události v aplikaci Cranny. Cranny je nikdy neupravuje ani nikam neodesílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis dine begivenheder i Cranny. Cranny ændrer eller uploader dem aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse in Cranny anzeigen. Cranny bearbeitet sie nie und lädt sie nie hoch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση των γεγονότων σας στο Cranny. Το Cranny δεν τα επεξεργάζεται ούτε τα αποστέλλει ποτέ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar tus eventos en Cranny. Cranny nunca los modifica ni los sube."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää tapahtumasi lovessa. Cranny ei koskaan muokkaa eikä lähetä niitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher vos événements dans Cranny. Cranny ne les modifie ni ne les envoie jamais."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת האירועים שלך ב-Cranny. Cranny לעולם אינו עורך או מעלה אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने इवेंट Cranny में दिखाएँ। Cranny उन्हें न तो कभी बदलता है, न ही अपलोड करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaz vaših događaja u aplikaciji Cranny. Cranny ih nikad ne mijenja niti prenosi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az események megjelenítése a Cranny appban. A Cranny soha nem módosítja és nem tölti fel őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan acara Anda di Cranny. Cranny tidak pernah mengubah atau mengunggahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra i tuoi eventi in Cranny. Cranny non li modifica né li carica mai online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crannyにイベントを表示します。Crannyがイベントを編集したりアップロードしたりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny에 이벤트를 표시합니다. Cranny는 이벤트를 편집하거나 업로드하지 않습니다."
