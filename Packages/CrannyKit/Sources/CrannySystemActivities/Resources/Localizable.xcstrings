    "Shows every Bluetooth device that connects. Headphones and Magic accessories work without it." : {
      "comment" : "Permissions pane and onboarding: why Cranny may ask for Bluetooth access",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض كل جهاز Bluetooth يتصل. تعمل سماعات الرأس وملحقات Magic بدون هذا الإذن."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra cada dispositiu Bluetooth que es connecta. Els auriculars i els accessoris Magic funcionen sense aquest permís."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí každé zařízení Bluetooth, které se připojí. Sluchátka a příslušenství Magic fungují i bez toho."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser alle Bluetooth-enheder, der tilsluttes. Hovedtelefoner og Magic-tilbehør fungerer også uden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt jedes Bluetooth-Gerät, das sich verbindet. Kopfhörer und Magic-Zubehör funktionieren auch ohne."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει κάθε συσκευή Bluetooth που συνδέεται. Τα ακουστικά και τα αξεσουάρ Magic λειτουργούν και χωρίς αυτήν την άδεια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra todos los dispositivos Bluetooth que se conectan. Los auriculares y los accesorios Magic funcionan sin este permiso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää jokaisen yhdistyvän Bluetooth-laitteen. Kuulokkeet ja Magic-lisävarusteet toimivat ilman tätä lupaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche chaque appareil Bluetooth qui se connecte. Les écouteurs et les accessoires Magic fonctionnent sans cet accès."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת כל מכשיר Bluetooth שמתחבר. אוזניות ואביזרי Magic עובדים גם בלי ההרשאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कनेक्ट होने वाला हर Bluetooth डिवाइस दिखाता है। हेडफ़ोन और Magic ऐक्सेसरी इसके बिना भी काम करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje svaki Bluetooth uređaj koji se poveže. Slušalice i Magic dodaci rade i bez toga."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden csatlakozó Bluetooth-eszközt megjelenít. A fejhallgatók és a Magic kiegészítők enélkül is működnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan setiap perangkat Bluetooth yang terhubung. Headphone dan aksesori Magic tetap berfungsi tanpa izin ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra ogni dispositivo Bluetooth che si connette. Cuffie e accessori Magic funzionano anche senza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続されるすべてのBluetoothデバイスを表示します。ヘッドフォンとMagicアクセサリはこの許可がなくても表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결되는 모든 Bluetooth 기기를 표시합니다. 헤드폰과 Magic 액세서리는 이 권한 없이도 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunjukkan setiap peranti Bluetooth yang bersambung. Fon kepala dan aksesori Magic berfungsi tanpanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser alle Bluetooth-enheter som kobles til. Hodetelefoner og Magic-tilbehør fungerer også uten tilgangen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont elk Bluetooth-apparaat dat verbinding maakt. Koptelefoons en Magic-accessoires werken ook zonder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazywanie każdego łączącego się urządzenia Bluetooth. Słuchawki i akcesoria Magic są pokazywane także bez tego uprawnienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra todos os dispositivos Bluetooth que se conectarem. Fones de ouvido e acessórios Magic funcionam sem isso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra todos os dispositivos Bluetooth que se ligam. Os auscultadores e os acessórios Magic funcionam sem este acesso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișarea fiecărui dispozitiv Bluetooth care se conectează. Căștile și accesoriile Magic funcționează și fără acest acces."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает каждое подключённое Bluetooth-устройство. Наушники и аксессуары Magic работают и без этого."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje každé zariadenie Bluetooth, ktoré sa pripojí. Slúchadlá a príslušenstvo Magic fungujú aj bez toho."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaže vsako napravo Bluetooth, ki se poveže. Slušalke in dodatki Magic delujejo tudi brez tega."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar alla Bluetooth-enheter som ansluts. Hörlurar och Magic-tillbehör fungerar även utan den här behörigheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงอุปกรณ์บลูทูธทุกเครื่องที่เชื่อมต่อ หูฟังและอุปกรณ์เสริม Magic ใช้งานได้โดยไม่ต้องใช้สิทธิ์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlanan her Bluetooth aygıtını gösterir. Kulaklıklar ve Magic aksesuarları bu izin olmadan da çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує кожен Bluetooth-пристрій, що підключається. Навушники та аксесуари Magic працюють і без цього."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị mọi thiết bị Bluetooth được kết nối. Tai nghe và phụ kiện Magic vẫn hoạt động khi không có quyền này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示每个连接的蓝牙设备。耳机和妙控配件无需此权限也能显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示每個連線的藍牙裝置。耳機和Magic配件不需要此權限也能顯示。"
          }
        }
      }
    },
