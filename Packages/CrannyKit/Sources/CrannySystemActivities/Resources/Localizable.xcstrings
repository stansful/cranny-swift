    "Stays until you connect power." : {
      "comment" : "Settings ▸ Live Activities ▸ Low battery: footnote under “Final warning”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى حتى توصيل الطاقة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es manté fins que connectis el corrent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zůstane zobrazené, dokud nepřipojíte napájení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliver vist, indtil du tilslutter strøm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt, bis du ein Netzteil anschließt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παραμένει μέχρι να συνδέσετε το ρεύμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanece hasta que conectes la corriente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näkyy, kunnes kytket virtalähteen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reste affiché jusqu’au branchement sur secteur."
          }
        },
