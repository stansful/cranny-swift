    "Also shows keyboards, mice and headphones from other makers. Needs Bluetooth access." : {
      "comment" : "Settings ▸ Live Activities ▸ Bluetooth devices: footnote under the toggle",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض أيضًا لوحات المفاتيح وأجهزة الماوس وسماعات الرأس من شركات أخرى. يتطلب الوصول إلى Bluetooth."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "També mostra teclats, ratolins i auriculars d’altres fabricants. Requereix accés al Bluetooth."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje také klávesnice, myši a sluchátka jiných výrobců. Vyžaduje přístup k Bluetooth."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser også tastaturer, mus og hovedtelefoner fra andre producenter. Kræver adgang til Bluetooth."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt auch Tastaturen, Mäuse und Kopfhörer anderer Hersteller. Erfordert Bluetooth-Zugriff."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει επίσης πληκτρολόγια, ποντίκια και ακουστικά άλλων κατασκευαστών. Απαιτεί πρόσβαση στο Bluetooth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También muestra teclados, ratones y auriculares de otros fabricantes. Requiere acceso a Bluetooth."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää myös muiden valmistajien näppäimistöt, hiiret ja kuulokkeet. Vaatii Bluetooth-luvan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche aussi les claviers, souris et écouteurs d’autres fabricants. Nécessite l’accès au Bluetooth."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג גם מקלדות, עכברים ואוזניות של יצרנים אחרים. נדרשת גישה ל-Bluetooth."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अन्य निर्माताओं के कीबोर्ड, माउस और हेडफ़ोन भी दिखाता है। Bluetooth ऐक्सेस की ज़रूरत है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje i tipkovnice, miševe i slušalice drugih proizvođača. Potreban je pristup Bluetoothu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más gyártók billentyűzeteit, egereit és fejhallgatóit is megjeleníti. Bluetooth-hozzáférés szükséges hozzá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juga menampilkan papan ketik, tetikus, dan headphone dari produsen lain. Memerlukan akses Bluetooth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra anche tastiere, mouse e cuffie di altri produttori. Richiede l’accesso a Bluetooth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのメーカーのキーボード、マウス、ヘッドフォンも表示します。Bluetoothへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 제조업체의 키보드, 마우스 및 헤드폰도 표시합니다. Bluetooth 접근 권한이 필요합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turut menunjukkan papan kekunci, tetikus dan fon kepala daripada pengeluar lain. Memerlukan akses Bluetooth."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser også tastaturer, mus og hodetelefoner fra andre produsenter. Krever Bluetooth-tilgang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont ook toetsenborden, muizen en koptelefoons van andere merken. Vereist toegang tot Bluetooth."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje też klawiatury, myszy i słuchawki innych producentów. Wymaga dostępu do Bluetooth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também mostra teclados, mouses e fones de ouvido de outros fabricantes. Requer acesso ao Bluetooth."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também mostra teclados, ratos e auscultadores de outros fabricantes. Requer acesso ao Bluetooth."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează și tastaturi, mausuri și căști de la alți producători. Necesită acces la Bluetooth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также показывает клавиатуры, мыши и наушники других производителей. Нужен доступ к Bluetooth."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje aj klávesnice, myši a slúchadlá od iných výrobcov. Vyžaduje prístup k Bluetoothu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaže tudi tipkovnice, miške in slušalke drugih proizvajalcev. Potreben je dostop do funkcije Bluetooth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar också tangentbord, möss och hörlurar från andra tillverkare. Kräver Bluetooth-åtkomst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงแป้นพิมพ์ เมาส์ และหูฟังจากผู้ผลิตรายอื่นด้วย ต้องใช้สิทธิ์เข้าถึงบลูทูธ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer üreticilerin klavyelerini, farelerini ve kulaklıklarını da gösterir. Bluetooth erişimi gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Також показує клавіатури, миші й навушники інших виробників. Потрібен доступ до Bluetooth."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cũng hiển thị bàn phím, chuột và tai nghe của các nhà sản xuất khác. Cần quyền truy cập Bluetooth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也会显示其他厂商的键盘、鼠标和耳机。需要蓝牙访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也會顯示其他製造商的鍵盤、滑鼠和耳機。需要藍牙取用權限。"
          }
        }
      }
