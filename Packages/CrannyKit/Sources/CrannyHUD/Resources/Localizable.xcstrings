          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niveaus van volume, helderheid en toetsenbordverlichting verschijnen in de notch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poziomy głośności, jasności i podświetlenia klawiatury pojawiają się w wycięciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
