    "Built-in display only. Other displays keep the macOS HUD." : {
      "comment" : "Settings ▸ HUD: footnote under Brightness",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للشاشة المضمنة فقط. تحتفظ شاشات العرض الأخرى بمؤشر المستوى الخاص بـ macOS."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només la pantalla integrada. Les altres pantalles mantenen l’indicador del macOS."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jen na vestavěném monitoru. Ostatní monitory si ponechají indikátor systému macOS."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun den indbyggede skærm. Andre skærme beholder macOS-indikatoren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur integriertes Display. Andere Displays behalten das Overlay von macOS."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο στην ενσωματωμένη οθόνη. Οι άλλες οθόνες διατηρούν την ένδειξη του macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo en la pantalla integrada. Las demás pantallas mantienen el indicador de macOS."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain sisäinen näyttö. Muilla näytöillä näkyy macOS:n oma ilmaisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écran intégré uniquement. Les autres écrans conservent l’indicateur de macOS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בצג המובנה בלבד. בצגים אחרים נשאר המחוון של macOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल बिल्टइन डिस्प्ले। अन्य डिस्प्ले पर macOS का संकेतक ही रहता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo ugrađeni zaslon. Ostali zasloni zadržavaju indikator sustava macOS."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a beépített kijelzőn. A többi kijelzőn a macOS szintjelzője marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya layar internal. Layar lain tetap memakai indikator macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo schermo integrato. Gli altri schermi mantengono l’indicatore di macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内蔵ディスプレイのみ。ほかのディスプレイではmacOSのインジケータが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장 디스플레이에서만 작동합니다. 다른 디스플레이에서는 macOS 표시기가 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paparan terbina dalam sahaja. Paparan lain mengekalkan penunjuk macOS."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare innebygd skjerm. Andre skjermer beholder macOS-indikatoren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen op het ingebouwde beeldscherm. Andere beeldschermen tonen de indicator van macOS."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko wbudowany wyświetlacz. Na innych wyświetlaczach pozostaje nakładka macOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente a tela integrada. As outras telas mantêm o indicador do macOS."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o monitor integrado. Os outros monitores mantêm o indicador do macOS."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar afișajul integrat. Celelalte afișaje păstrează indicatorul macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только встроенный дисплей. На других дисплеях остаётся индикатор macOS."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Len vstavaný displej. Ostatné displeje si ponechávajú indikátor systému macOS."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo vgrajeni zaslon. Drugi zasloni ohranijo indikator sistema macOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara den inbyggda skärmen. Andra skärmar behåller macOS egen indikator."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เฉพาะจอภาพในตัวเท่านั้น จอภาพอื่นยังคงใช้ตัวแสดงระดับของ macOS"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca yerleşik ekranda. Diğer ekranlarda macOS göstergesi kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише вбудований дисплей. На інших дисплеях залишається індикатор macOS."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ áp dụng cho màn hình tích hợp. Các màn hình khác vẫn dùng chỉ báo của macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限内建显示器。其他显示器仍使用macOS的指示器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅限內建顯示器。其他顯示器仍使用macOS的指示器。"
          }
        }
      }
    },
