    "Turn on Cranny in Privacy & Security ▸ Accessibility, then come back here." : {
      "comment" : "Settings ▸ HUD: footnote while Accessibility is not granted",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل Cranny في الخصوصية والأمن ◂ تسهيلات الاستخدام، ثم عُد إلى هنا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el Cranny a Privacitat i seguretat ▸ Accessibilitat i torna aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte Cranny v nastavení Soukromí a zabezpečení ▸ Zpřístupnění a pak se sem vraťte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå Cranny til i Anonymitet & sikkerhed ▸ Tilgængelighed, og vend så tilbage hertil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere Cranny unter „Datenschutz & Sicherheit“ ▸ „Bedienungshilfen“ und kehre dann hierher zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε το Cranny στην ενότητα «Απόρρητο και ασφάλεια» ▸ «Προσβασιμότητα» και επιστρέψτε εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Cranny en Privacidad y seguridad ▸ Accesibilidad y vuelve aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laita Cranny päälle kohdassa Tietosuoja ja suojaus ▸ Käyttöapu ja palaa sitten tänne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Cranny dans Confidentialité et sécurité ▸ Accessibilité, puis revenez ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להפעיל את Cranny ב״פרטיות ואבטחה״ > ״נגישות״ ולחזור לכאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गोपनीयता और सुरक्षा ▸ ऐक्सेसिबिलिटी में Cranny को चालू करें, फिर यहाँ वापस आएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključite Cranny u odjeljku Privatnost i sigurnost ▸ Pristupačnost, a zatim se vratite ovamo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolja be a Cranny appot az Adatvédelem és biztonság ▸ Kisegítő lehetőségek részben, majd térjen vissza ide."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyalakan Cranny di Privasi & Keamanan ▸ Aksesibilitas, lalu kembali ke sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Cranny in Privacy e sicurezza ▸ Accessibilità, poi torna qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“プライバシーとセキュリティ” ▸ “アクセシビリティ”でCrannyをオンにしてから、ここに戻ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘개인정보 보호 및 보안’ ▸ ‘손쉬운 사용’에서 Cranny를 켠 다음 여기로 돌아오십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan Cranny dalam Privasi & Keselamatan ▸ Kebolehcapaian, kemudian kembali ke sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på Cranny i Personvern og sikkerhet ▸ Tilgjengelighet og kom så tilbake hit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel Cranny in bij Privacy en beveiliging ▸ Toegankelijkheid en kom dan hier terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz Cranny w sekcji Prywatność i ochrona ▸ Dostępność, a następnie wróć tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Cranny em Privacidade e Segurança ▸ Acessibilidade e depois volte aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Cranny em Privacidade e segurança ▸ Acessibilidade e depois volte aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activați Cranny în Intimitate și securitate ▸ Accesibilitate, apoi reveniți aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите Cranny в разделе «Конфиденциальность и безопасность» ▸ «Универсальный доступ» и вернитесь сюда."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnite Cranny v časti Súkromie a bezpečnosť ▸ Prístupnosť a potom sa sem vráťte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vklopite Cranny v razdelku Zasebnost in varnost ▸ Dostopnost, nato se vrnite sem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på Cranny under Integritet och säkerhet ▸ Hjälpmedel och kom sedan tillbaka hit."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดใช้ Cranny ใน “ความเป็นส่วนตัวและความปลอดภัย ▸ การช่วยการเข้าถึง” แล้วกลับมาที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizlilik ve Güvenlik ▸ Erişilebilirlik bölümünde Cranny’yi açın, sonra buraya dönün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть Cranny в розділі «Приватність і безпека» ▸ «Доступність», а потім поверніться сюди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật Cranny trong Quyền riêng tư & Bảo mật ▸ Trợ năng, rồi quay lại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“隐私与安全”▸“无障碍”中打开Cranny，然后返回这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「隱私權與安全性」▸「輔助使用」中開啟Cranny，然後回到這裡。"
          }
        }
      }
    },
