    "Replace the system volume and brightness HUD. Cranny uses it only to handle those keys." : {
      "comment" : "Permissions pane and onboarding: why the HUD needs Accessibility",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استبدال مؤشر مستوى الصوت والإضاءة في النظام. يستخدم Cranny هذا الإذن فقط للتعامل مع تلك المفاتيح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitueix l’indicador de volum i brillantor del sistema. El Cranny només fa servir aquest permís per gestionar aquestes tecles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrazovat systémový indikátor hlasitosti a jasu. Cranny toto oprávnění používá jen k obsluze těchto kláves."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstat systemets indikator for lydstyrke og lysstyrke. Cranny bruger kun adgangen til at håndtere disse taster."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Lautstärke- und Helligkeits-Overlay des Systems ersetzen. Cranny nutzt den Zugriff nur für diese Tasten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντικατάσταση της ένδειξης έντασης και φωτεινότητας του συστήματος. Το Cranny χρησιμοποιεί την πρόσβαση μόνο για αυτά τα πλήκτρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituir el indicador de volumen y brillo del sistema. Cranny solo usa este permiso para gestionar esas teclas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korvaa järjestelmän äänenvoimakkuuden ja kirkkauden ilmaisimen. Cranny käyttää lupaa vain näiden näppäinten käsittelyyn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacer l’indicateur système de volume et de luminosité. Cranny utilise cet accès uniquement pour gérer ces touches."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלפת מחוון עוצמת הקול והבהירות של המערכת. Cranny משתמש בהרשאה רק כדי לטפל במקשים האלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम के वॉल्यूम और ब्राइटनेस संकेतक की जगह Cranny का संकेतक दिखाएँ। Cranny इस अनुमति का उपयोग केवल इन कीज़ के लिए करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamjena indikatora glasnoće i svjetline sustava. Cranny taj pristup koristi samo za te tipke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rendszer hangerő- és fényerő-szintjelzőjének lecserélése. A Cranny csak e billentyűk kezelésére használja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganti indikator volume dan kecerahan sistem. Cranny hanya menggunakan akses ini untuk menangani tombol tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisce l’indicatore di sistema per volume e luminosità. Cranny usa questa autorizzazione solo per gestire quei tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムの音量と輝度のインジケータを置き換えます。Crannyはこの許可をこれらのキーの処理にのみ使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 음량 및 밝기 표시기를 대체합니다. Cranny는 이 권한을 해당 키를 처리하는 데만 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gantikan penunjuk kelantangan dan kecerahan sistem. Cranny menggunakan akses ini hanya untuk mengendalikan kekunci tersebut."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstatter systemets volum- og lysstyrkeindikator. Cranny bruker tilgangen bare til å håndtere disse tastene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervangt de systeemindicator voor volume en helderheid. Cranny gebruikt deze toegang alleen voor die toetsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastępowanie systemowej nakładki głośności i jasności. Cranny używa tego uprawnienia tylko do obsługi tych klawiszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substituir o indicador de volume e brilho do sistema. O Cranny usa o acesso só para controlar essas teclas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substituir o indicador de volume e brilho do sistema. O Cranny usa este acesso apenas para tratar dessas teclas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înlocuirea indicatorului de volum și de luminozitate al sistemului. Cranny folosește accesul doar pentru aceste taste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменять системный индикатор громкости и яркости. Cranny использует доступ только для этих клавиш."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrádzať systémový indikátor hlasitosti a jasu. Cranny toto povolenie používa len na spracovanie týchto klávesov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamenjava sistemskega indikatorja glasnosti in svetlosti. Cranny dostop uporablja samo za te tipke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersätt systemets indikator för volym och ljusstyrka. Cranny använder behörigheten bara för att hantera de här tangenterna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แทนที่ตัวแสดงระดับเสียงและความสว่างของระบบ Cranny ใช้สิทธิ์นี้เพื่อจัดการปุ่มเหล่านั้นเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistemin ses yüksekliği ve parlaklık göstergesinin yerine geçmek için. Cranny bu izni yalnızca bu tuşları yönetmek için kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замінювати системний індикатор гучності та яскравості. Cranny використовує цей доступ лише для цих клавіш."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay thế chỉ báo âm lượng và độ sáng của hệ thống. Cranny chỉ dùng quyền này để xử lý các phím đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替换系统的音量和亮度指示器。Cranny仅将此权限用于处理这些按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取代系統的音量與亮度指示器。Cranny只會用此權限來處理這些按鍵。"
          }
        }
      }
    },
