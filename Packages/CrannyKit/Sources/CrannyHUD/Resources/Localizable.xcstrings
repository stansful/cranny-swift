          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kým ho tam znova nezapnete, macOS zobrazuje vlastný indikátor."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokler indikatorja tam znova ne vklopite, macOS prikazuje svojega."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS visar sin egen indikator tills du slår på den där igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS จะแสดงตัวแสดงระดับของตัวเองจนกว่าคุณจะกลับไปเปิดอีกครั้งที่นั่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orada yeniden açana kadar macOS kendi göstergesini gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS показуватиме свій індикатор, доки ви не ввімкнете індикатор Cranny там."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hiển thị chỉ báo của riêng nó cho đến khi bạn bật lại ở đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“实时活动”中重新打开之前，macOS会显示自己的指示器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你於「即時動態」中重新開啟之前，macOS會顯示自己的指示器。"
          }
        }
      }
    },
