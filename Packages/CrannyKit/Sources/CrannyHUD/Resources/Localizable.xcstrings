    "Volume, brightness and keyboard backlight levels appear in the notch." : {
      "comment" : "Settings ▸ HUD: footnote under Replace the system HUD",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر مستويات الصوت والإضاءة والإضاءة الخلفية للوحة المفاتيح في النتوء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els nivells de volum, brillantor i retroil·luminació del teclat apareixen a l’osca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úrovně hlasitosti, jasu a podsvícení klávesnice se zobrazují ve výřezu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niveauer for lydstyrke, lysstyrke og tastaturbelysning vises i notchen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautstärke, Helligkeit und Tastaturbeleuchtung werden in der Notch angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα επίπεδα έντασης, φωτεινότητας και οπίσθιου φωτισμού πληκτρολογίου εμφανίζονται στην εγκοπή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los niveles de volumen, brillo y retroiluminación del teclado aparecen en la muesca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänenvoimakkuuden, kirkkauden ja näppäimistön taustavalon tasot näkyvät lovessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les niveaux de volume, de luminosité et de rétroéclairage du clavier s’affichent dans l’encoche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רמות עוצמת הקול, הבהירות ותאורת המקלדת מוצגות במגרעת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉल्यूम, ब्राइटनेस और कीबोर्ड बैकलाइट के स्तर नॉच में दिखते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razine glasnoće, svjetline i pozadinskog osvjetljenja tipkovnice prikazuju se u izrezu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangerő, a fényerő és a billentyűzet-háttérvilágítás szintje a kivágásban jelenik meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingkat volume, kecerahan, dan lampu belakang papan ketik muncul di notch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I livelli di volume, luminosità e retroilluminazione della tastiera appaiono nella tacca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量、輝度、キーボードバックライトのレベルがノッチに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음량, 밝기 및 키보드 백라이트 수준이 노치에 나타납니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paras kelantangan, kecerahan dan lampu latar papan kekunci muncul pada takuk."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
