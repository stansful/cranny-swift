    "Accent for volume, yellow for brightness, blue for the keyboard." : {
      "comment" : "Settings ▸ HUD: footnote explaining the Semantic colours",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللون الثانوي لمستوى الصوت، والأصفر للإضاءة، والأزرق للوحة المفاتيح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color de contrast per al volum, groc per a la brillantor i blau per al teclat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva akcentu pro hlasitost, žlutá pro jas, modrá pro klávesnici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accentfarve for lydstyrke, gul for lysstyrke, blå for tastaturet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akzentfarbe für die Lautstärke, Gelb für die Helligkeit, Blau für die Tastatur."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρώμα έμφασης για την ένταση, κίτρινο για τη φωτεινότητα, μπλε για το πληκτρολόγιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color de contraste para el volumen, amarillo para el brillo y azul para el teclado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korostusväri äänenvoimakkuudelle, keltainen kirkkaudelle ja sininen näppäimistölle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleur d’accentuation pour le volume, jaune pour la luminosité, bleu pour le clavier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צבע ההדגשה לעוצמת הקול, צהוב לבהירות, כחול למקלדת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉल्यूम के लिए ऐक्सेंट, ब्राइटनेस के लिए पीला, कीबोर्ड के लिए नीला।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boja naglašavanja za glasnoću, žuta za svjetlinu, plava za tipkovnicu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiemelőszín a hangerőhöz, sárga a fényerőhöz, kék a billentyűzethez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksen untuk volume, kuning untuk kecerahan, biru untuk papan ketik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore dettagli per il volume, giallo per la luminosità, blu per la tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量はアクセントカラー、輝度は黄色、キーボードは青で表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음량은 강조 색상, 밝기는 노란색, 키보드는 파란색으로 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksen untuk kelantangan, kuning untuk kecerahan, biru untuk papan kekunci."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksentfarge for volum, gul for lysstyrke, blå for tastaturet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accentkleur voor volume, geel voor helderheid, blauw voor het toetsenbord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolor akcentu dla głośności, żółty dla jasności, niebieski dla klawiatury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor de realce para o volume, amarelo para o brilho, azul para o teclado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realce para o volume, amarelo para o brilho, azul para o teclado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Culoarea accent pentru volum, galben pentru luminozitate, albastru pentru tastatură."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акцентный для громкости, жёлтый для яркости, синий для клавиатуры."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farba akcentu pre hlasitosť, žltá pre jas, modrá pre klávesnicu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva poudarka za glasnost, rumena za svetlost, modra za tipkovnico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accentfärg för volym, gul för ljusstyrka, blå för tangentbordet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีเน้นสำหรับระดับเสียง สีเหลืองสำหรับความสว่าง สีน้ำเงินสำหรับแป้นพิมพ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses yüksekliği için vurgu rengi, parlaklık için sarı, klavye için mavi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акцентний для гучності, жовтий для яскравості, синій для клавіатури."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu nhấn cho âm lượng, vàng cho độ sáng, xanh lam cho bàn phím."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量用强调色，亮度用黄色，键盘用蓝色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量使用強調顏色，亮度使用黃色，鍵盤使用藍色。"
          }
        }
      }
    },
    "After the sound output changes, the next volume HUD shows the new device." : {
      "comment" : "Settings ▸ HUD: footnote under Show output device",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد تغيير إخراج الصوت، يعرض مؤشر مستوى الصوت الجهاز الجديد عند ظهوره التالي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan canviï la sortida de so, el següent indicador de volum mostrarà el dispositiu nou."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po změně zvukového výstupu ukáže další indikátor hlasitosti nové zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når enheden til lyd ud skifter, viser den næste lydstyrkeindikator den nye enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einem Wechsel der Tonausgabe zeigt das nächste Lautstärke-Overlay das neue Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά από αλλαγή της εξόδου ήχου, η επόμενη ένδειξη έντασης εμφανίζει τη νέα συσκευή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando cambia la salida de sonido, el siguiente indicador de volumen muestra el nuevo dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun äänen ulostulo vaihtuu, seuraava äänenvoimakkuuden ilmaisin näyttää uuden laitteen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après un changement de sortie audio, l’indicateur de volume suivant affiche le nouvel appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחרי החלפת התקן השמע היוצא, מחוון עוצמת הקול הבא יציג את ההתקן החדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ध्वनि आउटपुट बदलने के बाद अगला वॉल्यूम संकेतक नया डिवाइस दिखाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakon promjene izlaza zvuka sljedeći indikator glasnoće prikazat će novi uređaj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangkimenet váltása után a következő hangerő-szintjelző már az új eszközt mutatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah output bunyi berubah, indikator volume berikutnya menampilkan perangkat yang baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo un cambio dell’uscita audio, il successivo indicatore del volume mostra il nuovo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サウンド出力が変わると、次に表示される音量インジケータに新しいデバイスが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사운드 출력이 바뀌면 다음 음량 표시기에 새 기기가 나타납니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selepas output bunyi bertukar, penunjuk kelantangan seterusnya menunjukkan peranti baharu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når lydutgangen endres, viser neste volumindikator den nye enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na een wijziging van de geluidsuitvoer toont de volgende volume-indicator het nieuwe apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zmianie wyjścia dźwięku następna nakładka głośności pokaże nowe urządzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a saída de som mudar, o próximo indicador de volume mostrará o novo dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a saída de som muda, o próximo indicador de volume mostra o novo dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După schimbarea ieșirii audio, următorul indicator de volum afișează noul dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После смены аудиовыхода индикатор громкости покажет новое устройство."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zmene zvukového výstupu ukáže najbližší indikátor hlasitosti nové zariadenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko se zvočni izhod spremeni, naslednji indikator glasnosti pokaže novo napravo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När ljudutgången ändras visar nästa volymindikator den nya enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังจากเปลี่ยนสัญญาณเสียงออก ตัวแสดงระดับเสียงครั้งถัดไปจะแสดงอุปกรณ์ใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses çıkışı değiştikten sonra bir sonraki ses yüksekliği göstergesi yeni aygıtı gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після зміни виходу звуку наступний індикатор гучності покаже новий пристрій."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi đầu ra âm thanh thay đổi, chỉ báo âm lượng tiếp theo sẽ hiển thị thiết bị mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声音输出设备更改后，下一次出现的音量指示器会显示新设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聲音輸出變更後，下一次的音量指示器會顯示新裝置。"
          }
        }
      }
    },
    "Always shown with Differentiate without color." : {
      "comment" : "Settings ▸ HUD: footnote under Show value (macOS Accessibility ▸ Display setting)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر دائمًا عند تشغيل \"التمييز بدون لون\"."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre visible si “Diferencia sense color” està activat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při zapnuté volbě Odlišit bez barvy se zobrazuje vždy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vises altid, når “Differentier uden farve” er slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei „Ohne Farben differenzieren“ immer sichtbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζεται πάντα όταν είναι ενεργή η «Διαφοροποίηση χωρίς χρώμα»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre visible con “Diferenciar sin color”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näkyy aina, kun ”Erottele ilman väriä” on päällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours affichée avec « Différencier sans couleur »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוצג תמיד כש״הבחנה ללא צבע״ פעילה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“रंग के बिना अंतर करें” चालू होने पर हमेशा दिखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvijek se prikazuje kad je uključeno “Razgraniči bez boje”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindig látható, ha be van kapcsolva a „Differenciálás színek nélkül”."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selalu ditampilkan jika “Bedakan tanpa warna” menyala."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre visibile con “Differenzia senza colore”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“カラー以外で区別”がオンのときは常に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘색상 제외하고 구별’이 켜져 있으면 항상 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentiasa ditunjukkan apabila “Membezakan tanpa warna” diaktifkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vises alltid når «Differensier uten farger» er på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altijd zichtbaar als ‘Differentieer zonder kleur’ is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawsze widoczna, gdy włączona jest opcja „Różnicuj bez koloru”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre visível com Diferenciar sem cor ativado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre visível com “Distinguir sem cor”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișată întotdeauna când este activată opțiunea „Diferențiere fără culoare”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда виден, если включено «Дифференцировать без цвета»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri zapnutej funkcii Rozlíšiť bez farby sa zobrazuje vždy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrednost je vedno prikazana, ko je vklopljena možnost »Razlikuj brez barv«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visas alltid med ”Differentiera utan färg”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงเสมอเมื่อเปิด “แสดงความแตกต่างโดยไม่ใช้สี”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Renk olmadan farklılaştır” açıkken her zaman gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завжди показується, якщо ввімкнено «Розрізнення без кольору»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luôn hiển thị khi bật “Tạo sự khác biệt mà không có màu”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“无需用颜色区分”时始终显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「不以顏色來區分」時一律顯示。"
          }
        }
      }
    },
