        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब तक आप वहाँ इसे फिर से चालू नहीं करते, macOS अपना संकेतक दिखाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS prikazuje svoj indikator dok ga ondje ponovno ne uključite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amíg ott vissza nem kapcsolja, a macOS a saját szintjelzőjét mutatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS menampilkan indikatornya sendiri hingga Anda menyalakannya lagi di sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS mostra il proprio indicatore finché non lo riattivi lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ライブアクティビティ”でオンに戻すまで、macOSのインジケータが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘실시간 현황’에서 다시 켤 때까지 macOS 자체 표시기가 나타납니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS menunjukkan penunjuknya sendiri sehingga anda mengaktifkannya semula di sana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS viser sin egen indikator til du slår den på igjen der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS toont zijn eigen indicator totdat je die daar weer inschakelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopóki nie włączysz jej tam ponownie, macOS pokazuje własną nakładkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS mostra o próprio indicador até que você o reative lá."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS mostra o seu próprio indicador até o voltar a ativar aí."
          }
        },
        "ro" : {
          "stringUnit" : {
