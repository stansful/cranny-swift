    "Copies kept by the Tray are deleted. Your own files are not touched." : {
      "comment" : "Settings ▸ Tray: Clear confirmation message",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف النُّسَخ المحفوظة على الرف. لن يتم المساس بملفاتك الأصلية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’eliminaran les còpies que guarda la safata. Els teus arxius no es toquen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie uložené v přihrádce se smažou. Vašich vlastních souborů se to nedotkne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier, som hylden opbevarer, slettes. Dine egne filer berøres ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopien in der Ablage werden gelöscht. Deine eigenen Dateien bleiben unberührt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αντίγραφα που κρατά το ράφι διαγράφονται. Τα δικά σας αρχεία δεν επηρεάζονται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán las copias que guarda la bandeja. Tus archivos no se verán afectados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyllyn säilyttämät kopiot poistetaan. Omiin tiedostoihisi ei kosketa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies conservées par l’étagère seront supprimées. Vos propres fichiers ne seront pas touchés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העותקים שנשמרו על המדף יימחקו. הקבצים המקוריים שלך לא ישתנו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रे में रखी कॉपी डिलीट हो जाएँगी। आपकी अपनी फ़ाइलों को छुआ नहीं जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopije koje čuva polica bit će obrisane. Vaše datoteke ostaju netaknute."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A polcon tárolt másolatok törlődnek. Az Ön saját fájljai érintetlenek maradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan yang disimpan Rak akan dihapus. File Anda sendiri tetap utuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le copie conservate dal ripiano vengono eliminate. I tuoi file originali restano dove sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレイに保持されているコピーは削除されます。元のファイルはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선반에 보관된 사본이 삭제됩니다. 원본 파일은 그대로 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan yang disimpan oleh Rak akan dipadamkan. Fail anda sendiri tidak disentuh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiene på hyllen slettes. Dine egne filer berøres ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieën in de lade worden verwijderd. Je eigen bestanden blijven onaangeroerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie przechowywane na półce zostaną usunięte. Twoje pliki pozostaną nienaruszone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cópias guardadas pela Bandeja serão apagadas. Seus próprios arquivos não serão alterados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cópias guardadas pela bandeja são apagadas. Os seus ficheiros não são alterados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiile păstrate pe raft vor fi șterse. Fișierele dvs. rămân neatinse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копии на полке будут удалены. Ваши файлы останутся на месте."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kópie uložené na polici sa vymažú. Vaše vlastné súbory zostanú nedotknuté."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopije na polici bodo izbrisane. Vaše datoteke ostanejo nedotaknjene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiorna på hyllan raderas. Dina egna filer rörs inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำเนาที่ถาดเก็บไว้จะถูกลบ ไฟล์ของคุณเองจะไม่ได้รับผลกระทบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raf’taki kopyalar silinir. Kendi dosyalarınıza dokunulmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копії, які зберігає полиця, буде видалено. Ваших власних файлів це не торкнеться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bản sao do Khay giữ sẽ bị xóa. Tệp của bạn không bị ảnh hưởng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂存区保存的副本将被删除。你自己的文件不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "托盤保留的副本會被刪除，你原本的檔案不受影響。"
          }
        }
      }
    },
    "Copies stay even if the original is moved or deleted. Links take no space; screenshots and other temporary files are always copied." : {
      "comment" : "Settings ▸ Tray: footnote under Keep dropped files as",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى النُّسَخ حتى إذا تم نقل الأصل أو حذفه. لا تشغل الروابط أي مساحة؛ ويتم دائمًا نسخ لقطات الشاشة والملفات المؤقتة الأخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les còpies es mantenen encara que l’original es mogui o s’elimini. Els enllaços no ocupen espai; les captures de pantalla i altres arxius temporals sempre es copien."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie zůstanou, i když originál přesunete nebo smažete. Odkazy nezabírají místo; snímky obrazovky a jiné dočasné soubory se kopírují vždy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier bevares, selvom originalen flyttes eller slettes. Links fylder intet; skærmbilleder og andre midlertidige filer kopieres altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopien bleiben erhalten, auch wenn das Original bewegt oder gelöscht wird. Links belegen keinen Speicherplatz; Bildschirmfotos und andere temporäre Dateien werden immer kopiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αντίγραφα παραμένουν ακόμη κι αν το πρωτότυπο μετακινηθεί ή διαγραφεί. Οι σύνδεσμοι δεν καταλαμβάνουν χώρο. Τα στιγμιότυπα οθόνης και άλλα προσωρινά αρχεία αντιγράφονται πάντα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias se conservan aunque el original se mueva o se elimine. Los enlaces no ocupan espacio; las capturas de pantalla y otros archivos temporales siempre se copian."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiot säilyvät, vaikka alkuperäinen siirrettäisiin tai poistettaisiin. Linkit eivät vie tilaa; näyttökuvat ja muut väliaikaiset tiedostot kopioidaan aina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies restent même si l’original est déplacé ou supprimé. Les liens n’occupent pas d’espace ; les captures d’écran et autres fichiers temporaires sont toujours copiés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עותקים נשארים גם אם המקור מועבר או נמחק. קישורים לא תופסים מקום; צילומי מסך וקבצים זמניים אחרים תמיד מועתקים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मूल फ़ाइल मूव या डिलीट होने पर भी कॉपी बनी रहती हैं। लिंक कोई जगह नहीं लेते; स्क्रीनशॉट और अन्य अस्थायी फ़ाइलें हमेशा कॉपी की जाती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopije ostaju čak i ako se izvornik premjesti ili obriše. Poveznice ne zauzimaju prostor; snimke zaslona i druge privremene datoteke uvijek se kopiraju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A másolatok akkor is megmaradnak, ha az eredetit áthelyezik vagy törlik. A hivatkozások nem foglalnak helyet; a képernyőfotók és más ideiglenes fájlok mindig másolatként kerülnek a polcra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan tetap ada meskipun file asli dipindahkan atau dihapus. Tautan tidak memakan ruang; tangkapan layar dan file sementara lainnya selalu disalin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le copie restano anche se l’originale viene spostato o eliminato. I collegamenti non occupano spazio; gli screenshot e gli altri file temporanei vengono sempre copiati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーは、元のファイルが移動または削除されても残ります。リンクは容量を使用しません。スクリーンショットなどの一時ファイルは常にコピーされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사본은 원본을 이동하거나 삭제해도 남아 있습니다. 링크는 공간을 차지하지 않으며, 스크린샷 및 기타 임시 파일은 항상 복사됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan kekal walaupun fail asal dialihkan atau dipadamkan. Pautan tidak menggunakan ruang; gambar skrin dan fail sementara lain sentiasa disalin."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier blir værende selv om originalen flyttes eller slettes. Lenker tar ikke plass; skjermbilder og andre midlertidige filer kopieres alltid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieën blijven bestaan, ook als het origineel wordt verplaatst of verwijderd. Koppelingen nemen geen ruimte in; schermafbeeldingen en andere tijdelijke bestanden worden altijd gekopieerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie pozostają, nawet gdy oryginał zostanie przeniesiony lub usunięty. Łącza nie zajmują miejsca; zrzuty ekranu i inne pliki tymczasowe są zawsze kopiowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cópias continuam mesmo que o original seja movido ou apagado. Os links não ocupam espaço; capturas de tela e outros arquivos temporários são sempre copiados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cópias mantêm‑se mesmo que o original seja movido ou apagado. As ligações não ocupam espaço; as capturas de ecrã e outros ficheiros temporários são sempre copiados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiile rămân chiar dacă originalul este mutat sau șters. Linkurile nu ocupă spațiu; capturile de ecran și alte fișiere temporare sunt întotdeauna copiate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копии сохраняются, даже если оригинал переместят или удалят. Ссылки не занимают места; снимки экрана и другие временные файлы всегда копируются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kópie zostanú, aj keď sa originál presunie alebo vymaže. Odkazy nezaberajú miesto; snímky obrazovky a iné dočasné súbory sa vždy kopírujú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopije ostanejo, tudi če izvirnik premaknete ali izbrišete. Povezave ne zasedajo prostora; posnetki zaslona in druge začasne datoteke se vedno kopirajo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopior finns kvar även om originalet flyttas eller raderas. Länkar tar ingen plats; skärmavbilder och andra tillfälliga filer kopieras alltid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำเนาจะยังคงอยู่แม้ต้นฉบับจะถูกย้ายหรือลบ ลิงก์ไม่ใช้พื้นที่ ส่วนภาพถ่ายหน้าจอและไฟล์ชั่วคราวอื่นๆ จะถูกคัดลอกเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopyalar, orijinal taşınsa veya silinse bile kalır. Bağlantılar yer kaplamaz; ekran resimleri ve diğer geçici dosyalar her zaman kopyalanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копії зберігаються, навіть якщо оригінал переміщено чи видалено. Посилання не займають місця; знімки екрана й інші тимчасові файли завжди копіюються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao vẫn còn ngay cả khi tệp gốc bị di chuyển hoặc xóa. Liên kết không chiếm dung lượng; ảnh chụp màn hình và các tệp tạm khác luôn được sao chép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使原件被移动或删除，副本也会保留。链接不占用空间；截屏和其他临时文件始终会被拷贝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使原始檔案被移動或刪除，副本仍會保留。連結不佔空間；截圖和其他暫存檔一律會拷貝。"
          }
        }
      }
    },
