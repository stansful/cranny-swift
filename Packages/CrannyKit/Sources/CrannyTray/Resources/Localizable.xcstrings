    "While you drag files to the notch, and on the Tray page." : {
      "comment" : "Settings ▸ Tray: footnote under AirDrop zone",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثناء سحب الملفات إلى النتوء، وفي صفحة الرف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre arrossegues arxius a l’osca i a la pàgina Safata."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při přetahování souborů na výřez a na stránce Přihrádka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens du trækker filer til notchen, og på siden Hylde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während du Dateien zur Notch ziehst, und auf der Seite „Ablage“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσο σύρετε αρχεία στην εγκοπή, και στη σελίδα «Ράφι»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras arrastras archivos a la muesca y en la página “Bandeja”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun vedät tiedostoja loveen, ja Hylly-sivulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant que vous faites glisser des fichiers vers l’encoche, et sur la page Étagère."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בזמן גרירת קבצים אל המגרעת, ובעמוד המדף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप फ़ाइलें नॉच की ओर ड्रैग करते हैं, और ट्रे पृष्ठ पर।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dok povlačite datoteke prema izrezu i na stranici Polica."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amíg fájlokat húz a kivágáshoz, illetve a Polc oldalon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Anda menyeret file ke notch, dan di halaman Rak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre trascini i file sulla tacca e nella pagina Ripiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルをノッチにドラッグしている間と、トレイのページに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일을 노치로 드래그하는 동안, 그리고 선반 페이지에 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semasa anda menyeret fail ke takuk, dan pada halaman Rak."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens du drar filer til hakket, og på Hylle-siden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terwijl je bestanden naar de notch sleept, en op de pagina Lade."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas przeciągania plików do wycięcia i na stronie Półka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto você arrasta arquivos até o notch e na página Bandeja."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto arrasta ficheiros para o entalhe e na página Bandeja."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât timp trageți fișiere spre decupaj și pe pagina „Raft”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока вы перетаскиваете файлы к вырезу, и на странице «Полка»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počas ťahania súborov k výrezu a na stránke Polica."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med vlečenjem datotek na zarezo in na strani Polica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medan du drar filer till notchen, och på sidan Hylla."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขณะที่คุณลากไฟล์ไปที่รอยบาก และในหน้าถาด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyaları çentiğe sürüklerken ve Raf sayfasında."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки ви перетягуєте файли до вирізу, а також на сторінці «Полиця»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn kéo tệp đến tai thỏ, và trên trang Khay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你将文件拖向刘海时，以及在暂存区页面中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你將檔案拖移到瀏海時，以及在托盤頁面上顯示。"
          }
        }
      }
    },
    "While you drag files to the notch, pinned pipelines appear next to Keep in Tray and AirDrop. Drop files on one to run it." : {
      "comment" : "Settings ▸ Tray: footnote under Pinned pipelines",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثناء سحب الملفات إلى النتوء، تظهر السلاسل المثبّتة بجوار \"إضافة إلى الرف\" و\"الإرسال السريع\". أفلت الملفات على إحداها لتشغيلها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre arrossegues arxius a l’osca, les cadenes fixades apareixen al costat de “Deixa a la safata” i de l’AirDrop. Deixa anar arxius en una cadena per executar‑la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při přetahování souborů na výřez se připnuté postupy zobrazují vedle zón Nechat v přihrádce a AirDrop. Pusťte soubory na postup a spustíte ho."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens du trækker filer til notchen, vises fastgjorte handlingskæder ved siden af “Læg på hylden” og AirDrop. Slip filer på en af dem for at køre den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während du Dateien zur Notch ziehst, erscheinen angepinnte Abläufe neben „In der Ablage behalten“ und AirDrop. Lege Dateien auf einem ab, um ihn auszuführen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσο σύρετε αρχεία στην εγκοπή, οι καρφιτσωμένες αλυσίδες εμφανίζονται δίπλα στις ζώνες «Διατήρηση στο ράφι» και AirDrop. Αφήστε αρχεία πάνω σε μια αλυσίδα για να την εκτελέσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras arrastras archivos a la muesca, los flujos fijados aparecen junto a “Dejar en la bandeja” y AirDrop. Suelta archivos en uno para ejecutarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun vedät tiedostoja loveen, kiinnitetyt työnkulut näkyvät AirDrop-alueen ja ”Pidä hyllyllä” -alueen vieressä. Suorita työnkulku pudottamalla tiedostot sen päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant que vous faites glisser des fichiers vers l’encoche, les chaînes épinglées apparaissent à côté de « Garder sur l’étagère » et d’AirDrop. Déposez des fichiers sur l’une d’elles pour l’exécuter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בזמן גרירת קבצים אל המגרעת, תהליכים מוצמדים מופיעים לצד ״שמירה על המדף״ ו-AirDrop. כדי להריץ תהליך, יש לשחרר עליו את הקבצים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप फ़ाइलें नॉच की ओर ड्रैग करते हैं, तो पिन की गई पाइपलाइन “ट्रे में रखें” और AirDrop के बगल में दिखती हैं। किसी पाइपलाइन को चलाने के लिए फ़ाइलें उस पर ड्रॉप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dok povlačite datoteke prema izrezu, zakvačeni cjevovodi prikazuju se pokraj zona “Zadrži na polici” i AirDrop. Ispustite datoteke na cjevovod da biste ga pokrenuli."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amíg fájlokat húz a kivágáshoz, a kitűzött műveletsorok a „Megtartás a polcon” és az AirDrop mellett jelennek meg. A futtatáshoz húzza a fájlokat valamelyikre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Anda menyeret file ke notch, alur yang dipin muncul di sebelah “Simpan di Rak” dan AirDrop. Lepaskan file di salah satunya untuk menjalankannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre trascini i file sulla tacca, le sequenze fissate appaiono accanto a “Tieni sul ripiano” e AirDrop. Rilascia i file su una sequenza per eseguirla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルをノッチにドラッグしている間、固定したパイプラインが“トレイに保持”とAirDropの横に表示されます。ファイルをパイプラインにドロップすると実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일을 노치로 드래그하는 동안 고정된 파이프라인이 ‘선반에 보관’ 및 AirDrop 옆에 나타납니다. 파이프라인에 파일을 놓으면 실행됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semasa anda menyeret fail ke takuk, aliran kerja yang dipinkan muncul di sebelah “Simpan di Rak” dan AirDrop. Lepaskan fail pada salah satunya untuk menjalankannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens du drar filer til hakket, vises festede arbeidsflyter ved siden av «Legg på hyllen» og AirDrop. Slipp filer på en av dem for å kjøre den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terwijl je bestanden naar de notch sleept, verschijnen vastgemaakte werkstromen naast ‘Bewaar in lade’ en AirDrop. Zet bestanden op een werkstroom neer om die uit te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas przeciągania plików do wycięcia przypięte potoki pojawiają się obok stref „Zostaw na półce” i AirDrop. Upuść pliki na potok, aby go uruchomić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto você arrasta arquivos até o notch, os fluxos fixados aparecem ao lado de Manter na Bandeja e AirDrop. Solte arquivos em um deles para executá-lo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto arrasta ficheiros para o entalhe, as sequências afixadas aparecem junto a “Manter na bandeja” e AirDrop. Largue ficheiros numa delas para a executar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât timp trageți fișiere spre decupaj, fluxurile fixate apar lângă „Păstrați pe raft” și AirDrop. Plasați fișierele pe unul dintre ele pentru a‑l rula."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока вы перетаскиваете файлы к вырезу, закреплённые конвейеры появляются рядом с «Оставить на полке» и AirDrop. Перетащите файлы на конвейер, чтобы запустить его."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počas ťahania súborov k výrezu sa pripnuté postupy zobrazia vedľa zón Ponechať na polici a AirDrop. Pustením súborov na postup ho spustíte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med vlečenjem datotek na zarezo se pripeti cevovodi prikažejo poleg »Obdrži na polici« in AirDrop. Spustite datoteke na cevovod, da ga zaženete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medan du drar filer till notchen visas fästa flöden bredvid ”Lägg på hyllan” och AirDrop. Släpp filer på ett flöde för att köra det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขณะที่คุณลากไฟล์ไปที่รอยบาก ไปป์ไลน์ที่ปักหมุดจะแสดงข้าง “เก็บไว้ในถาด” และ AirDrop วางไฟล์บนไปป์ไลน์เพื่อเรียกใช้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyaları çentiğe sürüklerken sabitlenmiş iş akışları “Raf’ta tut” ve AirDrop’un yanında görünür. Çalıştırmak için dosyaları birinin üzerine bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки ви перетягуєте файли до вирізу, закріплені конвеєри зʼявляються поруч із «Залишити на полиці» та AirDrop. Перетягніть файли на конвеєр, щоб запустити його."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn kéo tệp đến tai thỏ, các quy trình đã ghim xuất hiện bên cạnh “Giữ trong Khay” và AirDrop. Thả tệp vào một quy trình để chạy quy trình đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将文件拖向刘海时，固定的处理流程会显示在“保留在暂存区”和“隔空投送”旁边。将文件拖到某个处理流程上即可运行它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你將檔案拖移到瀏海時，已釘選的流程會顯示在「保留在托盤」和AirDrop旁。將檔案拖放到流程上即可執行。"
          }
        }
      }
    },
