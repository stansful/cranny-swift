    "Results of files the Tray keeps a copy of go to Downloads." : {
      "comment" : "Settings ▸ Tray: footnote under Save results",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ نتائج الملفات التي يحتفظ الرف بنسخة منها في \"التنزيلات\"."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la safata guarda una còpia d’un arxiu, el resultat es desa a Descàrregues."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výsledky souborů, jejichž kopii přihrádka uchovává, se ukládají do složky Stahování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultater af filer, som hylden har en kopi af, gemmes i Overførsler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ergebnisse von Dateien, von denen die Ablage eine Kopie hat, landen in „Downloads“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αποτελέσματα για αρχεία των οποίων το ράφι κρατά αντίγραφο αποθηκεύονται στις «Λήψεις»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la bandeja guarda una copia del archivo, el resultado va a Descargas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulokset tiedostoista, joista hylly säilyttää kopion, tallennetaan Lataukset-kansioon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résultats des fichiers dont l’étagère garde une copie vont dans Téléchargements."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התוצאות של קבצים שהמדף שומר עותק שלהם נשמרות בתיקיה ״הורדות״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन फ़ाइलों की कॉपी ट्रे में रखी जाती है, उनके परिणाम डाउनलोड फ़ोल्डर में जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezultati za datoteke čije kopije čuva polica spremaju se u Preuzimanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A polcon másolatként tárolt fájlok eredményei a Letöltések mappába kerülnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
