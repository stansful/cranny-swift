    "The camera turns on only when you click the widget and turns off when Cranny closes." : {
      "comment" : "Mirror options: footnote under the camera and mirroring rows",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تعمل الكاميرا إلا عند النقر على الأداة، وتتوقف عند إغلاق Cranny."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La càmera només s’activa quan fas clic al giny i es desactiva quan el Cranny es tanca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera se zapne, jen když kliknete na widget, a vypne se, když se Cranny zavře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraet tændes kun, når du klikker på widgetten, og slukkes, når Cranny lukker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera schaltet sich nur ein, wenn du auf das Widget klickst, und aus, wenn Cranny geschlossen wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κάμερα ενεργοποιείται μόνο όταν κάνετε κλικ στο widget και απενεργοποιείται όταν κλείνει το Cranny."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara solo se activa cuando haces clic en el widget y se desactiva cuando Cranny se cierra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera käynnistyy vain, kun klikkaat widgetiä, ja sammuu, kun Cranny sulkeutuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La caméra ne s’allume que lorsque vous cliquez sur le widget, et s’éteint à la fermeture de Cranny."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המצלמה נדלקת רק בלחיצה על הווידג׳ט, ונכבית כש-Cranny נסגר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैमरा तभी चालू होता है जब आप विजेट पर क्लिक करते हैं, और Cranny बंद होने पर बंद हो जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera se uključuje samo kad kliknete widget i isključuje se kad se Cranny zatvori."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kamera csak akkor kapcsol be, ha a widgetre kattint, és kikapcsol, amikor a Cranny bezárul."
          }
        },
        "id" : {
          "stringUnit" : {
