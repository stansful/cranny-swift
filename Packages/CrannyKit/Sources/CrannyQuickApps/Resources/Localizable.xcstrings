    "Couldn’t read your shortcuts." : {
      "comment" : "Quick Apps: error when the list of Shortcuts.app shortcuts cannot be read",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة اختصاراتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’han pogut llegir les dreceres."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkratky se nepodařilo načíst."
          }
        },
