    "GitHub answered with an error (%lld). Try again later." : {
      "comment" : "Update check: failure reason, other HTTP status; the number is the status code",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub ответил ошибкой (%lld). Попробуйте позже."
          }
        }
      }
    },
    "GitHub couldn’t be reached. Check your internet connection and try again." : {
      "comment" : "Update check: failure reason, network error",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
