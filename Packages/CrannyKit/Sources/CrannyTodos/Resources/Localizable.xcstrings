    "Space checks it, Return edits it, Command-Up and Command-Down move it." : {
      "comment" : "To-dos widget: VoiceOver hint on a to-do (its keyboard shortcuts)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على المسافة لتمييزها كمكتملة، وعلى Return لتعديلها، وعلى Command مع السهم لأعلى أو لأسفل لنقلها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra espaiadora la marca, la tecla de retorn l’edita i la tecla d’ordre + fletxa amunt o avall la mou."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezerníkem úkol odškrtnete, klávesou Return ho upravíte a klávesami Command-šipka nahoru a Command-šipka dolů ho přesunete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mellemrum markerer den, Retur redigerer den, og Kommando-pil op og Kommando-pil ned flytter den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leertaste hakt sie ab, Zeilenschalter bearbeitet sie, Command-Taste mit Aufwärts- oder Abwärtspfeil bewegt sie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάστημα: σήμανση, Return: επεξεργασία, Command-Πάνω βέλος και Command-Κάτω βέλος: μετακίνηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espacio la marca, Retorno la edita y Comando + Flecha arriba o Comando + Flecha abajo la mueven."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välilyönti merkitsee sen tehdyksi, Return muokkaa sitä, Komento-ylänuoli ja Komento-alanuoli siirtävät sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espace la coche, Retour la modifie, Commande + Flèche vers le haut et Commande + Flèche vers le bas la déplacent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רווח מסמן, Return עורך, Command-חץ למעלה ו-Command-חץ למטה מזיזים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्पेस इसे चिह्नित करता है, Return इसे संपादित करता है, Command-ऊपर और Command-नीचे इसे मूव करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razmaknica ga označava, Return ga uređuje, a Command sa strelicom gore ili dolje premješta ga."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Szóköz kipipálja, a Return szerkeszti, a Command–Felfelé nyíl és a Command–Lefelé nyíl mozgatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spasi mencentangnya, Return mengeditnya, Command-Panah Atas dan Command-Panah Bawah memindahkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio la spunta, A capo la modifica, Comando-Freccia su e Comando-Freccia giù la spostano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スペースキーでチェック、Returnキーで編集、Command＋上下矢印キーで移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space 키로 완료 표시, Return 키로 편집, Command-위쪽 화살표 및 Command-아래쪽 화살표로 이동합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space menandakannya, Return mengeditnya, Command-Atas dan Command-Bawah mengalihkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mellomrom huker av, Retur redigerer, Kommando-pil opp og Kommando-pil ned flytter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spatie vinkt aan, Return wijzigt, Command-pijl-omhoog en Command-pijl-omlaag verplaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spacja zaznacza, Return edytuje, Command-strzałka w górę i Command-strzałka w dół przenoszą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaço marca, Return edita, Command + Seta para Cima e Command + Seta para Baixo movem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaço marca‑a, Return edita‑a, Comando + seta para cima e Comando + seta para baixo movem‑na."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spațiu o bifează, Retur o editează, Comandă‑săgeată sus și Comandă‑săgeată jos o mută."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пробел отмечает, Return изменяет, Command-стрелки вверх и вниз перемещают."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medzerník ju označí, Return ju upraví, Command-šípka nahor a Command-šípka nadol ju presunú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preslednica ga označi, Return ga uredi, Command-puščica gor in Command-puščica dol ga premakneta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mellanslag bockar av, Retur redigerar, kommando-uppåtpil och kommando-nedåtpil flyttar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กด Space เพื่อทำเครื่องหมาย กด Return เพื่อแก้ไข กด Command-ลูกศรขึ้นหรือ Command-ลูกศรลงเพื่อย้าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boşluk işaretler, Return düzenler, Komut-Yukarı Ok ve Komut-Aşağı Ok taşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пробіл позначає, Return редагує, Command зі стрілкою вгору або вниз переміщує."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím cách để đánh dấu, Return để sửa, Command-Mũi tên lên và Command-Mũi tên xuống để di chuyển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按空格键勾选，按Return键编辑，按Command-上箭头和Command-下箭头移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
