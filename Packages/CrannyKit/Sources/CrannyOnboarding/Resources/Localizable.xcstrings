        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre musique, votre calendrier, vos fichiers et vos raccourcis vivent dans l’encoche, à portée de regard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המוזיקה, לוח השנה, הקבצים והקיצורים שלך נמצאים במגרעת, במרחק מבט."
