    "Updates are only checked, never installed. Nothing else uses the network." : {
      "comment" : "Welcome step 6: footnote under the switches",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم التحقق من التحديثات فقط، ولا يتم تثبيتها أبدًا. لا شيء آخر يستخدم الشبكة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només es cerquen actualitzacions, no s’instal·len mai. Res més no fa servir la xarxa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizace se jen vyhledávají, nikdy se neinstalují. Nic jiného síť nepoužívá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der søges kun efter opdateringer – de installeres aldrig. Intet andet bruger netværket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates werden nur gesucht, nie installiert. Sonst nutzt nichts das Netzwerk."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ενημερώσεις μόνο ελέγχονται, δεν εγκαθίστανται ποτέ. Τίποτα άλλο δεν χρησιμοποιεί το δίκτυο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se buscan actualizaciones, nunca se instalan. Ninguna otra función usa la red."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivitykset vain tarkistetaan, niitä ei koskaan asenneta. Mikään muu ei käytä verkkoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour sont seulement recherchées, jamais installées. Rien d’autre n’utilise le réseau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדכונים רק נבדקים, ולעולם אינם מותקנים. שום דבר אחר לא משתמש ברשת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपडेट केवल जाँचे जाते हैं, कभी इंस्टॉल नहीं किए जाते। इसके अलावा कुछ भी नेटवर्क का उपयोग नहीं करता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ažuriranja se samo provjeravaju, nikad ne instaliraju. Ništa drugo ne koristi mrežu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Cranny csak keresi a frissítéseket, de sosem telepíti őket. Semmi más nem használja a hálózatot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembaruan hanya diperiksa, tidak pernah diinstal. Tidak ada hal lain yang menggunakan jaringan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti vengono solo verificati, mai installati. Nient’altro usa la rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートは確認するだけで、インストールはしません。それ以外にネットワークは使用しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트는 확인만 하고 설치하지 않습니다. 그 외에는 네트워크를 사용하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemas kini hanya disemak, tidak sekali-kali dipasang. Tiada perkara lain yang menggunakan rangkaian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny ser bare etter oppdateringer og installerer dem aldri. Ingenting annet bruker nettverket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt alleen naar updates gezocht; ze worden nooit geïnstalleerd. Verder gebruikt niets het netwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny tylko sprawdza, czy są uaktualnienia, i nigdy ich nie instaluje. Nic innego nie korzysta z sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As atualizações são apenas verificadas, nunca instaladas. Nada mais usa a rede."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As atualizações só são procuradas, nunca instaladas. Nada mais usa a rede."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizările sunt doar căutate, niciodată instalate. Nimic altceva nu folosește rețeaua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновления только проверяются, но не устанавливаются. Больше ничто не обращается к сети."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizácie sa len vyhľadávajú, nikdy sa neinštalujú. Nič iné sieť nepoužíva."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posodobitve se samo preverjajo, nikoli pa se ne nameščajo. Nič drugega ne uporablja omrežja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny letar bara efter uppdateringar och installerar dem aldrig. Inget annat använder nätverket."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะตรวจหารายการอัปเดตเท่านั้นโดยไม่ติดตั้ง และไม่มีส่วนอื่นใดใช้เครือข่าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncellemeler yalnızca denetlenir, hiçbir zaman yüklenmez. Ağı başka hiçbir şey kullanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлення лише перевіряються, але не встановлюються. Ніщо інше не звертається до мережі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny chỉ kiểm tra bản cập nhật, không bao giờ tự cài đặt. Ngoài việc này, Cranny không dùng đến mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅检查更新，绝不安装。其他功能都不会联网。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會檢查更新項目，絕不會自動安裝。其他功能都不會使用網路。"
          }
        }
      }
    },
