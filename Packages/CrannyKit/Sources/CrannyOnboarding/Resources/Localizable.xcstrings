    "On displays without a notch, Cranny floats just under the menu bar." : {
      "comment" : "Welcome step 1: note shown on Macs whose display has no camera notch",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على شاشات العرض التي لا تحتوي على نتوء، يطفو Cranny أسفل شريط القوائم مباشرة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A les pantalles sense osca, el Cranny sura just a sota de la barra de menús."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na monitorech bez výřezu se Cranny vznáší těsně pod řádkem nabídek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På skærme uden notch svæver Cranny lige under menulinjen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Displays ohne Notch schwebt Cranny direkt unter der Menüleiste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε οθόνες χωρίς εγκοπή, το Cranny αιωρείται ακριβώς κάτω από τη γραμμή μενού."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pantallas sin muesca, Cranny flota justo debajo de la barra de menús."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytöillä, joissa ei ole lovea, Cranny leijuu heti valikkorivin alapuolella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur les écrans sans encoche, Cranny flotte juste sous la barre des menus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בצגים ללא מגרעת, Cranny מרחף ממש מתחת לשורת התפריטים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना नॉच वाले डिस्प्ले पर Cranny मेन्यू बार के ठीक नीचे तैरता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na zaslonima bez izreza Cranny lebdi odmah ispod trake s izbornicima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kivágás nélküli kijelzőkön a Cranny közvetlenül a menüsor alatt lebeg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di layar tanpa notch, Cranny melayang tepat di bawah bar menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugli schermi senza tacca, Cranny fluttua appena sotto la barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチのないディスプレイでは、Crannyはメニューバーのすぐ下に浮かんで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치가 없는 디스플레이에서는 Cranny가 메뉴 막대 바로 아래에 떠 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
