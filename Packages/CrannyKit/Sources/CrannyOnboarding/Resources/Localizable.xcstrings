    "Put two fingers on the trackpad and swipe over the notch above. It’s only practice." : {
      "comment" : "Welcome step 3: sentence under the headline",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع إصبعين على لوحة التعقب واسحب فوق النتوء أعلاه. إنه مجرد تدريب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posa dos dits al trackpad i llisca per sobre de l’osca de dalt. És només per practicar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položte dva prsty na trackpad a přejeďte přes výřez nahoře. Je to jen cvičení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placer to fingre på pegefeltet, og skub hen over notchen ovenfor. Det er kun en øvelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege zwei Finger auf das Trackpad und streiche über die Notch oben. Das ist nur eine Übung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλτε δύο δάχτυλα στην επιφάνεια αφής και σαρώστε πάνω στην εγκοπή που βλέπετε παραπάνω. Είναι μόνο εξάσκηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon dos dedos en el trackpad y desliza sobre la muesca de arriba. Es solo para practicar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta kaksi sormea ohjauslevylle ja pyyhkäise yllä olevan loven kohdalla. Tämä on vain harjoitus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez deux doigts sur le trackpad et balayez sur l’encoche ci-dessus. Ce n’est qu’un entraînement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הניחו שתי אצבעות על משטח המגע והחליקו מעל המגרעת שלמעלה. זה רק תרגול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रैकपैड पर दो उंगलियाँ रखें और ऊपर दिखे नॉच पर स्वाइप करें। यह सिर्फ़ अभ्यास है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stavite dva prsta na dodirnu površinu i povucite preko izreza iznad. Ovo je samo vježba."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegye két ujját a trackpadre, és legyintsen a fenti kivágás fölött. Ez csak gyakorlás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan dua jari di trackpad dan gesek pada notch di atas. Ini hanya latihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appoggia due dita sul trackpad e scorri sulla tacca qui sopra. È solo una prova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラックパッドに2本指を置いて、上のノッチでスワイプしてください。ただの練習です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트랙패드에 두 손가락을 올리고, 위에 보이는 노치에서 쓸어넘기십시오. 연습일 뿐입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan dua jari pada trackpad dan leret pada takuk di atas. Ini hanya latihan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg to fingre på styreflaten og sveip over hakket ovenfor. Det er bare for å øve."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg twee vingers op het trackpad en veeg over de notch hierboven. Het is maar een oefening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połóż dwa palce na gładziku i przesuń nimi nad wycięciem powyżej. To tylko ćwiczenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque dois dedos no trackpad e deslize sobre o notch acima. É só um treino."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque dois dedos no trackpad e deslize sobre o entalhe acima. É só para treinar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puneți două degete pe trackpad și glisați peste decupajul de mai sus. Este doar un exercițiu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положите два пальца на трекпад и смахните над вырезом выше. Это просто тренировка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položte dva prsty na trackpad a potiahnite nimi nad výrezom vyššie. Je to len cvičenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položite dva prsta na sledilno ploščico in podrsnite čez zarezo zgoraj. To je samo vaja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg två fingrar på styrplattan och svep över notchen ovanför. Det är bara övning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางสองนิ้วบนแทร็คแพดแล้วปัดเหนือรอยบากด้านบน นี่เป็นเพียงการฝึกเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki parmağınızı izleme dörtgenine koyun ve yukarıdaki çentiğin üzerinde kaydırın. Bu yalnızca bir alıştırma."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покладіть два пальці на трекпед і змахніть над вирізом угорі. Це лише тренування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt hai ngón tay lên bàn di chuột và vuốt qua tai thỏ ở trên. Đây chỉ là tập thử."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将两个手指放在触控板上，在上方的刘海上轻扫。这只是练习。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將兩指放在觸控式軌跡板上，並在上方的瀏海處滑動。這只是練習。"
          }
        }
      }
    },
