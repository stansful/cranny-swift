          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På skärmar utan notch svävar Cranny precis under menyraden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บนจอภาพที่ไม่มีรอยบาก Cranny จะลอยอยู่ใต้แถบเมนู"
