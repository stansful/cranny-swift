    "Your music, calendar, files and shortcuts live in the notch, one glance away." : {
      "comment" : "Welcome: one sentence about what Cranny does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موسيقاك وتقويمك وملفاتك واختصاراتك في النتوء، على بُعد نظرة واحدة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La música, el calendari, els arxius i les dreceres viuen a l’osca, a un cop d’ull."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše hudba, kalendář, soubory a zkratky jsou ve výřezu – stačí se podívat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din musik, kalender, filer og genveje bor i notchen – kun et blik væk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Musik, dein Kalender, deine Dateien und Kurzbefehle wohnen in der Notch – nur einen Blick entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μουσική, το ημερολόγιο, τα αρχεία και οι συντομεύσεις σας βρίσκονται στην εγκοπή, σε απόσταση μιας ματιάς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu música, tu calendario, tus archivos y tus atajos, en la muesca y siempre a la vista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musiikkisi, kalenterisi, tiedostosi ja pikakomentosi ovat lovessa vilkaisun päässä."
