          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På skjermer uten hakk svever Cranny rett under menylinjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op beeldschermen zonder notch zweeft Cranny net onder de menubalk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
