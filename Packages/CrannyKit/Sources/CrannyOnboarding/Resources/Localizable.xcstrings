    "Open Cranny, pin it with the pin button, then press Esc" : {
      "comment" : "Tutorial step 5 while Cranny is closed; followed by the Esc key cap",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح Cranny، وثبّته بزر التثبيت، ثم اضغط على Esc"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre el Cranny, fixa’l amb el botó de fixar i prem Esc"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete Cranny, připněte ho tlačítkem připnutí a pak stiskněte Esc"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn Cranny, fastgør den med knappen Fastgør, og tryk derefter på Esc"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
