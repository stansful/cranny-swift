          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby se Cranny otevíral při přihlášení, povolte ho v Nastavení systému mezi položkami přihlášení."
          }
        },
        "da" : {
          "stringUnit" : {
