    "Show the battery of every Bluetooth device. Cranny never connects to them." : {
      "comment" : "Welcome step 5: fallback reason for the Bluetooth permission",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار مستوى شحن البطارية لكل أجهزة Bluetooth. لا يتصل Cranny بها أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra el nivell de bateria de tots els dispositius Bluetooth. El Cranny no s’hi connecta mai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazovat stav baterie všech zařízení Bluetooth. Cranny se k nim nikdy nepřipojuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis batteriniveauet for alle Bluetooth-enheder. Cranny opretter aldrig forbindelse til dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Batteriestand jedes Bluetooth-Geräts anzeigen. Cranny verbindet sich nie mit ihnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση της στάθμης μπαταρίας κάθε συσκευής Bluetooth. Το Cranny δεν συνδέεται ποτέ σε αυτές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar el nivel de batería de cada dispositivo Bluetooth. Cranny nunca se conecta a ellos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää kaikkien Bluetooth-laitteiden akun varaustason. Cranny ei koskaan muodosta niihin yhteyttä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher le niveau de batterie de chaque appareil Bluetooth. Cranny ne s’y connecte jamais."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת רמת הסוללה של כל מכשיר Bluetooth. Cranny לעולם אינו מתחבר אליהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर Bluetooth डिवाइस की बैटरी दिखाएँ। Cranny कभी उनसे कनेक्ट नहीं करता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaz razine baterije svih Bluetooth uređaja. Cranny se nikad ne povezuje s njima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden Bluetooth-eszköz akkumulátorszintjének megjelenítése. A Cranny soha nem csatlakozik hozzájuk."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan baterai setiap perangkat Bluetooth. Cranny tidak pernah terhubung ke perangkat tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il livello della batteria di ogni dispositivo Bluetooth. Cranny non vi si connette mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのBluetoothデバイスのバッテリー残量を表示します。Crannyがデバイスに接続することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 Bluetooth 기기의 배터리 잔량을 표시합니다. Cranny는 기기에 연결하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan paras bateri setiap peranti Bluetooth. Cranny tidak sekali-kali menyambung ke peranti tersebut."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser batterinivået til alle Bluetooth-enheter. Cranny kobler seg aldri til dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont het batterijniveau van elk Bluetooth-apparaat. Cranny maakt er nooit verbinding mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazywanie poziomu baterii każdego urządzenia Bluetooth. Cranny nigdy się z nimi nie łączy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar o nível de bateria de cada dispositivo Bluetooth. O Cranny nunca se conecta a eles."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar a bateria de todos os dispositivos Bluetooth. O Cranny nunca se liga a eles."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișarea nivelului bateriei pentru fiecare dispozitiv Bluetooth. Cranny nu se conectează niciodată la ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать заряд всех Bluetooth-устройств. Cranny никогда к ним не подключается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazovať stav batérie každého zariadenia Bluetooth. Cranny sa k nim nikdy nepripája."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaz stanja baterije vseh naprav Bluetooth. Cranny se z njimi nikoli ne poveže."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa batterinivån för alla Bluetooth-enheter. Cranny ansluter aldrig till dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงแบตเตอรี่ของอุปกรณ์บลูทูธทุกเครื่อง Cranny จะไม่เชื่อมต่อกับอุปกรณ์เหล่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm Bluetooth aygıtlarının pil düzeyini göstermek için. Cranny onlara hiçbir zaman bağlanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати заряд усіх Bluetooth-пристроїв. Cranny ніколи до них не підключається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị mức pin của mọi thiết bị Bluetooth. Cranny không bao giờ kết nối với chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示每个蓝牙设备的电量。Cranny绝不会连接它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示每個藍牙裝置的電量。Cranny絕不會連接這些裝置。"
          }
        }
      }
    },
    "Show volume and brightness in the notch instead of the system HUD. Cranny reads no other keys." : {
      "comment" : "Welcome step 5: fallback reason for the Accessibility permission",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار مستوى الصوت والإضاءة في النتوء بدلًا من مؤشر المستوى في النظام. لا يقرأ Cranny أي مفاتيح أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra el volum i la brillantor a l’osca en lloc de l’indicador del sistema. El Cranny no llegeix cap altra tecla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazovat hlasitost a jas ve výřezu místo systémového indikátoru. Žádné jiné klávesy Cranny nečte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis lydstyrke og lysstyrke i notchen i stedet for systemets indikator. Cranny læser ingen andre taster."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautstärke und Helligkeit in der Notch statt im System-Overlay anzeigen. Cranny liest keine anderen Tasten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση έντασης και φωτεινότητας στην εγκοπή αντί για την ένδειξη του συστήματος. Το Cranny δεν διαβάζει άλλα πλήκτρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar el volumen y el brillo en la muesca en lugar del indicador del sistema. Cranny no lee ninguna otra tecla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää äänenvoimakkuuden ja kirkkauden lovessa järjestelmän ilmaisimen sijaan. Cranny ei lue muita näppäimiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher le volume et la luminosité dans l’encoche au lieu de l’indicateur système. Cranny ne lit aucune autre touche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת עוצמת הקול והבהירות במגרעת במקום המחוון של המערכת. Cranny לא קורא שום מקש אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम संकेतक के बजाय नॉच में वॉल्यूम और ब्राइटनेस दिखाएँ। Cranny कोई और कीज़ नहीं पढ़ता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaz glasnoće i svjetline u izrezu umjesto indikatora sustava. Cranny ne čita nijednu drugu tipku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangerő és a fényerő megjelenítése a kivágásban a rendszer szintjelzője helyett. A Cranny más billentyűket nem olvas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan volume dan kecerahan di notch, bukan indikator sistem. Cranny tidak membaca tombol lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra volume e luminosità nella tacca al posto dell’indicatore di sistema. Cranny non legge altri tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムのインジケータの代わりに、ノッチに音量と輝度を表示します。Crannyがほかのキーを読み取ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 표시기 대신 노치에 음량과 밝기를 표시합니다. Cranny는 다른 키를 읽지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan kelantangan dan kecerahan pada takuk, menggantikan penunjuk sistem. Cranny tidak membaca kekunci lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser volum og lysstyrke i hakket i stedet for systemindikatoren. Cranny leser ingen andre taster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont volume en helderheid in de notch in plaats van de systeemindicator. Cranny leest geen andere toetsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazywanie głośności i jasności w wycięciu zamiast systemowej nakładki. Cranny nie odczytuje innych klawiszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar volume e brilho no notch em vez do indicador do sistema. O Cranny não lê nenhuma outra tecla."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar o volume e o brilho no entalhe em vez do indicador do sistema. O Cranny não lê mais nenhuma tecla."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișarea volumului și a luminozității în decupaj în locul indicatorului sistemului. Cranny nu citește alte taste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать громкость и яркость в вырезе вместо системного индикатора. Другие клавиши Cranny не читает."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazovať hlasitosť a jas vo výreze namiesto systémového indikátora. Iné klávesy Cranny nečíta."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaz glasnosti in svetlosti v zarezi namesto sistemskega indikatorja. Cranny ne bere drugih tipk."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa volym och ljusstyrka i notchen i stället för systemets indikator. Cranny läser inga andra tangenter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงระดับเสียงและความสว่างที่รอยบากแทนตัวแสดงระดับของระบบ Cranny จะไม่อ่านปุ่มอื่นใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses yüksekliğini ve parlaklığı sistem göstergesi yerine çentikte göstermek için. Cranny başka hiçbir tuşu okumaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати гучність і яскравість у вирізі замість системного індикатора. Cranny не зчитує інших клавіш."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị âm lượng và độ sáng trên tai thỏ thay cho chỉ báo của hệ thống. Cranny không đọc phím nào khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在刘海中显示音量和亮度，取代系统指示器。Cranny不会读取其他任何按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在瀏海中顯示音量和亮度，取代系統指示器。Cranny不會讀取其他按鍵。"
          }
        }
      }
