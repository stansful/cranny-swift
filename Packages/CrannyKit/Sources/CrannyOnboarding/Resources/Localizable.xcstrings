        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका संगीत, कैलेंडर, फ़ाइलें और शॉर्टकट नॉच में रहते हैं, बस एक नज़र की दूरी पर।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša glazba, kalendar, datoteke i prečaci smješteni su u izrezu – dovoljan je jedan pogled."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A zenéje, a naptára, a fájljai és a parancsai mind ott vannak a kivágásban, egy pillantásnyira."
