    "To open at login, allow Cranny under Login Items in System Settings." : {
      "comment" : "Welcome step 6: footnote when macOS waits for the login item to be approved",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للفتح عند تسجيل الدخول، اسمح لـ Cranny في \"عناصر تسجيل الدخول\" في إعدادات النظام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
