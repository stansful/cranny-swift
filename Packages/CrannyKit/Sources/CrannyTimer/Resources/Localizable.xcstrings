  "strings" : {
    "%@ left" : {
      "comment" : "Timer: VoiceOver value, time left, e.g. “4 minutes, 59 seconds left”",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осталось %@"
          }
        }
      }
    },
    "%@ left, ends %@" : {
      "comment" : "Timer widget: VoiceOver value of a running timer, e.g. “4 minutes, 59 seconds left, ends 14:35”",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ left, ends %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осталось %1$@, конец в %2$@"
          }
        }
      }
    },
