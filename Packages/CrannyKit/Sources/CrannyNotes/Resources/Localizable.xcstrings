    "New characters appear in the accent color, then settle." : {
      "comment" : "Widget options: footnote under the Notes typing effect toggle",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الأحرف الجديدة باللون الثانوي، ثم تعود إلى لونها العادي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els caràcters nous apareixen amb el color de contrast i després recuperen el color normal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové znaky se objeví v barvě akcentu a pak přejdou do běžné barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye tegn vises i accentfarven og får derefter den normale farve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Zeichen erscheinen in der Akzentfarbe und nehmen dann die normale Farbe an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι νέοι χαρακτήρες εμφανίζονται με το χρώμα έμφασης και μετά επανέρχονται στο κανονικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los caracteres nuevos aparecen en el color de contraste y luego recuperan su color."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudet merkit näkyvät hetken korostusvärillä ja muuttuvat sitten tavallisiksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux caractères apparaissent dans la couleur d’accentuation, puis reprennent leur couleur normale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תווים חדשים מופיעים בצבע ההדגשה ואז חוזרים לצבע הרגיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए अक्षर ऐक्सेंट कलर में दिखते हैं, फिर सामान्य हो जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi znakovi pojavljuju se u boji naglašavanja, a zatim poprime uobičajenu boju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az új karakterek kiemelőszínnel jelennek meg, majd visszaváltanak a szokásos színre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karakter baru muncul dalam warna aksen, lalu kembali normal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi caratteri appaiono nel colore dettagli, poi tornano al colore normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しく入力した文字がアクセントカラーで表示され、そのあと通常の色に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로 입력한 문자가 강조 색상으로 나타났다가 원래 색으로 돌아옵니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksara baharu muncul dalam warna aksen, kemudian kembali seperti biasa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye tegn vises først i aksentfargen og deretter i vanlig farge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe tekens verschijnen eerst in de accentkleur en krijgen daarna hun gewone kleur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe znaki pojawiają się w kolorze akcentu, a potem wracają do zwykłego koloru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os novos caracteres aparecem na cor de realce e depois voltam ao normal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os novos caracteres aparecem na cor de realce e depois voltam à cor normal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracterele noi apar în culoarea accent, apoi revin la normal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые символы появляются акцентным цветом, а затем принимают обычный."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové znaky sa najprv zobrazia vo farbe akcentu a potom sa ustália."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi znaki se pokažejo v barvi poudarka, nato dobijo običajno barvo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nya tecken visas i accentfärgen och får sedan vanlig färg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวอักษรใหม่จะปรากฏเป็นสีเน้นก่อน แล้วค่อยกลับเป็นสีปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni karakterler önce vurgu renginde görünür, sonra normale döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові символи зʼявляються акцентним кольором, а потім набувають звичайного."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ký tự mới xuất hiện bằng màu nhấn rồi trở về màu thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新输入的字符先以强调色显示，随后恢复正常。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新輸入的字元會先以強調顏色顯示，然後恢復正常。"
          }
        }
      }
    },
