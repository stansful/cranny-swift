    "NSDesktopFolderUsageDescription" : {
      "comment" : "Privacy - Desktop Folder Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ Cranny على الرف بالملفات التي تفلتها على النتوء، ويحفظ نتائج السلاسل بجوارها أو في \"التنزيلات\"."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Cranny guarda a la safata els arxius que deixes anar a l’osca i desa els resultats de les cadenes al costat d’aquests arxius o a Descàrregues."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny uchovává soubory, které přetáhnete na výřez, ve své přihrádce a výsledky postupů ukládá vedle nich nebo do složky Stahování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny opbevarer de filer, du trækker til notchen, på sin hylde og gemmer resultater af handlingskæder ved siden af dem eller i Overførsler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny bewahrt die Dateien, die du auf der Notch ablegst, in seiner Ablage auf und sichert Ergebnisse von Abläufen daneben oder im Ordner „Downloads“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Cranny κρατά στο ράφι του τα αρχεία που αφήνετε στην εγκοπή και αποθηκεύει τα αποτελέσματα των αλυσίδων δίπλα τους ή στις «Λήψεις»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cranny keeps the files you drop on the notch in its Tray and saves pipeline results next to them or in Downloads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny conserva en su bandeja los archivos que sueltas en la muesca y guarda los resultados de los flujos junto a ellos o en Descargas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny säilyttää loveen pudottamasi tiedostot hyllyllään ja tallentaa työnkulkujen tulokset niiden viereen tai Lataukset-kansioon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny garde sur son étagère les fichiers que vous déposez sur l’encoche et enregistre les résultats des chaînes à côté d’eux ou dans Téléchargements."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקבצים שגוררים אל המגרעת נשמרים על המדף של Cranny, ותוצאות התהליכים נשמרות לצידם או בתיקיה ״הורדות״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप नॉच पर जो फ़ाइलें ड्रॉप करते हैं, Cranny उन्हें अपनी ट्रे में रखता है और पाइपलाइन के परिणाम उनके बगल में या डाउनलोड फ़ोल्डर में सेव करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny na svojoj polici čuva datoteke koje ispustite na izrez i sprema rezultate cjevovoda pokraj njih ili u mapu Preuzimanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Cranny a kivágásra húzott fájlokat a polcán tárolja, a műveletsorok eredményeit pedig melléjük vagy a Letöltések mappába menti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File yang Anda seret ke notch disimpan Cranny di Rak, dan hasil alur disimpan di sebelah file tersebut atau di folder Unduhan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny conserva sul suo ripiano i file che rilasci sulla tacca e salva i risultati delle sequenze accanto agli originali o in Download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crannyは、ノッチにドロップしたファイルをトレイに保持し、パイプラインの結果をそのファイルと同じ場所または“ダウンロード”フォルダに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny는 노치에 놓은 파일을 선반에 보관하고, 파이프라인 결과를 원본 옆이나 ‘다운로드’ 폴더에 저장합니다."
