    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحكم Cranny في تطبيقَي \"الموسيقى\" و Spotify لعرض ما يتم تشغيله وتغييره عندما يكون مصدر الوسائط في النظام غير متوفر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Cranny controla l’app Música i l’Spotify per mostrar i canviar el que s’està reproduint quan la font multimèdia del sistema no està disponible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když systémový zdroj médií není k dispozici, Cranny ovládá aplikace Hudba a Spotify, aby bylo možné zobrazit a změnit, co právě hraje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny styrer Musik og Spotify for at vise og ændre, hvad der afspilles, når systemets mediekilde ikke er tilgængelig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny steuert „Musik“ und Spotify, um anzuzeigen und zu ändern, was gerade läuft, wenn die Medienquelle des Systems nicht verfügbar ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Cranny ελέγχει τη «Μουσική» και το Spotify για να εμφανίζει και να αλλάζει ό,τι παίζει, όταν η πηγή πολυμέσων του συστήματος δεν είναι διαθέσιμη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cranny controls Music and Spotify to show and change what is playing when the system media source is unavailable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny controla Música y Spotify para mostrar y cambiar lo que se está reproduciendo cuando la fuente multimedia del sistema no está disponible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny ohjaa Musiikki- ja Spotify-appeja näyttääkseen, mitä toistetaan, ja vaihtaakseen kappaletta, kun järjestelmän medialähde ei ole käytettävissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny contrôle les apps Musique et Spotify pour afficher et modifier la lecture en cours quand la source multimédia du système n’est pas disponible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמקור המדיה של המערכת אינו זמין, Cranny שולט ב״מוזיקה״ וב-Spotify כדי להציג את מה שמתנגן ולשנות אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब सिस्टम का मीडिया सोर्स उपलब्ध नहीं होता, तब क्या चल रहा है यह दिखाने और बदलने के लिए Cranny संगीत ऐप और Spotify को नियंत्रित करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny upravlja aplikacijama Glazba i Spotify kako bi prikazao i mijenjao ono što se reproducira kad izvor medija sustava nije dostupan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Cranny vezérli a Zene és a Spotify appot, hogy megjelenítse és módosítsa az éppen szóló tartalmat, ha a rendszer médiaforrása nem érhető el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny mengontrol “Musik” dan Spotify untuk menampilkan dan mengganti apa yang sedang diputar saat sumber media sistem tidak tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny controlla le app Musica e Spotify per mostrare e cambiare ciò che è in riproduzione quando la sorgente multimediale di sistema non è disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムのメディアソースを利用できないときに再生中の曲を表示したり切り替えたりするため、Crannyは“ミュージック”とSpotifyを操作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 미디어 소스를 사용할 수 없을 때 Cranny는 음악 앱과 Spotify를 제어하여 재생 중인 항목을 표시하고 변경합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny mengawal app Muzik dan Spotify untuk menunjukkan dan menukar perkara yang sedang dimainkan apabila sumber media sistem tidak tersedia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny styrer Musikk og Spotify for å vise og endre det som spilles når systemets mediekilde ikke er tilgjengelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny bedient Muziek en Spotify om te tonen wat er speelt en dat te wijzigen als de mediabron van het systeem niet beschikbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny steruje aplikacjami Muzyka i Spotify, aby pokazywać i zmieniać odtwarzane utwory, gdy systemowe źródło multimediów jest niedostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cranny controla os apps Música e Spotify para mostrar e alterar o que está tocando quando a fonte de mídia do sistema não está disponível."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cranny controla a aplicação Música e o Spotify para mostrar e alterar o que está a ser reproduzido quando a fonte multimédia do sistema não está disponível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny controlează aplicațiile Muzică și Spotify pentru a afișa și schimba ce se redă atunci când sursa multimedia a sistemului nu este disponibilă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny управляет приложениями «Музыка» и Spotify, чтобы показывать и переключать треки, когда системный источник медиа недоступен."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď systémový zdroj médií nie je k dispozícii, Cranny ovláda apky Hudba a Spotify – zobrazuje, čo sa práve prehráva, a umožňuje to zmeniť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny upravlja aplikaciji Glasba in Spotify, da prikaže in spremeni, kaj se predvaja, ko sistemski vir predstavnosti ni na voljo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny styr Musik och Spotify för att visa och ändra det som spelas när systemets mediekälla inte är tillgänglig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny ควบคุมแอปเพลงและ Spotify เพื่อแสดงและเปลี่ยนสิ่งที่กำลังเล่นเมื่อแหล่งสื่อของระบบไม่พร้อมใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny, sistem medya kaynağı kullanılamadığında çalan içeriği göstermek ve değiştirmek için Müzik ve Spotify uygulamalarını denetler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny керує програмами «Музика» і Spotify, щоб показувати й перемикати те, що грає, коли системне джерело медіа недоступне."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny điều khiển ứng dụng Nhạc và Spotify để hiển thị và thay đổi nội dung đang phát khi nguồn phương tiện của hệ thống không khả dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统媒体来源不可用时，Cranny会控制“音乐”和Spotify，以显示和切换正在播放的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny會在系統媒體來源無法使用時，控制「音樂」和Spotify來顯示及更改正在播放的內容。"
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "comment" : "Privacy - Audio Capture Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستمع Cranny إلى إخراج صوت النظام لتحريك المؤثر المرئي للموسيقى. لا يتم تسجيل الصوت أو تخزينه أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Cranny escolta la sortida d’àudio del sistema per animar el visualitzador de música. L’àudio no es grava ni s’emmagatzema mai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny poslouchá systémový zvukový výstup kvůli animaci hudebního vizualizéru. Zvuk se nikdy nenahrává ani neukládá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny lytter til systemets lydudgang for at animere musikvisualiseringen. Lyd bliver aldrig optaget eller gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny hört die Audioausgabe des Systems, um den Musik-Visualizer zu animieren. Audio wird nie aufgezeichnet oder gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Cranny ακούει την έξοδο ήχου του συστήματος για να κινεί την οπτικοποίηση της μουσικής. Ο ήχος δεν εγγράφεται ούτε αποθηκεύεται ποτέ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cranny listens to system audio output to animate the music visualizer. Audio is never recorded or stored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny escucha la salida de audio del sistema para animar el visualizador de música. El audio nunca se graba ni se guarda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny kuuntelee järjestelmän äänen ulostuloa animoidakseen musiikkivisualisoijaa. Ääntä ei koskaan nauhoiteta eikä tallenneta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny écoute la sortie audio du système pour animer le visualiseur de musique. L’audio n’est jamais enregistré ni conservé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להנפיש את הוויזואלייזר, Cranny מאזין לשמע שהמערכת מנגנת. השמע לעולם אינו מוקלט ואינו נשמר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संगीत विज़ुअलाइज़र को ऐनिमेट करने के लिए Cranny सिस्टम का ऑडियो आउटपुट सुनता है। ऑडियो कभी रिकॉर्ड या स्टोर नहीं किया जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny sluša izlaz zvuka sustava kako bi animirao glazbeni vizualizator. Zvuk se nikad ne snima niti sprema."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Cranny a rendszer hangkimenetét figyeli a zenevizualizáló animálásához. A hangot soha nem rögzíti és nem tárolja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny mendengarkan output audio sistem untuk menganimasikan visualisasi musik. Audio tidak pernah direkam atau disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny ascolta l’uscita audio di sistema per animare il visualizzatore musicale. L’audio non viene mai registrato né archiviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crannyは、音楽ビジュアライザを動かすためにシステムのオーディオ出力を解析します。オーディオが録音または保存されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny는 음악 비주얼라이저를 움직이기 위해 시스템 오디오 출력을 듣습니다. 오디오는 녹음되거나 저장되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny mendengar output audio sistem untuk menganimasikan pentampak muzik. Audio tidak sekali-kali dirakam atau disimpan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny lytter til systemets lydutgang for å animere musikkvisualiseringen. Lyd blir aldri tatt opp eller lagret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny luistert naar de audio-uitvoer van het systeem om de muziekvisualisatie te laten bewegen. Audio wordt nooit opgenomen of bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny analizuje dźwięk systemowy, aby animować wizualizator muzyki. Dźwięk nigdy nie jest nagrywany ani przechowywany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cranny escuta a saída de áudio do sistema para animar o visualizador de música. O áudio nunca é gravado nem armazenado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cranny ouve a saída de áudio do sistema para animar o visualizador de música. O áudio nunca é gravado nem guardado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny ascultă ieșirea audio a sistemului pentru a anima vizualizatorul muzicii. Sunetul nu este niciodată înregistrat sau stocat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny анализирует системный звук, чтобы анимировать визуализатор музыки. Звук никогда не записывается и не сохраняется."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny počúva systémový zvukový výstup a podľa neho animuje hudobný vizualizér. Zvuk sa nikdy nenahráva ani neukladá."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny posluša sistemski zvočni izhod, da animira glasbeni vizualizator. Zvok se nikoli ne snema ali shranjuje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny lyssnar på systemets ljudutgång för att animera musikvisualiseraren. Ljud spelas aldrig in och sparas aldrig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny ฟังสัญญาณเสียงออกของระบบเพื่อทำให้ตัวแสดงภาพเสียงเคลื่อนไหว เสียงจะไม่ถูกบันทึกหรือจัดเก็บ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny, müzik görselleştiricisini canlandırmak için sistem ses çıkışını dinler. Ses hiçbir zaman kaydedilmez veya saklanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny слухає системний звук, щоб анімувати музичний візуалізатор. Звук ніколи не записується й не зберігається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny nghe âm thanh đầu ra của hệ thống để tạo chuyển động cho hiệu ứng sóng nhạc. Âm thanh không bao giờ được ghi lại hay lưu trữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny会监听系统音频输出，让音乐可视化效果随之律动。音频绝不会被录制或存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny會聆聽系統音訊輸出，讓音樂視覺效果隨之律動。絕不會錄製或儲存音訊。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض Cranny اتصال أجهزة Bluetooth، مثل سماعات الرأس، ومستوى شحن بطارياتها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Cranny mostra quan es connecten dispositius Bluetooth, com ara auriculars, i quin nivell de bateria tenen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny zobrazuje připojení zařízení Bluetooth, například sluchátek, a stav jejich baterie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny viser, når Bluetooth-enheder som hovedtelefoner tilsluttes, og deres batteriniveau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny zeigt an, wenn sich Bluetooth-Geräte wie Kopfhörer verbinden, und wie voll ihre Batterie ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Cranny εμφανίζει πότε συνδέονται συσκευές Bluetooth, όπως ακουστικά, και τη στάθμη της μπαταρίας τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cranny shows when Bluetooth devices such as headphones connect, and their battery level."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny muestra cuándo se conectan dispositivos Bluetooth, como unos auriculares, y su nivel de batería."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny näyttää, kun Bluetooth-laitteet, kuten kuulokkeet, yhdistyvät, ja kertoo niiden akun varaustason."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny indique quand des appareils Bluetooth, comme des écouteurs, se connectent, ainsi que leur niveau de batterie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמכשירי Bluetooth, כמו אוזניות, מתחברים, Cranny מציג זאת יחד עם רמת הסוללה שלהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny दिखाता है कि हेडफ़ोन जैसे Bluetooth डिवाइस कब कनेक्ट होते हैं, और उनकी बैटरी का स्तर।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny prikazuje kada se povežu Bluetooth uređaji, poput slušalica, i njihovu razinu baterije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Cranny megjeleníti, ha Bluetooth-eszközök, például fejhallgatók csatlakoznak, valamint az akkumulátoruk töltöttségét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny menampilkan saat perangkat Bluetooth seperti headphone terhubung, beserta level baterainya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny mostra quando si connettono dispositivi Bluetooth, come le cuffie, e il loro livello di batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crannyは、ヘッドフォンなどのBluetoothデバイスの接続と、そのバッテリー残量を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny는 헤드폰 같은 Bluetooth 기기가 연결되면 이를 표시하고, 기기의 배터리 잔량도 보여줍니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny menunjukkan apabila peranti Bluetooth seperti fon kepala bersambung, beserta paras baterinya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny viser når Bluetooth-enheter som hodetelefoner kobles til, og batterinivået deres."
