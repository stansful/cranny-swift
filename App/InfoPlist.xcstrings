    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض Cranny أحداثك القادمة وروابط الاجتماعات في النتوء، ولا يعدّلها ولا يرفعها أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Cranny mostra els propers esdeveniments i els enllaços de les reunions a l’osca. No els modifica ni els puja mai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny ve výřezu zobrazuje vaše nadcházející události a odkazy na schůzky. Nikdy je neupravuje ani nikam neodesílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny viser dine kommende begivenheder og mødelinks i notchen. Den ændrer eller uploader dem aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny zeigt deine anstehenden Ereignisse und Meeting-Links in der Notch an. Es bearbeitet sie nie und lädt sie nie hoch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Cranny εμφανίζει τα επερχόμενα γεγονότα σας και τους συνδέσμους συσκέψεων στην εγκοπή. Δεν τα επεξεργάζεται ούτε τα αποστέλλει ποτέ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cranny shows your upcoming events and meeting links in the notch. It never edits or uploads them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny muestra tus próximos eventos y enlaces de reuniones en la muesca. Nunca los modifica ni los sube."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny näyttää tulevat tapahtumasi ja kokouslinkit lovessa. Se ei koskaan muokkaa eikä lähetä niitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny affiche vos prochains événements et liens de réunion dans l’encoche. Il ne les modifie ni ne les envoie jamais."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "במגרעת יוצגו האירועים הקרובים שלך והקישורים לפגישות. Cranny לעולם אינו עורך או מעלה אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny नॉच में आपके आने वाले इवेंट और मीटिंग लिंक दिखाता है। वह उन्हें न तो कभी बदलता है, न ही अपलोड करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny prikazuje vaše nadolazeće događaje i poveznice na sastanke u izrezu. Nikad ih ne mijenja niti prenosi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Cranny a kivágásban megjeleníti a közelgő eseményeit és a megbeszélések linkjeit. Soha nem módosítja és nem tölti fel őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny menampilkan acara mendatang dan tautan rapat Anda di notch. Cranny tidak pernah mengubah atau mengunggahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny mostra i tuoi prossimi eventi e i link alle riunioni nella tacca. Non li modifica né li carica mai online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crannyは、今後のイベントとミーティングのリンクをノッチに表示します。イベントを編集したりアップロードしたりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny는 다가오는 이벤트와 회의 링크를 노치에 표시합니다. 이벤트를 편집하거나 업로드하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny menunjukkan peristiwa akan datang dan pautan mesyuarat anda pada takuk. Cranny tidak sekali-kali mengedit atau memuat naiknya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny viser kommende hendelser og møtelenker i hakket. Den endrer dem aldri og laster dem aldri opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny toont je komende afspraken en vergaderlinks in de notch. Ze worden nooit gewijzigd of geüpload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny pokazuje nadchodzące wydarzenia i łącza do spotkań w wycięciu ekranu. Nigdy ich nie zmienia ani nie wysyła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cranny mostra seus próximos eventos e links de reunião no notch. Ele nunca os edita nem envia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cranny mostra os seus próximos eventos e as ligações das reuniões no entalhe. Nunca os altera nem os envia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny afișează în decupaj evenimentele următoare și linkurile întâlnirilor. Nu le editează și nu le încarcă niciodată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny показывает ближайшие события и ссылки на встречи в вырезе экрана. Он никогда не изменяет и не отправляет их."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny zobrazuje vo výreze vaše nadchádzajúce udalosti a odkazy na stretnutia. Nikdy ich neupravuje ani neodosiela."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny v zarezi prikazuje vaše prihajajoče dogodke in povezave do sestankov. Nikoli jih ne ureja ali nalaga v splet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny visar dina kommande händelser och möteslänkar i notchen. Den ändrar dem aldrig och laddar aldrig upp dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny แสดงกิจกรรมที่กำลังจะมาถึงและลิงก์การประชุมที่รอยบาก โดยจะไม่แก้ไขหรืออัปโหลดกิจกรรมเหล่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny, yaklaşan etkinliklerinizi ve toplantı bağlantılarınızı çentikte gösterir. Bunları hiçbir zaman düzenlemez veya karşıya yüklemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny показує ваші найближчі події та посилання на зустрічі у вирізі екрана. Він ніколи не змінює й не вивантажує їх."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny hiển thị các sự kiện sắp tới và liên kết cuộc họp trên tai thỏ. Cranny không bao giờ sửa hoặc tải chúng lên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny会在刘海中显示你即将开始的日程和会议链接，绝不会编辑或上传它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny會在瀏海中顯示你即將到來的行程和會議連結。Cranny絕不會編輯或上傳這些資料。"
          }
        }
      }
    },
