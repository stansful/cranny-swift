            "value" : "במגרעת יוצגו האירועים הקרובים שלך והקישורים לפגישות. Cranny לעולם אינו עורך או מעלה אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny नॉच में आपके आने वाले इवेंट और मीटिंग लिंक दिखाता है। वह उन्हें न तो कभी बदलता है, न ही अपलोड करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny prikazuje vaše nadolazeće događaje i poveznice na sastanke u izrezu. Nikad ih ne mijenja niti prenosi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Cranny a kivágásban megjeleníti a közelgő eseményeit és a megbeszélések linkjeit. Soha nem módosítja és nem tölti fel őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny menampilkan acara mendatang dan tautan rapat Anda di notch. Cranny tidak pernah mengubah atau mengunggahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny mostra i tuoi prossimi eventi e i link alle riunioni nella tacca. Non li modifica né li carica mai online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crannyは、今後のイベントとミーティングのリンクをノッチに表示します。イベントを編集したりアップロードしたりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny는 다가오는 이벤트와 회의 링크를 노치에 표시합니다. 이벤트를 편집하거나 업로드하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny menunjukkan peristiwa akan datang dan pautan mesyuarat anda pada takuk. Cranny tidak sekali-kali mengedit atau memuat naiknya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny viser kommende hendelser og møtelenker i hakket. Den endrer dem aldri og laster dem aldri opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny toont je komende afspraken en vergaderlinks in de notch. Ze worden nooit gewijzigd of geüpload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny pokazuje nadchodzące wydarzenia i łącza do spotkań w wycięciu ekranu. Nigdy ich nie zmienia ani nie wysyła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cranny mostra seus próximos eventos e links de reunião no notch. Ele nunca os edita nem envia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cranny mostra os seus próximos eventos e as ligações das reuniões no entalhe. Nunca os altera nem os envia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny afișează în decupaj evenimentele următoare și linkurile întâlnirilor. Nu le editează și nu le încarcă niciodată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cranny показывает ближайшие события и ссылки на встречи в вырезе экрана. Он никогда не изменяет и не отправляет их."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
